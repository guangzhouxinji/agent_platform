        "1. 功能概述",
        "2. 输入输出字段"
      ],
      "acceptanceScenarioIds": [
        "ADJ-05-AC-001",
        "ADJ-05-AC-007"
      ]
    },
    {
      "id": "ADJ-05-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "检索相关度、排序或模型分值不得表述为条文已适用、法律适用概率或正式裁决依据。",
      "sourceAnchors": [
        "1. 功能概述",
        "2. 输入输出字段",
        "3. 匹配流程与规则"
