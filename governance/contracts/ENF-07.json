    },
    {
      "id": "ENF-07-MUST-005",
      "type": "MUST",
      "statement": "每个待证明事项分别记录支持、反对或冲突的证据关系及理由，并保留无支持材料的未证实状态。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
