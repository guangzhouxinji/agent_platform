  "clauses": [
    {
      "id": "CON-07-MUST-001",
      "type": "MUST",
      "statement": "对目标与人工选定候选按文字、读音、含义、图形、整体视觉和商品服务关系逐项辅助比对，可从检索进入或直接选择对象。",
      "sourceAnchors": [
        "1. 功能概述",
        "3. 分析流程与规则"
      ],
      "acceptanceScenarioIds": [
        "CON-07-AC-001"
      ]
    },
    {
      "id": "CON-07-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "检索相关度、多维意见或任务成功不得转换为注册成功率、法律近似、正式审查或裁决结论。",
      "sourceAnchors": [
        "1. 功能概述",
        "3. 分析流程与规则"
      ],
      "acceptanceScenarioIds": [
        "CON-07-AC-001",
        "CON-07-AC-006"
      ]
    },
    {
      "id": "CON-07-MUST-002",
      "type": "MUST",
      "statement": "固定目标名称原图、用户确认商品服务类别类似群及分类版本、候选源快照、目的、地域、时间、分析维度和依据版本。",
      "sourceAnchors": [
        "2. 输入输出字段",
        "3. 分析流程与规则"
      ],
      "acceptanceScenarioIds": [
        "CON-07-AC-002"
      ]
    },
    {
      "id": "CON-07-MUST_NOT-002",
      "type": "MUST_NOT",
      "statement": "类别、项目、地域、时间或目的缺失时不得由模型猜测或默认当前条件，应返回补问和待确认项。",
      "sourceAnchors": [
        "2. 输入输出字段",
        "3. 分析流程与规则"
      ],
      "acceptanceScenarioIds": [
        "CON-07-AC-002"
      ]
    },
    {
      "id": "CON-07-MUST-003",
      "type": "MUST",
      "statement": "每个候选重新校验访问权限并获取实际名称、图样、商品服务和源状态，不能只沿用检索摘要。",
      "sourceAnchors": [
        "3. 分析流程与规则"
      ],
      "acceptanceScenarioIds": [
        "CON-07-AC-003"
      ]
    },
    {
      "id": "CON-07-MUST-004",
      "type": "MUST",
      "statement": "OCR、读音和含义识别结果以建议预览，歧义由用户修正；原始文字图样与确认值分别保存。",
      "sourceAnchors": [
        "3. 分析流程与规则"
      ],
      "acceptanceScenarioIds": [
        "CON-07-AC-003"
      ]
    },
    {
      "id": "CON-07-MUST-005",
      "type": "MUST",
      "statement": "文字维度记录字形顺序组成等可观察差异；读音不确定显式标记；含义区分材料支持与模型推测。",
      "sourceAnchors": [
        "3. 分析流程与规则"
      ],
      "acceptanceScenarioIds": [
        "CON-07-AC-004"
      ]
    },
    {
      "id": "CON-07-MUST-006",
      "type": "MUST",
      "statement": "图形和整体视觉必须实际访问目标及候选图样并保存证据，缺图时状态为材料不足。",
      "sourceAnchors": [
        "3. 分析流程与规则",
        "5. 内部验证页面"
      ],
      "acceptanceScenarioIds": [
        "CON-07-AC-004"
      ]
    },
    {
      "id": "CON-07-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "不得仅凭名称或 OCR 生成图形与整体视觉意见，未执行维度不得伪装为已分析。",
      "sourceAnchors": [
        "3. 分析流程与规则",
        "4. 报告与复核"
      ],
      "acceptanceScenarioIds": [
        "CON-07-AC-004"
      ]
    },
    {
      "id": "CON-07-MUST-007",
      "type": "MUST",
      "statement": "商品服务关系列出实际项目、类似群、分类和标准版本及支持理由，同类不同类均不能直接决定类似关系。",
      "sourceAnchors": [
        "3. 分析流程与规则"
      ],
      "acceptanceScenarioIds": [
        "CON-07-AC-005"
      ]
    },
    {
      "id": "CON-07-MUST-008",
      "type": "MUST",
      "statement": "每维度明确已分析、不适用或材料不足，并分别保存事实、证据、意见和缺口。",
      "sourceAnchors": [
        "2. 输入输出字段",
        "4. 报告与复核"
      ],
      "acceptanceScenarioIds": [
        "CON-07-AC-006"
      ]
    },
    {
      "id": "CON-07-MUST-009",
      "type": "MUST",
      "statement": "综合意见仅采用需重点复核相似因素、已分析维度差异明显或材料不足无法形成意见等辅助措辞，并给出理由。",
      "sourceAnchors": [
        "3. 分析流程与规则"
      ],
      "acceptanceScenarioIds": [
        "CON-07-AC-006"
      ]
    },
    {
      "id": "CON-07-MUST_NOT-004",
      "type": "MUST_NOT",
      "statement": "不得用简单多数投票、任意阈值或检索分数直接得出法律近似；首版不输出未经独立标尺定义的数字评分。",
      "sourceAnchors": [
        "3. 分析流程与规则",
        "4. 报告与复核"
      ],
      "acceptanceScenarioIds": [
        "CON-07-AC-006"
      ]
    },
    {
      "id": "CON-07-MUST-010",
      "type": "MUST",
      "statement": "报告保存目标候选快照、商品服务、逐维证据意见、原图、依据条款、综合意见、缺失维度、数据时间及模型规则版本。",
      "sourceAnchors": [
        "4. 报告与复核"
      ],
      "acceptanceScenarioIds": [
        "CON-07-AC-007"
      ]
    },
    {
      "id": "CON-07-MUST-011",
      "type": "MUST",
      "statement": "报告初始未复核，模型原始内容与专业人员意见分开；源状态或依据更新后新分析生成新版本，历史保留。",
      "sourceAnchors": [
        "4. 报告与复核"
      ],
      "acceptanceScenarioIds": [
        "CON-07-AC-007"
      ]
    },
    {
      "id": "CON-07-MUST-012",
      "type": "MUST",
      "statement": "异步服务覆盖准备、创建、任务报告查询、复核和取消，逐候选状态、失败重试、幂等及版本冲突可追踪。",
      "sourceAnchors": [
        "5. 内部验证页面",
        "6. 服务契约",
        "总目录/3.3 异步任务契约"
      ],
      "acceptanceScenarioIds": [
        "CON-07-AC-008"
      ]
    },
    {
      "id": "CON-07-MUST-013",
      "type": "MUST",
      "statement": "图像失效、资料不足、来源故障、依据缺失、模型失败和无权限分别返回；缺依据只展示可观察差异，不编造标准条款。",
      "sourceAnchors": [
        "6. 服务契约"
      ],
      "acceptanceScenarioIds": [
        "CON-07-AC-008"
      ]
    },
    {
      "id": "CON-07-MUST-014",
      "type": "MUST",
      "statement": "目标候选图样、来源依据、报告和历史由后端实时鉴权，权限撤回后缓存和旧版本不得泄露。",
      "sourceAnchors": [
        "6. 服务契约",
        "总目录/3.2 来源、版本和权限"
      ],
      "acceptanceScenarioIds": [
        "CON-07-AC-009"
      ]
    },
    {
      "id": "CON-07-MUST-017",
      "type": "MUST",
      "statement": "专家固定样本按维度评估事实准确、依据支持和综合意见合理性，记录分母失败及数据模型规则版本，阈值试测确认。",
      "sourceAnchors": [
        "7. 验收要求",
        "8. 依赖与交付",
        "总目录/6. 验收资料与共同口径"
      ],
      "acceptanceScenarioIds": [
        "CON-07-AC-012"
      ]
    },
    {
      "id": "CON-07-MUST-018",
      "type": "MUST",
      "statement": "图形能力、标准分类、商品服务关系、时间含义、专家人员、规模性能和环境未确认时对应能力保持待补齐。",
      "sourceAnchors": [
        "8. 依赖与交付"
      ],
      "acceptanceScenarioIds": [
        "CON-07-AC-012"
      ]
    }
  ],
  "inputs": [
    {
      "name": "targetSnapshot",
      "required": true,
      "rules": [
        "名称或图样至少一项，按选择维度校验"
      ]
    },
    {
      "name": "classification",
      "required": true,
      "rules": [
        "用户确认商品服务、类别、类似群和版本"
      ]
    },
    {
      "name": "candidateSnapshots",
      "required": true,
      "rules": [
        "一个或多个稳定商标版本及原图"
      ]
    },
    {
      "name": "scope",
      "required": true,
      "rules": [
        "分析目的、地域、相关时间和依据范围"
      ]
    },
    {
      "name": "dimensions",
      "required": true,
      "rules": [
        "逐项选择且材料充分"
      ]
    },
    {
      "name": "idempotencyKey",
      "required": true,
      "rules": [
        "绑定完整输入与调用方"
      ]
    }
  ],
