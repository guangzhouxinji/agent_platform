      "acceptanceScenarioIds": [
        "ENF-10-AC-001"
      ]
    },
    {
      "id": "ENF-10-MUST-002",
      "type": "MUST",
      "statement": "规则保存唯一编号、名称、行为类型、标准来源、构成要件、排除抗辩、适用范围、不可变发布版本、机构和审计。",
      "sourceAnchors": [
        "3. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "ENF-10-AC-002"
      ]
    },
    {
      "id": "ENF-10-MUST-003",
      "type": "MUST",
      "statement": "法律依据、证据字典、专家标准和案例样例均固定来源与版本并校验关联权限；缺失与源调用失败分开。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "3. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "ENF-10-AC-002"
      ]
    },
    {
      "id": "ENF-10-MUST_NOT-002",
      "type": "MUST_NOT",
      "statement": "来源依据和事实字段不得由模型生成替换，允许为空的抗辩列表也必须有业务确认而非默认无抗辩。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "3. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "ENF-10-AC-002"
      ]
    },
    {
      "id": "ENF-10-MUST-004",
      "type": "MUST",
      "statement": "每项要件明确需要的事实、证据、需核实条件、支持关系和缺失处理，避免仅凭语义相似度下结论。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-10-AC-003"
      ]
    },
    {
      "id": "ENF-10-MUST-005",
      "type": "MUST",
      "statement": "专利侵权规则要求权利要求逐项比对输入；商标规则要求实际标识及商品服务关系；假冒专利与专利侵权使用不同规则。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-10-AC-003"
      ]
    },
    {
      "id": "ENF-10-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "语义相似、文本相似、同类别或权利存在不得直接等同侵权成立。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "总览/5. AI、规则与人工边界"
      ],
      "acceptanceScenarioIds": [
        "ENF-10-AC-003"
      ]
    },
    {
      "id": "ENF-10-MUST-006",
      "type": "MUST",
      "statement": "疑似行为到处置程序的映射必须按行为类型、地区、职权和程序配置并带依据。",
