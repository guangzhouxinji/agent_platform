  "clauses": [
    {
      "id": "ENF-13-MUST-001",
      "type": "MUST",
      "statement": "为固定 ENF-12 发布模板版本逐字段配置案件、证据和分析结果的允许来源、转换方式、生成方式及缺失策略。",
      "sourceAnchors": [
        "1. 功能概述与交付范围",
        "2. 数据来源与依赖",
        "3. 信息字段",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-13-AC-001"
      ]
    },
    {
      "id": "ENF-13-MUST-002",
      "type": "MUST",
      "statement": "规则保存唯一编号、名称、模板版本、字段路径与来源、直接取值/确定性计算/辅助撰写方式、缺失策略、不可变版本和审计。",
      "sourceAnchors": [
        "3. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "ENF-13-AC-002"
      ]
    },
    {
      "id": "ENF-13-MUST-003",
      "type": "MUST",
      "statement": "中心案件字段字典、证据结构、分析结构和模板字段均固定稳定 ID 与版本并校验关联权限，缺失与源调用失败分开。",
      "sourceAnchors": [
        "2. 数据来源与依赖"
      ],
      "acceptanceScenarioIds": [
        "ENF-13-AC-002"
      ]
    },
    {
      "id": "ENF-13-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "来源字段、业务编号、案件事实、证据和分析结果不得由模型生成或替换，不存在的数据路径不得发布。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-13-AC-002",
        "ENF-13-AC-006"
      ]
    },
    {
      "id": "ENF-13-MUST-004",
      "type": "MUST",
      "statement": "当事人、金额、日期和法条原文优先从确认来源直接取值或确定性计算，并保留字段级来源。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-13-AC-003"
      ]
    },
    {
      "id": "ENF-13-MUST_NOT-002",
      "type": "MUST_NOT",
      "statement": "模型不得补写缺失当事人、金额、日期、法条原文、签名或其他确定性字段。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-13-AC-003"
      ]
    },
    {
      "id": "ENF-13-MUST-005",
      "type": "MUST",
      "statement": "叙述性段落仅可使用已授权且固定版本的案件材料辅助撰写，输出保存段落级来源、模型和提示词版本。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-13-AC-004"
      ]
    },
    {
      "id": "ENF-13-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "模型不得扩大数据权限、使用未允许来源或将辅助叙述冒充原始记录、事实确认和人工意见。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "总览/5. AI、规则与人工边界"
      ],
      "acceptanceScenarioIds": [
        "ENF-13-AC-004"
      ]
    },
    {
      "id": "ENF-13-MUST-006",
      "type": "MUST",
      "statement": "每个字段缺失策略只可为阻断、留空并提示或省略可选段落；必填缺失只能生成明确标识的不完整草稿且不得提交审核。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-13-AC-005"
      ]
    },
    {
      "id": "ENF-13-MUST-007",
      "type": "MUST",
      "statement": "调查笔录只可基于真实问答或记录整理并逐项关联来源。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-13-AC-005"
      ]
    },
    {
      "id": "ENF-13-MUST_NOT-004",
      "type": "MUST_NOT",
      "statement": "没有真实问答记录时不得生成调查过程、提问、回答或签名。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-13-AC-005"
      ]
    },
    {
      "id": "ENF-13-MUST-008",
      "type": "MUST",
      "statement": "映射验证和样例试生成固定模板、规则与输入版本，输出字段来源预览、缺失、无效路径、权限和未处理项。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "5. 服务接口需求"
      ],
      "acceptanceScenarioIds": [
        "ENF-13-AC-006"
      ]
    },
    {
      "id": "ENF-13-MUST-009",
      "type": "MUST",
      "statement": "模板字段变化使相关规则待复核，重新校验通过前不得把旧映射套用到新模板。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-13-AC-006"
      ]
    },
    {
      "id": "ENF-13-MUST-010",
      "type": "MUST",
      "statement": "发布规则不可原地修改，编辑创建新草稿，停用限制新任务，历史文书继续引用原规则模板版本。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "5. 服务接口需求"
      ],
      "acceptanceScenarioIds": [
        "ENF-13-AC-007"
      ]
    },
    {
      "id": "ENF-13-MUST-014",
      "type": "MUST",
      "statement": "中心逐项确认案件字段与文书字段关系；固定样例记录模板规则输入模型、预期实际、来源和问题，未确认映射不升级验收。",
      "sourceAnchors": [
        "7. 验收要求",
        "8. 联调前需确认的条件"
      ],
      "acceptanceScenarioIds": [
        "ENF-13-AC-011"
      ]
    }
  ],
  "inputs": [
    {
      "name": "generationRuleDraft",
      "required": true,
