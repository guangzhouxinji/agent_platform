  "clauses": [
    {
      "id": "ENF-01-MUST-001",
      "type": "MUST",
      "statement": "统一配置中心提供的违法线索 API，并管理连接、同步和运行状态。",
      "sourceAnchors": [
        "1. 功能概述与交付范围"
      ],
      "acceptanceScenarioIds": [
        "ENF-01-AC-001",
        "ENF-01-AC-008"
      ]
    },
    {
      "id": "ENF-01-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "首版不得自行抓取电商或社交平台，也不得将已接入范围宣称为全网实时发现。",
      "sourceAnchors": [
        "1. 功能概述与交付范围",
        "总览/7. API 与业务材料依赖清单"
      ],
      "acceptanceScenarioIds": [
        "ENF-01-AC-010"
      ]
    },
    {
      "id": "ENF-01-MUST-003",
      "type": "MUST",
      "statement": "接入依赖中心 API 文档、凭证引用、样例以及中心确认的数据授权、覆盖范围和更新条件。",
      "sourceAnchors": [
        "2. 数据来源与依赖"
      ],
      "acceptanceScenarioIds": [
        "ENF-01-AC-010"
      ]
    },
    {
      "id": "ENF-01-MUST-004",
      "type": "MUST",
      "statement": "接入时校验源资源编号、关联关系、版本和访问权限，并分开记录源数据缺失与调用失败。",
      "sourceAnchors": [
        "2. 数据来源与依赖"
      ],
      "acceptanceScenarioIds": [
        "ENF-01-AC-002",
        "ENF-01-AC-006"
      ]
    },
    {
      "id": "ENF-01-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "来源字段、源记录标识、源版本和缺失事实不得由模型生成、替换或推断。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "总览/4. 信息字段说明"
      ],
      "acceptanceScenarioIds": [
        "ENF-01-AC-006"
      ]
    },
    {
      "id": "ENF-01-MUST-005",
      "type": "MUST",
      "statement": "数据源配置至少记录唯一编号、名称、数据类型、API 接入方式、受控地址、认证配置引用、字段映射、负责人、所属机构及创建更新审计。",
      "sourceAnchors": [
        "3. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "ENF-01-AC-001"
      ]
    },
    {
      "id": "ENF-01-MUST-006",
      "type": "MUST",
      "statement": "定时模式必须记录带分钟或小时单位的同步周期；启用或停用状态与连接健康状态分开记录。",
      "sourceAnchors": [
        "3. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "ENF-01-AC-001",
        "ENF-01-AC-005"
      ]
    },
    {
      "id": "ENF-01-MUST-007",
      "type": "MUST",
      "statement": "同步记录最近成功游标和可为空的最近成功时间，详情返回来源及历史配置版本；已有来源字段和业务编号不得随意改写。",
      "sourceAnchors": [
        "3. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "ENF-01-AC-002",
        "ENF-01-AC-009"
      ]
    },
    {
      "id": "ENF-01-MUST-008",
      "type": "MUST",
      "statement": "新增配置的连接测试须校验认证、分页方式、时间字段、唯一键和返回结构；测试结果不替代配置保存或真实同步结果。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-01-AC-001",
        "ENF-01-AC-006"
      ]
    },
    {
      "id": "ENF-01-MUST-009",
      "type": "MUST",
      "statement": "支持编辑、启停、手动同步和定时同步，同一数据源不得并发执行重复同步。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-01-AC-003",
        "ENF-01-AC-005"
      ]
    },
    {
      "id": "ENF-01-MUST-010",
      "type": "MUST",
      "statement": "按源记录 ID 与源版本幂等接入，同一批数据重复同步不得重复创建业务记录。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-01-AC-003"
      ]
    },
    {
      "id": "ENF-01-MUST-011",
      "type": "MUST",
      "statement": "同步失败逐项记录原因；重试不得重复产生业务记录；成功游标只能推进到连续完成位置。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求",
        "总览/3. 通用接口约定"
      ],
      "acceptanceScenarioIds": [
        "ENF-01-AC-004"
      ]
    },
    {
      "id": "ENF-01-MUST_NOT-004",
      "type": "MUST_NOT",
      "statement": "不得静默跳过失败记录后推进同步游标，也不得把超时或限流表示为成功但无数据。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求",
        "总览/3. 通用接口约定"
      ],
      "acceptanceScenarioIds": [
        "ENF-01-AC-004",
        "ENF-01-AC-006"
      ]
    },
    {
      "id": "ENF-01-MUST-012",
      "type": "MUST",
      "statement": "中心 API 无增量能力时按双方约定窗口重新拉取并去重，同步频率不得突破上游限流。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-01-AC-004"
      ]
    },
    {
      "id": "ENF-01-MUST-013",
      "type": "MUST",
      "statement": "源记录更新保留旧快照、源更新时间和获取时间；删除或撤回按接口实际能力标记。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "总览/3. 通用接口约定"
      ],
      "acceptanceScenarioIds": [
        "ENF-01-AC-009"
      ]
    },
    {
      "id": "ENF-01-MUST_NOT-005",
      "type": "MUST_NOT",
      "statement": "源记录删除、撤回、暂时不可用或接口失败不得被推断为业务对象不存在。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "总览/5. 审核与版本通用要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-01-AC-006",
        "ENF-01-AC-009"
      ]
    },
    {
      "id": "ENF-01-MUST-017",
      "type": "MUST",
      "statement": "配置变更、人工修订及审核记录真实操作人、前后状态和版本；编辑使用预期版本并拒绝并发覆盖。",
      "sourceAnchors": [
        "5. 服务接口需求",
        "总览/3. 通用接口约定"
      ],
      "acceptanceScenarioIds": [
        "ENF-01-AC-011"
      ]
    },
    {
      "id": "ENF-01-MUST-018",
      "type": "MUST",
      "statement": "同步任务状态采用 queued、running、succeeded、partial_failed、failed、cancelled；部分失败必须列出未处理项。",
      "sourceAnchors": [
        "5. 服务接口需求",
        "总览/3. 通用接口约定"
      ],
      "acceptanceScenarioIds": [
        "ENF-01-AC-007"
      ]
    },
    {
      "id": "ENF-01-MUST_NOT-006",
      "type": "MUST_NOT",
      "statement": "部分结果不得伪装为完整成功，运行中任务也不得因数据源停用而显示含糊或错误状态。",
      "sourceAnchors": [
        "5. 服务接口需求",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-01-AC-005",
        "ENF-01-AC-007"
      ]
    },
    {
      "id": "ENF-01-MUST-020",
      "type": "MUST",
      "statement": "停用后不再创建新的定时同步任务；运行中任务必须按已确认策略继续、取消或完成，并保持明确状态和审计。",
      "sourceAnchors": [
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-01-AC-005"
      ]
    },
    {
      "id": "ENF-01-MUST-023",
      "type": "MUST",
      "statement": "未确认中心协议、分页、增量、限流、附件和撤回机制时，只允许使用明确标记且与真实环境隔离的模拟数据推进可逆开发。",
      "sourceAnchors": [
        "8. 联调前需确认的条件",
        "总览/3. 通用接口约定"
      ],
      "acceptanceScenarioIds": [
        "ENF-01-AC-010"
      ]
    },
    {
      "id": "ENF-01-MUST_NOT-009",
      "type": "MUST_NOT",
      "statement": "未确认或仅模拟的 API 能力不得标记为真实联调、验证或业务验收通过。",
      "sourceAnchors": [
        "8. 联调前需确认的条件",
        "总览/9. 验收组织"
      ],
      "acceptanceScenarioIds": [
        "ENF-01-AC-010"
      ]
    },
    {
      "id": "ENF-01-MUST-024",
      "type": "MUST",
      "statement": "固定验收样例记录需求编号、请求、输入和配置版本、预期、实际、页面、证据及问题编号；涉及专业判断的预期由中心确认。",
      "sourceAnchors": [
        "7. 验收要求",
        "总览/9. 验收组织"
      ],
      "acceptanceScenarioIds": [
        "ENF-01-AC-013"
      ]
    },
    {
      "id": "ENF-01-SEM-MUST-001",
      "type": "MUST",
      "statement": "本配置/来源/模板能力参与智能体任务时，服务操作或发布成功仅是执行/资源状态，不直接认定用户业务目标完成；运行结果固定所用来源、规则/模板或审核版本，后续纠正只使依赖结果待复核，历史留存且继续原目标链。若发生人工交接，须有真实受理记录。",
      "sourceAnchors": [
        "docs/02-待确认事项清单.md#23",
        "docs/01-总体需求与架构方案.md#5"
      ],
      "acceptanceScenarioIds": [
        "ENF-01-SEM-AC-001"
      ]
    }
  ],
  "inputs": [
    {
      "name": "sourceConfiguration",
      "required": true,
      "rules": [
        "名称、类型、API 地址、凭证引用、字段映射、负责人、机构和预期版本"
      ]
    },
    {
      "name": "schedule",
      "required": "定时模式时",
      "rules": [
        "周期数值及分钟或小时单位，不得突破限流"
      ]
    },
    {
      "name": "syncRequest",
      "required": "同步时",
      "rules": [
        "数据源编号、模式、幂等键、可选约定窗口"
      ]
    },
    {
      "name": "trustedIdentity",
      "required": true,
      "rules": [
        "来自认证上下文，不信任调用方人员名称"
      ]
    }
  ],
  "outputs": [
    {
      "name": "source",
      "fields": [
        "sourceId",
        "version",
        "enabledStatus",
        "healthStatus",
        "lastSuccessCursor",
        "lastSuccessAt",
        "audit"
      ]
    },
    {
      "name": "connectionTest",
      "fields": [
        "authentication",
        "pagination",
        "timeField",
        "uniqueKey",
        "responseShape",
        "requestId",
        "result"
      ]
    },
    {
      "name": "syncTask",
      "fields": [
        "taskId",
        "status",
        "requestId",
        "inputVersion",
        "configurationVersion",
        "counts",
        "cursor",
        "errors",
        "attempts"
      ]
    },
    {
      "name": "sourceSnapshot",
      "fields": [
        "sourceRecordId",
        "sourceVersion",
        "sourceUpdatedAt",
        "fetchedAt",
        "contentDigest",
        "withdrawalStatus"
      ]
    }
  ],
  "permissions": [
    {
      "action": "manage_source",
      "enforcement": "服务端按机构、资源范围和配置管理角色校验"
    },
    {
      "action": "test_connection",
      "enforcement": "服务端使用凭证引用解析密钥，结果仅返回脱敏状态"
    },
    {
      "action": "start_or_cancel_sync",
      "enforcement": "服务端校验数据源状态、权限、幂等和并发"
    },
    {
      "action": "read_task_or_failure",
      "enforcement": "按所属机构、数据源和敏感范围过滤"
    },
    {
      "action": "view_credentials",
      "enforcement": "接口和页面均不得返回密钥，仅返回受控引用或脱敏标识"
    }
  ],
  "states": [
    {
      "name": "启用",
      "kind": "configuration",
      "allowedNext": [
        "停用"
      ]
    },
    {
      "name": "停用",
      "kind": "configuration",
      "allowedNext": [
        "启用"
      ],
      "invariant": "不再创建新定时任务；不自动改写历史任务"
    },
    {
      "name": "连接健康",
      "kind": "health",
      "allowedNext": [
        "连接异常"
      ]
    },
    {
      "name": "连接异常",
      "kind": "health",
      "allowedNext": [
        "连接健康"
      ]
    },
    {
      "name": "queued",
      "kind": "task",
      "allowedNext": [
        "running",
        "cancelled",
        "failed"
      ]
    },
    {
      "name": "running",
      "kind": "task",
      "allowedNext": [
        "succeeded",
        "partial_failed",
        "failed",
        "cancelled"
      ]
    },
    {
      "name": "succeeded",
      "kind": "task",
      "allowedNext": []
    },
    {
      "name": "partial_failed",
      "kind": "task",
      "allowedNext": [],
      "invariant": "列出未处理项，游标不跨越缺口"
    },
    {
      "name": "failed",
      "kind": "task",
      "allowedNext": []
    },
    {
      "name": "cancelled",
      "kind": "task",
      "allowedNext": []
    }
  ],
  "sourceAndVersionRules": [
    "配置使用稳定数据源编号和版本；编辑记录预期版本、操作者及前后状态。",
    "源记录按源 ID 与源版本幂等，更新形成新快照而不覆盖历史。",
    "源更新时间、获取时间、任务时间和配置时间分开记录。",
    "同步结果绑定输入、配置、映射和源版本；上游变化不重写历史结果。",
    "成功游标只覆盖连续成功处理范围，失败明细与尝试关联。",
    "模拟与真实来源、凭证、任务和验证证据隔离并显式标记。"
  ],
  "errorsAndExceptions": [
    {
      "case": "authentication_failed",
      "result": "返回脱敏认证失败和 request_id，不泄露凭证"
    },
    {
      "case": "source_unavailable_or_rate_limited",
      "result": "返回可重试性和明确失败，不表示无数据"
    },
    {
      "case": "success_with_no_data",
      "result": "与调用失败分开表示并记录实际范围"
    },
    {
      "case": "mapping_or_parse_failure",
      "result": "逐项失败，不推进越过该项的游标"
    },
    {
      "case": "duplicate_sync",
      "result": "拒绝并发重复任务或幂等返回原任务"
    },
    {
      "case": "version_conflict",
      "result": "拒绝覆盖并返回当前配置版本"
    },
    {
      "case": "resource_missing_or_unauthorized",
      "result": "拒绝操作且不泄露敏感详情"
    },
    {
      "case": "partial_result",
      "result": "返回 partial_failed、已处理及未处理项"
    },
    {
      "case": "source_withdrawn_or_deleted",
      "result": "按源能力标记，不推断业务不存在"
    }
  ],
  "decisionPoints": [
    {
      "id": "ENF-01-DEC-001",
      "owner": "AI",
      "description": "无业务决定权；不得生成来源、映射、源事实、同步状态或缺失原因。",
      "sourceAnchors": [
        "2. 数据来源与依赖"
      ]
    },
    {
      "id": "ENF-01-DEC-002",
      "owner": "RULE",
      "description": "执行配置校验、权限、版本冲突、幂等、同步并发、限流、状态和连续成功游标规则。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则",
        "5. 服务接口需求"
      ]
    },
    {
      "id": "ENF-01-DEC-003",
      "owner": "HUMAN",
      "description": "授权运维或中心人员维护配置、字段映射、同步模式、负责人、启停和运行中任务处置策略。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则",
        "8. 联调前需确认的条件"
      ]
    },
    {
      "id": "ENF-01-DEC-004",
      "owner": "AUTHORITY_SYSTEM",
      "description": "中心 API 提供真实源记录、版本、覆盖、分页、增量、撤回和限流语义；身份系统提供可信主体和授权范围。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "8. 联调前需确认的条件"
      ]
    }
  ],
  "acceptanceScenarios": [
    {
      "id": "ENF-01-AC-001",
      "given": [
        "合法和非法认证、分页、时间、唯一键及结构样例"
      ],
      "when": "保存配置并测试连接",
      "then": [
