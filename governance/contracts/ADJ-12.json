      "id": "ADJ-12-MUST-010",
      "type": "MUST",
      "statement": "最终报告默认提交人与最终复核人分离；代审、多级审核和中间技术标注人员按中心制度单独配置，不自动获得最终签发权限。",
      "sourceAnchors": [
        "3. 审核流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-12-AC-005"
