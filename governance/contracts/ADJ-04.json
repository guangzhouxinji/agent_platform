  "clauses": [
    {
      "id": "ADJ-04-MUST-001",
      "type": "MUST",
      "statement": "管理知识产权行政裁决案件录入、同步、受理记录、承办分配、进度事件、办结确认和归档，为分析与报告提供统一案件标识及材料版本。",
      "sourceAnchors": [
        "1. 功能概述与范围"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-001",
        "ADJ-04-AC-009"
      ]
    },
    {
      "id": "ADJ-04-MUST-002",
      "type": "MUST",
      "statement": "案件业务状态、案件流程事件、分析任务状态、报告审核状态、签发状态和中心同步状态分别维护。",
      "sourceAnchors": [
        "1. 功能概述与范围",
        "总览/6.1 服务契约"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-004"
      ]
    },
    {
      "id": "ADJ-04-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "不得使用单一 status 混合案件、任务、审核、签发、归档和同步含义。",
      "sourceAnchors": [
        "1. 功能概述与范围",
        "总览/6.1 服务契约"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-004"
      ]
    },
    {
      "id": "ADJ-04-MUST-003",
      "type": "MUST",
      "statement": "案件主档优先来自中心案件 API；本地录入只用于中心授权范围内的服务工作任务，并明确来源与同步状态。",
      "sourceAnchors": [
        "1. 功能概述与范围"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-001"
      ]
    },
    {
      "id": "ADJ-04-MUST_NOT-002",
      "type": "MUST_NOT",
      "statement": "本地临时号、工作记录或页面操作不得冒充中心正式案件编号、正式受理、送达、办结或归档。",
      "sourceAnchors": [
        "1. 功能概述与范围",
        "2. 案件字段",
        "总览/4. 行政裁决业务边界"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-001",
        "ADJ-04-AC-006"
      ]
    },
    {
      "id": "ADJ-04-MUST-004",
      "type": "MUST",
      "statement": "接入权威办案系统时以其稳定案件 ID、源案件 ID、源版本、正式编号和真实回执为准；外部写接口未接通时只保存本地记录。",
      "sourceAnchors": [
        "1. 功能概述与范围",
        "2. 案件字段",
        "5. 服务契约与异常"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-001",
        "ADJ-04-AC-006"
      ]
    },
    {
      "id": "ADJ-04-MUST-005",
      "type": "MUST",
      "statement": "案件记录申请人、被申请人稳定主体标识及受控联系方式和代表信息，并按案件权限查看。",
      "sourceAnchors": [
        "2. 案件字段"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-002",
        "ADJ-04-AC-010"
      ]
    },
    {
      "id": "ADJ-04-MUST-006",
      "type": "MUST",
      "statement": "案件类型、程序和管辖信息使用中心业务目录，是否属于本机关行政裁决范围由中心规则和授权人员确认。",
      "sourceAnchors": [
        "2. 案件字段",
        "总览/4. 行政裁决业务边界"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-002"
      ]
    },
    {
      "id": "ADJ-04-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "不得因知识产权案件标签、模型分类或本地录入自动确认管辖、受理或行政裁决范围。",
      "sourceAnchors": [
        "2. 案件字段",
        "总览/4. 行政裁决业务边界"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-002"
      ]
    },
    {
      "id": "ADJ-04-MUST-007",
      "type": "MUST",
      "statement": "涉案专利或商标支持多项并关联具体权利资料版本；核心事实与争议焦点区分当事人主张、待核实事实和人工确认事实。",
      "sourceAnchors": [
        "2. 案件字段",
        "总览/4. 行政裁决业务边界"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-003"
      ]
    },
    {
      "id": "ADJ-04-MUST_NOT-004",
      "type": "MUST_NOT",
      "statement": "模型提取、材料反映或当事人主张不得自动转成已确认案件事实。",
      "sourceAnchors": [
        "2. 案件字段",
        "总览/4. 行政裁决业务边界"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-003"
      ]
    },
    {
      "id": "ADJ-04-MUST-008",
      "type": "MUST",
      "statement": "收件时间、受理时间、承办人、流程事件和归档时间仅记录实际事件、真实人员或权威回执。",
      "sourceAnchors": [
        "2. 案件字段",
        "3. 生命周期与业务操作",
        "总览/5.1 身份和来源"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-004",
        "ADJ-04-AC-006"
      ]
    },
    {
      "id": "ADJ-04-MUST_NOT-005",
      "type": "MUST_NOT",
      "statement": "不得推测生成受理时间、承办人、调查质证、签发、送达、办结或归档事件；未分配案件不得默认归属当前用户。",
      "sourceAnchors": [
        "2. 案件字段",
        "3. 生命周期与业务操作",
        "总览/4. 行政裁决业务边界"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-004"
      ]
    },
    {
      "id": "ADJ-04-MUST-009",
      "type": "MUST",
      "statement": "当前环节和进度由确认的流程事件驱动，进度不得使用模型百分数表示。",
      "sourceAnchors": [
        "2. 案件字段"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-004"
      ]
    },
    {
      "id": "ADJ-04-MUST-010",
      "type": "MUST",
      "statement": "预计完成时间作为工作计划；法定期限、调整和逾期必须依据中心确认的规则及中止、恢复、延期等真实事件。",
      "sourceAnchors": [
        "2. 案件字段",
        "3. 生命周期与业务操作"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-005"
      ]
    },
    {
      "id": "ADJ-04-MUST_NOT-006",
      "type": "MUST_NOT",
      "statement": "人工计划日期不得冒充法定期限，无确认规则时不得计算或宣称法定逾期。",
      "sourceAnchors": [
        "3. 生命周期与业务操作",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-005"
      ]
    },
    {
      "id": "ADJ-04-MUST-011",
      "type": "MUST",
      "statement": "本地状态建议仅作为待中心确认的软件模型；草稿可不完整，提交受理确认前按中心规则校验双方主体、类型、材料和必填项。",
      "sourceAnchors": [
        "3. 生命周期与业务操作"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-002"
      ]
    },
    {
      "id": "ADJ-04-MUST_NOT-007",
      "type": "MUST_NOT",
      "statement": "建议状态机和不予受理、撤回、终止、中止等分支不得被解释为已确认法定程序、条件或期限。",
      "sourceAnchors": [
        "3. 生命周期与业务操作"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-002",
        "ADJ-04-AC-005"
      ]
    },
    {
      "id": "ADJ-04-MUST-012",
      "type": "MUST",
      "statement": "受理或不予受理由授权人员确认并记录时间、依据和原因；权威系统模式必须取得真实回执后同步正式状态。",
      "sourceAnchors": [
        "3. 生命周期与业务操作"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-006"
      ]
    },
    {
      "id": "ADJ-04-MUST-013",
      "type": "MUST",
      "statement": "分配和转派保留前后承办人、原因、时间、操作者和状态版本；非法或并发冲突操作由后端拒绝。",
      "sourceAnchors": [
        "3. 生命周期与业务操作",
        "5. 服务契约与异常"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-004"
      ]
    },
    {
      "id": "ADJ-04-MUST-014",
      "type": "MUST",
      "statement": "案情补充或更正生成新资料版本，标记依赖的匹配、分析和报告待更新，旧结果、人工确认和引用不直接改写。",
      "sourceAnchors": [
        "3. 生命周期与业务操作",
        "总览/5.2 资料变化影响"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-007"
      ]
    },
    {
      "id": "ADJ-04-MUST-015",
      "type": "MUST",
      "statement": "办结确认检查报告和中心要求的签发或办理材料；归档检查材料清单及未完成任务，缺项时阻止并返回原因。",
      "sourceAnchors": [
        "3. 生命周期与业务操作"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-008"
      ]
    },
    {
      "id": "ADJ-04-MUST-016",
      "type": "MUST",
      "statement": "已归档案件只读；补正或重新开启必须执行授权动作并保留归档快照。",
      "sourceAnchors": [
        "3. 生命周期与业务操作",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-008"
      ]
    },
    {
      "id": "ADJ-04-MUST_NOT-008",
      "type": "MUST_NOT",
      "statement": "已归档案件不得普通编辑或删除，补正不得覆盖归档快照。",
      "sourceAnchors": [
        "3. 生命周期与业务操作"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-008"
      ]
    },
    {
      "id": "ADJ-04-MUST-018",
      "type": "MUST",
      "statement": "外部状态同步使用按调用方、操作和内容绑定的幂等键及对账，超时不得默认成功，源失败不得覆盖已确认信息。",
      "sourceAnchors": [
        "5. 服务契约与异常",
        "总览/6.1 服务契约",
        "总览/6.2 耗时任务"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-006"
      ]
    },
    {
      "id": "ADJ-04-MUST-022",
      "type": "MUST",
      "statement": "权威系统、受理、期限、办结、归档、材料清单、写回范围、回执和角色须由中心确认；首版不默认自动通知当事人。",
      "sourceAnchors": [
        "8. 依赖与交付",
        "总览/4. 行政裁决业务边界",
        "总览/8. 依赖与待落实材料"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-AC-012"
      ]
    },
    {
      "id": "ADJ-04-SEM-MUST-001",
      "type": "MUST",
      "statement": "本能力参与智能体任务时，一次工具执行成功、局部输出、通知或审核动作不直接认定整个用户业务目标完成；跨轮对象绑定稳定版本，纠正保留原目标与历史并重核依赖结果；人工接收须有实际记录，业务、任务、审核、正式状态分别表达。",
      "sourceAnchors": [
        "docs/02-待确认事项清单.md#23",
        "docs/01-总体需求与架构方案.md#5"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-SEM-AC-001"
      ]
    },
    {
      "id": "ADJ-04-SEM-MUST-002",
      "type": "MUST",
      "statement": "本地辅助任务接收记录与案件正式受理分开；前者须有真实人员动作。本地案件受理由授权人员按已确认流程登记实际事实；权威系统模式下只有真实权威回执才同步正式状态，不能用本地领取、模型输出或接口超时推定。",
      "sourceAnchors": [
        "docs/02-待确认事项清单.md#23",
        "1. 功能概述与范围"
      ],
      "acceptanceScenarioIds": [
        "ADJ-04-SEM-AC-002"
      ]
    }
  ],
  "inputs": [
    {
      "name": "caseMaster",
      "required": "创建或同步时",
      "rules": [
        "来源、稳定 ID、源版本、主体、类型、材料和幂等键"
      ]
    },
    {
      "name": "caseRevision",
      "required": "资料修改时",
      "rules": [
        "当前版本、变更项、理由和可信身份"
      ]
    },
    {
      "name": "workflowAction",
      "required": "流程或分配时",
      "rules": [
        "当前状态版本、动作、人员、依据和幂等键"
      ]
    },
    {
      "name": "archiveAction",
      "required": "办结归档或补正时",
      "rules": [
        "案件版本、材料清单、动作原因和权威回执"
      ]
    }
  ],
  "outputs": [
    {
      "name": "case",
      "fields": [
        "caseId",
        "officialNumber",
        "temporaryNumber",
        "sourceSystem",
        "sourceCaseId",
        "sourceVersion",
        "businessStatus",
        "syncStatus",
        "dataVersion",
        "permissionScope"
      ]
    },
    {
      "name": "workflowEvent",
      "fields": [
        "eventId",
        "type",
        "oldState",
        "newState",
        "actor",
        "occurredAt",
        "basis",
        "authorityReceipt"
      ]
    },
    {
      "name": "assignment",
      "fields": [
        "previousAssignee",
        "newAssignee",
        "reason",
        "actor",
        "time"
      ]
    },
    {
      "name": "changeImpact",
      "fields": [
        "affectedMatches",
        "affectedAnalyses",
        "affectedReports",
        "requiresUpdate"
      ]
    },
    {
      "name": "archiveSnapshot",
      "fields": [
        "caseVersion",
        "materialChecklist",
        "openTasks",
        "archiveStatus",
        "authoritySyncStatus"
      ]
    }
  ],
  "permissions": [
    {
      "action": "create_or_sync",
      "enforcement": "中心授权范围、来源和稳定身份校验"
    },
    {
      "action": "read_case_or_material",
      "enforcement": "案件、机构、人员职责和当前权限实时校验"
    },
    {
      "action": "accept_or_reject",
      "enforcement": "中心授权受理角色及权威回执规则"
    },
    {
      "action": "assign_or_transfer",
      "enforcement": "分配权限、候选人员和状态版本校验"
    },
    {
      "action": "complete_archive_or_reopen",
      "enforcement": "独立授权角色、材料清单、状态和回执校验"
    },
    {
      "action": "official_state_write",
      "enforcement": "仅权威系统写接口或真实授权人员确认，本服务不得模拟"
    }
  ],
  "states": [
