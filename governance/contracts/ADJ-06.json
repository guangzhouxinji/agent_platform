      ],
      "sourceClauseIds": [
        "ADJ-06-MUST-001",
        "ADJ-06-MUST_NOT-001",
        "ADJ-06-MUST-002"
      ]
    },
    {
      "id": "ADJ-06-AC-002",
      "given": [
        "逐字原文、节引、概述和格式化内容"
      ],
      "when": "预览和保存引用",
      "then": [
        "四类内容显式区分",
        "节引可回到具体条款核验",
        "生成内容不污染原文"
      ],
      "sourceClauseIds": [
        "ADJ-06-MUST-002",
        "ADJ-06-MUST-003",
        "ADJ-06-MUST_NOT-002"
      ]
    },
    {
      "id": "ADJ-06-AC-003",
      "given": [
        "历史案件、失效法规、缺失原文或冲突来源"
      ],
      "when": "确认引用",
