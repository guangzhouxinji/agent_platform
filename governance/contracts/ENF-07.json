  "clauses": [
    {
      "id": "ENF-07-MUST-001",
      "type": "MUST",
      "statement": "按已发布规则整理证据与待证明事实的关联、时间线、缺口和矛盾清单，形成供人工审核的版本化结果。",
      "sourceAnchors": [
        "1. 功能概述与交付范围"
      ],
      "acceptanceScenarioIds": [
        "ENF-07-AC-001",
        "ENF-07-AC-006"
      ]
    },
    {
      "id": "ENF-07-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "自动整理结果不得表述为完整有效证据链、事实已获证明或正式执法结论。",
      "sourceAnchors": [
        "1. 功能概述与交付范围",
        "4. 功能与处理规则",
        "总览/5. 审核与版本通用要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-07-AC-004"
      ]
    },
    {
      "id": "ENF-07-MUST-003",
      "type": "MUST",
      "statement": "整理仅使用有权读取的固定案件快照、证据版本集合和规则版本，并在任务前校验编号、关联、版本和权限。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-07-AC-001",
        "ENF-07-AC-008"
      ]
    },
    {
      "id": "ENF-07-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "来源、案件事实、证据内容、规则版本和缺失信息不得由模型生成、替换或补造。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "总览/4. 信息字段说明"
      ],
      "acceptanceScenarioIds": [
        "ENF-07-AC-004",
        "ENF-07-AC-008"
