  "inputs": [
    {
      "name": "ingestionBatch",
      "required": "导入时",
      "rules": [
        "源引用或文件、重复策略、幂等键、来源和版本"
      ]
    },
    {
      "name": "localVersionDraft",
      "required": "人工维护时",
      "rules": [
        "原版本、内容、差异、理由、预期版本和可信身份"
      ]
    },
    {
      "name": "revisionRecord",
      "required": "修订维护时",
      "rules": [
        "修订日期、类型、说明、依据、修订前全文和新旧版本"
      ]
    },
    {
      "name": "pointInTimeQuery",
      "required": "时点查询时",
      "rules": [
        "法规稳定 ID、相关日期、地域和用途"
      ]
    }
  ],
  "outputs": [
    {
      "name": "regulationVersion",
      "fields": [
        "regulationId",
        "sourceSystemId",
        "versionId",
        "metadata",
        "verbatimText",
        "source",
        "effectiveInterval",
        "status",
        "verificationStatus"
      ]
    },
    {
      "name": "article",
      "fields": [
        "articleId",
        "versionId",
        "number",
        "hierarchy",
        "verbatimText",
        "sourceAnchor"
      ]
    },
    {
      "name": "revision",
      "fields": [
        "revisionId",
        "oldVersionId",
        "newVersionId",
        "date",
        "type",
        "description",
        "basis",
        "preRevisionText",
        "status"
      ]
    },
    {
      "name": "ingestionResult",
      "fields": [
        "taskId",
        "added",
        "updated",
        "skipped",
        "succeeded",
        "failed",
        "rowErrors",
        "requestId"
      ]
    },
    {
      "name": "pointInTimeCandidates",
      "fields": [
        "candidateVersions",
        "effectiveIntervals",
        "transitionGaps",
        "manualVerificationRequired"
      ]
    }
  ],
  "permissions": [
    {
      "action": "query",
      "enforcement": "法规查询权限、机构及源授权"
    },
    {
      "action": "import",
      "enforcement": "独立导入角色、来源范围和幂等校验"
    },
    {
      "action": "maintain_local_version",
      "enforcement": "人工校核角色、预期版本和差异审计"
    },
    {
      "action": "maintain_revision",
      "enforcement": "修订维护角色；已引用记录禁止物理删除"
    },
    {
      "action": "confirm_as_citation_basis",
      "enforcement": "中心授权业务人员，待核实版本不得自动通过"
    }
  ],
  "states": [
    {
      "name": "未生效",
      "kind": "source_effectiveness",
      "allowedNext": [
        "现行有效",
        "已废止",
        "无法核实"
      ]
    },
    {
      "name": "现行有效",
      "kind": "source_effectiveness",
      "allowedNext": [
        "已失效",
        "已废止",
        "无法核实"
      ]
    },
    {
      "name": "已失效",
      "kind": "source_effectiveness",
      "allowedNext": []
    },
    {
      "name": "已废止",
      "kind": "source_effectiveness",
      "allowedNext": []
    },
    {
      "name": "无法核实",
      "kind": "verification",
      "allowedNext": [
        "未生效",
        "现行有效",
        "已失效",
        "已废止"
      ],
      "invariant": "不得自动确认为裁决依据"
    },
    {
      "name": "有效记录",
      "kind": "revision",
      "allowedNext": [
        "已撤回"
      ]
    },
    {
      "name": "已撤回",
      "kind": "revision",
      "allowedNext": [],
      "invariant": "原记录、版本和引用链保留"
    }
  ],
  "sourceAndVersionRules": [
    "中心原文和本地校核版本分开，中心版本只读。",
    "法规、条文、修订和来源均使用稳定 ID 与具体不可变版本。",
    "正文变化生成新版本，历史修订前全文锁定旧版本且不覆盖。",
    "源更新时间、发布时间、实施时间、获取导入时间、业务查询时间和人工修改时间分开。",
    "法规变化向解析、要点、匹配、引用和未签发报告传播需复核，不自动改写下游。",
    "源无版本时保存授权快照和内容摘要；模拟与真实来源隔离。"
  ],
  "errorsAndExceptions": [
    {
      "case": "required_field_or_date_invalid",
      "result": "逐行失败并返回字段路径"
    },
