  "sourceAndVersionRules": [
    "官方法律状态与技术风险意见分栏、分来源保存。",
    "每次分析冻结时点、解析、事件、文献、规则和模型版本。",
    "补充材料和重跑创建新版本，旧报告复核引用保留。",
    "无效请求受理决定及后续程序分开。"
  ],
  "errorsAndExceptions": [
    {
      "case": "historical_status_missing",
      "result": "返回无法核实，不用当前状态替代"
    },
    {
      "case": "official_sources_conflict",
      "result": "列出冲突并交人工核查"
    },
    {
      "case": "fee_record_missing",
      "result": "记录缺口，不推断终止"
    },
    {
      "case": "prior_art_date_unverified",
      "result": "不作为已确认现有技术"
    },
    {
      "case": "partial_failure",
      "result": "逐栏状态和原因，不生成整体有效低风险"
    },
    {
      "case": "unauthorized",
      "result": "拒绝且材料不进入模型"
    }
  ],
