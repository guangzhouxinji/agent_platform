  "clauses": [
    {
      "id": "ENF-05-MUST-001",
      "type": "MUST",
      "statement": "接收和管理案件或线索相关证据材料及其来源、版本和访问权限，并向后续分析提供受控引用。",
      "sourceAnchors": [
        "1. 功能概述与交付范围"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-001",
        "ENF-05-AC-009"
      ]
    },
    {
      "id": "ENF-05-MUST-002",
      "type": "MUST",
      "statement": "系统记录文件字节与元数据完整性信息；证据合法性和真实性只能由授权业务人员审核确认。",
      "sourceAnchors": [
        "1. 功能概述与交付范围",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-006"
      ]
    },
    {
      "id": "ENF-05-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "文件摘要、上传成功、OCR 成功或模型分析不得自动确认法律上的合法性、真实性或证明力。",
      "sourceAnchors": [
        "1. 功能概述与交付范围",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-004",
        "ENF-05-AC-006"
      ]
    },
    {
      "id": "ENF-05-MUST-004",
      "type": "MUST",
      "statement": "证据仅从中心证据 API 或授权人员上传接入，并依赖中心案件或线索稳定标识及可信账号权限。",
      "sourceAnchors": [
        "2. 数据来源与依赖"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-001",
        "ENF-05-AC-010"
      ]
    },
    {
      "id": "ENF-05-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "本功能不得扩展为完整案件办理系统，也不得自行创建权威案件、线索或人员身份。",
      "sourceAnchors": [
        "2. 数据来源与依赖"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-010"
      ]
    },
    {
      "id": "ENF-05-MUST-005",
      "type": "MUST",
      "statement": "接入时校验证据、案件或线索编号、关联关系、源版本和当前访问权限，并分开记录源数据缺失和调用失败。",
      "sourceAnchors": [
        "2. 数据来源与依赖"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-008"
      ]
    },
    {
      "id": "ENF-05-MUST_NOT-004",
      "type": "MUST_NOT",
      "statement": "来源系统、上传渠道、收集信息、关联关系及源版本不得由模型生成或替换。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "总览/4. 信息字段说明"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-001",
        "ENF-05-AC-008"
      ]
    },
    {
      "id": "ENF-05-MUST-006",
      "type": "MUST",
      "statement": "证据记录唯一编号、名称、类型、文件或中心受控资源引用、来源、机构、存储资源标识、状态、原件及派生版本关系和审计字段。",
      "sourceAnchors": [
        "3. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-001"
      ]
    },
    {
      "id": "ENF-05-MUST-007",
      "type": "MUST",
      "statement": "每份证据至少关联案件或线索之一；关联资源不存在或无权限时拒绝登记和访问。",
      "sourceAnchors": [
        "3. 信息字段",
        "5. 服务接口需求"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-001",
        "ENF-05-AC-007"
      ]
    },
    {
      "id": "ENF-05-MUST-008",
      "type": "MUST",
      "statement": "收集人和收集时间在已知时记录真实值，未知时记录原因；创建人或上传人不得自动替代收集人。",
      "sourceAnchors": [
        "3. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-001"
      ]
    },
    {
      "id": "ENF-05-MUST_NOT-005",
      "type": "MUST_NOT",
      "statement": "不得为满足必填或形成完整证据链而编造收集人、收集时间、来源或关联事实。",
      "sourceAnchors": [
        "3. 信息字段",
        "总览/4. 信息字段说明"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-001"
      ]
    },
    {
      "id": "ENF-05-MUST-009",
      "type": "MUST",
      "statement": "存储位置对外仅返回内部受控资源标识，不暴露真实磁盘路径；文件链接具有有效期并在访问时鉴权。",
      "sourceAnchors": [
        "3. 信息字段",
        "总览/3. 通用接口约定"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-007"
      ]
    },
    {
      "id": "ENF-05-MUST-010",
      "type": "MUST",
      "statement": "证据状态为待核验、已核验、已排除、已归档，状态变更由授权人员执行并保留前后状态、理由、人员和时间。",
      "sourceAnchors": [
        "3. 信息字段",
        "5. 服务接口需求",
        "总览/5. 审核与版本通用要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-006"
      ]
    },
    {
      "id": "ENF-05-MUST-011",
      "type": "MUST",
      "statement": "支持 API 接入、授权上传、列表、详情、元数据维护、案件或线索关联、受控预览下载和核验状态变更；文件类型和大小限额可配置。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "5. 服务接口需求"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-009",
        "ENF-05-AC-012"
      ]
    },
    {
      "id": "ENF-05-MUST-012",
      "type": "MUST",
      "statement": "物证仅管理描述、照片和保管信息，并明确其物理实物状态。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-005"
      ]
    },
    {
      "id": "ENF-05-MUST_NOT-006",
      "type": "MUST_NOT",
      "statement": "电子附件、照片或描述不得被表述为已经替代实物管理、保管或核验。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-005"
      ]
    },
    {
      "id": "ENF-05-MUST-013",
      "type": "MUST",
      "statement": "原始文件字节不可变保存；OCR 文本、转码件和摘要作为关联原件的派生版本，元数据修改保留审计。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-002",
        "ENF-05-AC-003"
      ]
    },
    {
      "id": "ENF-05-MUST_NOT-007",
      "type": "MUST_NOT",
      "statement": "更新、重新上传、OCR、转码或摘要不得覆盖已有原件字节、历史版本或既有引用。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-002",
        "ENF-05-AC-003"
      ]
    },
    {
      "id": "ENF-05-MUST-014",
      "type": "MUST",
      "statement": "取得实际文件字节后计算文件摘要，并将摘要算法、值和对应文件版本记录为完整性校验信息。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-004"
      ]
    },
    {
      "id": "ENF-05-MUST-015",
      "type": "MUST",
      "statement": "相同摘要只可提示可能重复，不自动合并不同来源、收集过程或案件关联。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-004"
      ]
    },
    {
      "id": "ENF-05-MUST_NOT-008",
      "type": "MUST_NOT",
      "statement": "文件摘要不得用作证据真实性、合法性、同一收集行为或内容法律含义的证明。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-004",
        "ENF-05-AC-006"
      ]
    },
    {
      "id": "ENF-05-MUST-016",
      "type": "MUST",
      "statement": "案件和线索权限在列表、详情、预览、下载、派生件、历史及下游引用读取时由后端重新检查；访问日志记录操作者和时间。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求",
        "总览/3. 通用接口约定"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-007"
      ]
    },
    {
      "id": "ENF-05-MUST-017",
      "type": "MUST",
      "statement": "已被分析结果或其他业务对象引用的证据禁止物理删除，只能按授权状态机标记排除或归档并保留引用完整性。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-011"
      ]
    },
    {
      "id": "ENF-05-MUST-018",
      "type": "MUST",
      "statement": "无法预览的格式在授权和安全策略允许时仍可下载，并返回无法预览的明确原因。",
      "sourceAnchors": [
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-007"
      ]
    },
    {
      "id": "ENF-05-MUST-019",
      "type": "MUST",
      "statement": "服务写入返回证据编号、版本和完整性校验结果；列表支持案件、线索、类型、状态、分页和更新时间排序；详情返回完整来源及历史版本。",
      "sourceAnchors": [
        "5. 服务接口需求",
        "6. 内部验证页面"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-009"
      ]
    },
    {
      "id": "ENF-05-MUST_NOT-009",
      "type": "MUST_NOT",
      "statement": "部分接入或解析不得伪装完整成功，源故障不得伪装为无证据或空材料。",
      "sourceAnchors": [
        "5. 服务接口需求",
        "总览/3. 通用接口约定",
        "总览/5. 审核与版本通用要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-008"
      ]
    },
    {
      "id": "ENF-05-MUST-023",
      "type": "MUST",
      "statement": "文件类型、大小、保留期限、中心资源链接有效期及原件存储位置须在接入时由中心确认并配置。",
      "sourceAnchors": [
        "8. 联调前需确认的条件"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-012"
      ]
    },
    {
      "id": "ENF-05-MUST-024",
      "type": "MUST",
      "statement": "未确认外部条件时只允许显式模拟且隔离的可逆开发，不能升级为真实联调、完整实现或业务验收。",
      "sourceAnchors": [
        "8. 联调前需确认的条件",
        "总览/3. 通用接口约定",
        "总览/9. 验收组织"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-AC-012"
      ]
    },
    {
      "id": "ENF-05-SEM-MUST-001",
      "type": "MUST",
      "statement": "本能力参与智能体任务时，一次工具执行成功、局部输出、通知或审核动作不直接认定整个用户业务目标完成；跨轮对象绑定稳定版本，纠正保留原目标与历史并重核依赖结果；人工接收须有实际记录，业务、任务、审核、正式状态分别表达。",
      "sourceAnchors": [
        "docs/02-待确认事项清单.md#23",
        "docs/01-总体需求与架构方案.md#5"
      ],
      "acceptanceScenarioIds": [
        "ENF-05-SEM-AC-001"
      ]
    }
  ],
  "inputs": [
    {
      "name": "evidenceRegistration",
      "required": true,
      "rules": [
        "名称、类型、来源、案件或线索至少一项、文件或受控资源引用、可信身份"
      ]
    },
    {
      "name": "collectionMetadata",
      "required": false,
      "rules": [
        "真实收集人和时间；未知时分别记录原因"
      ]
    },
    {
      "name": "fileUpload",
      "required": "上传模式时",
      "rules": [
        "文件类型与大小按配置、幂等键、原件标识"
      ]
    },
    {
      "name": "metadataRevision",
      "required": "修改时",
      "rules": [
        "预期版本、前后值、理由和操作者"
      ]
    },
    {
      "name": "statusAction",
      "required": "核验、排除或归档时",
      "rules": [
        "预期状态、理由和授权身份"
      ]
    }
  ],
  "outputs": [
    {
      "name": "evidence",
      "fields": [
        "evidenceId",
        "version",
        "name",
        "type",
        "caseId",
        "clueId",
        "source",
        "collectionMetadata",
        "status",
        "storageReference",
        "audit"
      ]
    },
    {
      "name": "contentVersion",
      "fields": [
        "versionId",
        "kind",
        "originalVersionId",
        "digestAlgorithm",
        "digest",
        "createdAt",
        "processingStatus"
      ]
    },
    {
      "name": "accessResult",
      "fields": [
        "previewStatus",
        "downloadReference",
        "expiresAt",
        "failureReason",
        "requestId"
      ]
    },
    {
      "name": "integrity",
      "fields": [
        "bytesReceived",
        "digestVerified",
        "duplicateCandidates",
        "notAuthenticityDecision"
      ]
    }
  ],
  "permissions": [
    {
      "action": "register_or_upload",
      "enforcement": "服务端校验可信身份、机构、案件或线索及上传权限"
    },
    {
      "action": "read_metadata_or_history",
      "enforcement": "按案件、线索、机构和证据状态实时授权"
    },
    {
      "action": "preview_or_download",
      "enforcement": "每次访问重新鉴权并签发短期受控引用"
    },
    {
      "action": "revise_metadata",
      "enforcement": "授权人员及预期版本校验"
    },
    {
      "action": "verify_exclude_archive",
      "enforcement": "中心授权审核角色；不得由 AI 或 Agent 触发"
    },
    {
      "action": "physical_delete",
      "enforcement": "被引用证据绝对禁止；其他情况仍依中心保留和删除策略"
    }
  ],
  "states": [
    {
      "name": "待核验",
      "kind": "evidence",
      "allowedNext": [
        "已核验",
        "已排除",
        "已归档"
      ]
    },
    {
      "name": "已核验",
      "kind": "evidence",
      "allowedNext": [
        "已排除",
        "已归档"
      ]
    },
    {
      "name": "已排除",
      "kind": "evidence",
      "allowedNext": [
        "已归档"
      ],
      "invariant": "保留记录、版本和既有引用"
    },
    {
      "name": "已归档",
      "kind": "evidence",
      "allowedNext": [],
      "invariant": "按保留策略限制新使用但保持审计"
    },
    {
      "name": "原件",
      "kind": "content_version",
      "allowedNext": [],
      "invariant": "字节不可被派生处理覆盖"
    },
    {
      "name": "派生件",
      "kind": "content_version",
      "allowedNext": [],
      "invariant": "必须关联具体原件版本并标明 OCR、转码或摘要类型"
    }
  ],
  "sourceAndVersionRules": [
    "中心资源或上传原件保留来源渠道、源标识、源版本、获取或上传时间和内容摘要。",
    "原件字节不可变；OCR、转码和摘要形成显式派生版本并引用原件。",
    "元数据修改形成版本与审计，不重写原件、来源或历史业务引用。",
    "收集人与上传人、收集时间与上传时间分别记录，不互相替代。",
    "同摘要只产生重复候选提示，保留各自收集过程、来源和关联。",
    "权限收紧或源撤回后阻止新内容访问，受控审计与历史引用仍保留。"
  ],
  "errorsAndExceptions": [
    {
      "case": "case_or_clue_missing_or_unauthorized",
      "result": "拒绝登记或访问且不泄露材料"
    },
    {
      "case": "source_unavailable",
      "result": "返回上游失败，不表示无证据"
    },
    {
      "case": "file_type_or_size_rejected",
      "result": "按已确认配置拒绝并返回限制"
    },
    {
      "case": "preview_unsupported",
      "result": "返回不可预览原因；授权时仍可下载"
    },
    {
      "case": "digest_duplicate",
      "result": "返回候选提示，不自动合并"
    },
    {
      "case": "referenced_evidence_delete",
      "result": "拒绝物理删除，允许按权限标记排除"
    },
    {
      "case": "version_or_state_conflict",
      "result": "拒绝覆盖并返回当前版本或状态"
    },
