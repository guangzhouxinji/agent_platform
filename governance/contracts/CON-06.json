  "clauses": [
    {
      "id": "CON-06-MUST-001",
      "type": "MUST",
      "statement": "对目标技术方案或专利与人工选定文献逐项比对技术特征，输出原文证据、差异、缺口和辅助意见；检索只提供候选入口。",
      "sourceAnchors": [
        "1. 功能概述与边界"
      ],
      "acceptanceScenarioIds": [
        "CON-06-AC-001"
      ]
    },
    {
      "id": "CON-06-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "检索相关度、技术对照或任务成功不得直接表述为新颖性、侵权、落入保护范围或其他确定法律结论。",
      "sourceAnchors": [
        "1. 功能概述与边界",
        "3. 分析流程",
        "4. 输出与评分"
      ],
      "acceptanceScenarioIds": [
        "CON-06-AC-001",
        "CON-06-AC-006"
      ]
    },
    {
      "id": "CON-06-MUST-002",
      "type": "MUST",
      "statement": "区分技术相似辅助、权利要求对产品方案、新颖性辅助和外观设计辅助目的，使用与对象类型相符的独立流程。",
      "sourceAnchors": [
        "1. 功能概述与边界",
        "2. 字段与输入校验"
      ],
      "acceptanceScenarioIds": [
        "CON-06-AC-002"
      ]
    },
    {
      "id": "CON-06-MUST_NOT-002",
      "type": "MUST_NOT",
      "statement": "发明实用新型文本流程不得复用于外观设计；外观缺少可比视图、图像能力或独立规则时不得形成完整结论。",
      "sourceAnchors": [
        "1. 功能概述与边界",
        "3. 分析流程"
      ],
      "acceptanceScenarioIds": [
        "CON-06-AC-002"
      ]
    },
    {
      "id": "CON-06-MUST-003",
      "type": "MUST",
      "statement": "固定分析目的、技术对象、目标和候选文献版本、选定权利要求、相关日期地域、规则模型及权限。",
      "sourceAnchors": [
        "2. 字段与输入校验",
        "3. 分析流程"
      ],
      "acceptanceScenarioIds": [
        "CON-06-AC-003"
      ]
    },
    {
      "id": "CON-06-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "涉及法律问题时不得默认当前日期或法域，资料不足不得通过提示词、摘要或模型推测补事实。",
      "sourceAnchors": [
        "1. 功能概述与边界",
        "2. 字段与输入校验",
        "8. 依赖与交付"
      ],
      "acceptanceScenarioIds": [
        "CON-06-AC-003"
      ]
    },
    {
      "id": "CON-06-MUST-004",
      "type": "MUST",
      "statement": "必要全文或权利要求缺失、OCR 质量不足、依赖解析失败和视图不足分别形成补充项和未执行范围。",
      "sourceAnchors": [
        "3. 分析流程",
        "6. 服务契约与异常"
      ],
      "acceptanceScenarioIds": [
        "CON-06-AC-003"
      ]
    },
    {
      "id": "CON-06-MUST_NOT-004",
      "type": "MUST_NOT",
      "statement": "摘要不得冒充权利要求，未找到仅表示已分析材料中未找到，无法判断不得改写为未对应或不相似。",
      "sourceAnchors": [
        "3. 分析流程"
      ],
      "acceptanceScenarioIds": [
        "CON-06-AC-004"
      ]
    },
    {
      "id": "CON-06-MUST-005",
      "type": "MUST",
      "statement": "提取特征保留 ID、逐字原文、层级依赖和来源定位，展开所选从属权利要求引用的前项特征并由用户确认修订。",
      "sourceAnchors": [
        "2. 字段与输入校验",
        "3. 分析流程"
      ],
      "acceptanceScenarioIds": [
        "CON-06-AC-004"
      ]
    },
    {
      "id": "CON-06-MUST-006",
      "type": "MUST",
      "statement": "对每个候选逐对、逐特征记录对应、部分对应、未找到或无法判断、原文位置、差异和原因。",
      "sourceAnchors": [
        "2. 字段与输入校验",
        "3. 分析流程"
      ],
      "acceptanceScenarioIds": [
        "CON-06-AC-004"
      ]
    },
    {
      "id": "CON-06-MUST_NOT-005",
      "type": "MUST_NOT",
      "statement": "新颖性辅助不得把多篇文献拼接覆盖特征当作单篇已公开，技术文本相似不得自动等同权利要求落入。",
      "sourceAnchors": [
        "3. 分析流程"
      ],
      "acceptanceScenarioIds": [
        "CON-06-AC-005"
      ]
    },
    {
      "id": "CON-06-MUST-007",
      "type": "MUST",
      "statement": "外观子流程逐候选核对相应视图，列出缺失视图并仅基于实际可见内容描述整体和局部差异。",
      "sourceAnchors": [
        "3. 分析流程"
      ],
      "acceptanceScenarioIds": [
        "CON-06-AC-002"
      ]
    },
    {
      "id": "CON-06-MUST-008",
      "type": "MUST",
      "statement": "报告固定输入版本、完整性、逐项对照、证据、差异、辅助意见、缺口、实际范围、规则模型和审核记录。",
      "sourceAnchors": [
        "4. 输出与评分"
      ],
      "acceptanceScenarioIds": [
        "CON-06-AC-006"
      ]
    },
    {
      "id": "CON-06-MUST-009",
      "type": "MUST",
      "statement": "技术对照评分与检索分数分开，固定分母、权重、部分对应和缺失处理及规则版本；未分析不得计为不相似。",
      "sourceAnchors": [
        "2. 字段与输入校验",
        "4. 输出与评分"
      ],
      "acceptanceScenarioIds": [
        "CON-06-AC-006"
      ]
    },
    {
      "id": "CON-06-MUST_NOT-006",
      "type": "MUST_NOT",
      "statement": "未标定时不得由模型猜测百分数，必须输出对照表与有依据标签并标数值能力未完成。",
      "sourceAnchors": [
        "4. 输出与评分"
      ],
      "acceptanceScenarioIds": [
        "CON-06-AC-006"
      ]
    },
    {
      "id": "CON-06-MUST-010",
      "type": "MUST",
      "statement": "算法原始结果与人工意见分开留痕，报告默认未复核，正式采用意见须中心专业人员审核且不变为自动裁决。",
      "sourceAnchors": [
        "3. 分析流程",
        "4. 输出与评分"
      ],
      "acceptanceScenarioIds": [
        "CON-06-AC-007"
      ]
    },
    {
      "id": "CON-06-MUST-011",
      "type": "MUST",
      "statement": "每个候选保存独立状态，单个失败不掩盖其他结果；修改输入创建新任务，失败对象可产生关联重试。",
      "sourceAnchors": [
        "5. 内部验证页面",
        "总目录/3.3 异步任务契约"
      ],
      "acceptanceScenarioIds": [
        "CON-06-AC-008"
      ]
    },
    {
      "id": "CON-06-MUST-012",
      "type": "MUST",
      "statement": "异步服务覆盖准备、创建、任务报告查询、人工复核和取消，重要材料不足返回不完整报告及未执行项而非完整成功。",
      "sourceAnchors": [
        "6. 服务契约与异常"
      ],
      "acceptanceScenarioIds": [
        "CON-06-AC-008"
      ]
    },
    {
      "id": "CON-06-MUST-013",
      "type": "MUST",
      "statement": "输入、原文、证据、报告和历史在后端实时鉴权，源撤回或权限收紧后禁止重新打开且不从缓存泄露。",
      "sourceAnchors": [
        "3. 分析流程",
        "5. 内部验证页面",
        "总目录/3.2 来源、版本和权限"
      ],
      "acceptanceScenarioIds": [
        "CON-06-AC-009"
      ]
    },
    {
      "id": "CON-06-MUST-016",
      "type": "MUST",
      "statement": "专家固定样本分别评估特征完整性、证据准确性和意见合理性，记录分母失败、全部输入模型规则版本，阈值试测确认。",
      "sourceAnchors": [
        "7. 验收要求",
        "8. 依赖与交付",
        "总目录/6. 验收资料与共同口径"
      ],
      "acceptanceScenarioIds": [
        "CON-06-AC-012"
      ]
    },
    {
      "id": "CON-06-MUST-017",
      "type": "MUST",
      "statement": "全文质量、外观视图图像能力、法律资源、复核人员、对象上限性能和环境未确认时相应能力保持待补齐。",
      "sourceAnchors": [
        "8. 依赖与交付"
      ],
      "acceptanceScenarioIds": [
        "CON-06-AC-012"
      ]
    }
  ],
  "inputs": [
    {
      "name": "analysisPurpose",
      "required": true,
      "rules": [
        "技术相似、新颖性辅助、权利要求对照或外观辅助"
      ]
    },
    {
      "name": "targetSnapshot",
      "required": true,
      "rules": [
        "技术方案或专利至少一项，侵权相关必须有实际产品方案"
      ]
    },
    {
      "name": "candidateVersions",
      "required": true,
      "rules": [
        "一个或多个具体文献版本"
      ]
    },
    {
      "name": "scope",
      "required": "法律问题时",
      "rules": [
        "相关日期、地域和依据版本"
      ]
    },
    {
      "name": "confirmedFeatures",
      "required": true,
      "rules": [
        "特征原文、层级依赖、定位和人工修订"
      ]
    },
    {
      "name": "idempotencyKey",
      "required": true,
      "rules": [
        "绑定调用方、目的和完整输入"
      ]
    }
  ],
