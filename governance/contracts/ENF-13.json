  "sourceAndVersionRules": [
    "规则固定模板、字段字典、案件证据分析结构、模型提示词和权限版本。",
    "直接值、确定性计算和辅助撰写分别标记并带来源。",
    "发布规则不可变，历史文书使用原规则模板。",
    "模板变化传播待复核，不自动套用旧映射。",
    "模拟字段输入模型数据库与真实验收隔离。"
  ],
  "errorsAndExceptions": [
    {
      "case": "source_path_missing",
