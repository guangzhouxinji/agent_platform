  "clauses": [
    {
      "id": "CON-05-MUST-001",
      "type": "MUST",
      "statement": "根据商标文字、图形或组合输入及确认的商品服务范围，从授权数据召回并排序候选，向 CON-07 传递固定输入。",
      "sourceAnchors": [
        "1. 功能概述",
        "2. 输入输出字段",
        "3. 检索流程与规则"
      ],
      "acceptanceScenarioIds": [
        "CON-05-AC-001"
      ]
    },
    {
      "id": "CON-05-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "候选相关度、高相关标签或无结果不得表述为法律近似结论、注册成功率或可以注册。",
      "sourceAnchors": [
        "1. 功能概述",
        "4. 评分规则"
      ],
      "acceptanceScenarioIds": [
        "CON-05-AC-001",
        "CON-05-AC-007"
      ]
    },
    {
      "id": "CON-05-MUST-002",
      "type": "MUST",
      "statement": "文字、读音、含义、图形和组合是可区分能力，仅执行实际具备并明确启用的维度，逐项记录是否执行。",
      "sourceAnchors": [
        "1. 功能概述",
        "2. 输入输出字段",
        "4. 评分规则"
      ],
      "acceptanceScenarioIds": [
        "CON-05-AC-002"
      ]
    },
    {
      "id": "CON-05-MUST_NOT-002",
      "type": "MUST_NOT",
      "statement": "图形能力缺失时不得用 OCR 文字查询、伪图形分数或组合分数冒充图形相似检索。",
      "sourceAnchors": [
        "1. 功能概述",
        "5. 内部验证页面"
      ],
      "acceptanceScenarioIds": [
        "CON-05-AC-002"
      ]
    },
    {
      "id": "CON-05-MUST-003",
      "type": "MUST",
      "statement": "文字检索保留原始字符和标准化值；图形检索保留原图；组合检索同时保存文字与图样及实际识别元素。",
      "sourceAnchors": [
        "2. 输入输出字段",
        "3. 检索流程与规则"
      ],
      "acceptanceScenarioIds": [
        "CON-05-AC-003"
      ]
    },
    {
      "id": "CON-05-MUST-004",
      "type": "MUST",
      "statement": "OCR、拼音、含义或分类建议有歧义时由用户修正并确认，修正不覆盖原文字或原图。",
      "sourceAnchors": [
        "3. 检索流程与规则"
      ],
      "acceptanceScenarioIds": [
        "CON-05-AC-003"
      ]
    },
    {
      "id": "CON-05-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "模型不得猜测商品服务项目、类似群、跨类别范围或把标准化结果写回原始输入。",
      "sourceAnchors": [
        "2. 输入输出字段",
        "3. 检索流程与规则",
        "总目录/3.5 评分及专业意见"
      ],
      "acceptanceScenarioIds": [
        "CON-05-AC-003",
        "CON-05-AC-004"
      ]
    },
    {
      "id": "CON-05-MUST-005",
      "type": "MUST",
      "statement": "检索前至少确认商品服务类别及项目；类似群和分类版本可建议但保持待确认，项目不明确时返回补充要求。",
      "sourceAnchors": [
        "2. 输入输出字段",
        "3. 检索流程与规则"
      ],
      "acceptanceScenarioIds": [
        "CON-05-AC-004"
      ]
    },
    {
      "id": "CON-05-MUST-006",
      "type": "MUST",
      "statement": "类别相同不等于商品服务类似；仅能检索同类别时披露未覆盖范围，跨类别扩展必须有确认规则或用户选择。",
      "sourceAnchors": [
        "3. 检索流程与规则"
      ],
      "acceptanceScenarioIds": [
        "CON-05-AC-004"
      ]
    },
    {
      "id": "CON-05-MUST-007",
      "type": "MUST",
      "statement": "状态过滤必须由用户明确选择，不得静默排除非有效记录；候选保存源状态和更新时间。",
      "sourceAnchors": [
        "2. 输入输出字段",
        "3. 检索流程与规则"
      ],
      "acceptanceScenarioIds": [
        "CON-05-AC-004"
      ]
    },
    {
      "id": "CON-05-MUST-008",
      "type": "MUST",
      "statement": "后端校验上传文件实际类型、大小、可解码性和 EXIF 方向，保留原图；首版 JPG/PNG、10 MB 上限作为可配置初值。",
      "sourceAnchors": [
        "3. 检索流程与规则",
        "总目录/3.6 默认值与未决条件"
      ],
      "acceptanceScenarioIds": [
        "CON-05-AC-005"
      ]
    },
    {
      "id": "CON-05-MUST-009",
      "type": "MUST",
      "statement": "上传图样及派生图像仅当前用户或授权调用方可访问，访问和历史任务由后端实时鉴权并按确认保留策略清理。",
      "sourceAnchors": [
        "3. 检索流程与规则",
        "6. 服务契约",
        "总目录/3.2 来源、版本和权限"
      ],
      "acceptanceScenarioIds": [
        "CON-05-AC-005",
        "CON-05-AC-010"
      ]
    },
    {
      "id": "CON-05-MUST-010",
      "type": "MUST",
      "statement": "使用中心接口或获授权索引按权限、类别、状态、地域和数据源范围召回，返回实际覆盖、返回数和截断情况。",
      "sourceAnchors": [
        "2. 输入输出字段",
        "3. 检索流程与规则"
      ],
      "acceptanceScenarioIds": [
        "CON-05-AC-006"
      ]
    },
    {
      "id": "CON-05-MUST_NOT-004",
      "type": "MUST_NOT",
      "statement": "有限候选重排不得宣称全库检索，上游失败或能力缺失不得伪装为无结果。",
      "sourceAnchors": [
        "3. 检索流程与规则",
        "5. 内部验证页面",
        "6. 服务契约"
      ],
      "acceptanceScenarioIds": [
        "CON-05-AC-006",
        "CON-05-AC-007"
      ]
    },
    {
      "id": "CON-05-MUST-011",
      "type": "MUST",
      "statement": "默认最多 100 条、每页 20 条并按相关度及稳定 ID 排序；默认值和性能范围须经中心能力与试测确认。",
      "sourceAnchors": [
        "3. 检索流程与规则",
        "总目录/3.6 默认值与未决条件"
      ],
      "acceptanceScenarioIds": [
        "CON-05-AC-006"
      ]
    },
    {
      "id": "CON-05-MUST-012",
      "type": "MUST",
      "statement": "文字、读音、含义和图形评分或等级分开；组合权重、缺失维度和分值映射版本化，未执行维度显示未分析而非零。",
      "sourceAnchors": [
        "4. 评分规则"
      ],
      "acceptanceScenarioIds": [
        "CON-05-AC-007"
      ]
    },
    {
      "id": "CON-05-MUST_NOT-005",
      "type": "MUST_NOT",
      "statement": "无可靠标定不得编造 0—100 分、精确概率或用模型自评分替代检索指标和专家评测。",
      "sourceAnchors": [
        "4. 评分规则",
        "总目录/3.5 评分及专业意见"
      ],
      "acceptanceScenarioIds": [
        "CON-05-AC-007",
        "CON-05-AC-009"
      ]
    },
    {
      "id": "CON-05-MUST-013",
      "type": "MUST",
      "statement": "异步服务覆盖图样上传、输入解析、创建任务、查询结果和取消，并遵守排队、处理中、成功、部分成功、失败、取消及幂等恢复规则。",
      "sourceAnchors": [
        "6. 服务契约",
        "总目录/3.3 异步任务契约"
      ],
      "acceptanceScenarioIds": [
        "CON-05-AC-008"
      ]
    },
    {
      "id": "CON-05-MUST-014",
      "type": "MUST",
      "statement": "无效上传、维度不可用、分类缺失、权限、限流、超时、源故障和无结果返回不同错误或状态及追踪号。",
      "sourceAnchors": [
        "5. 内部验证页面",
        "6. 服务契约"
      ],
      "acceptanceScenarioIds": [
        "CON-05-AC-008"
      ]
    },
    {
      "id": "CON-05-MUST-016",
      "type": "MUST",
      "statement": "选定候选和目标原始/确认输入、分类、范围、检索维度、评分版本及来源快照完整传递给 CON-07。",
      "sourceAnchors": [
        "2. 输入输出字段",
        "3. 检索流程与规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "CON-05-AC-012"
      ]
    },
    {
      "id": "CON-05-MUST-018",
      "type": "MUST",
      "statement": "使用中心参与标注的固定样本分别评估文字和图形 Recall@K，记录分母失败、数据、分类、检索、评分与模型版本，阈值试测后确认。",
      "sourceAnchors": [
        "7. 验收要求",
        "8. 依赖与交付",
        "总目录/6. 验收资料与共同口径"
      ],
      "acceptanceScenarioIds": [
        "CON-05-AC-009",
        "CON-05-AC-014"
      ]
    },
    {
      "id": "CON-05-MUST-019",
      "type": "MUST",
      "statement": "图样授权、分类版本、跨类规则、图像能力、缓存权限、并发性能和国产环境未确认时对应能力保持待补齐，不升级为真实验收。",
      "sourceAnchors": [
        "8. 依赖与交付",
        "总目录/7. 评审状态记录"
      ],
      "acceptanceScenarioIds": [
        "CON-05-AC-014"
      ]
    }
  ],
  "inputs": [
    {
      "name": "target",
      "required": true,
      "rules": [
        "文字、受控原图或组合；原始值与确认标准化值分开"
      ]
    },
    {
      "name": "classification",
      "required": true,
      "rules": [
        "至少确认类别和商品服务项目，类似群及版本可待确认"
      ]
    },
    {
      "name": "dimensions",
      "required": true,
      "rules": [
        "仅选择实际可用的文字、读音、含义、图形或组合"
      ]
    },
    {
      "name": "scope",
      "required": true,
      "rules": [
        "类别、跨类、状态、地域和数据源范围明确"
      ]
    },
    {
      "name": "idempotencyKey",
      "required": true,
      "rules": [
        "绑定用户调用方、固定输入和操作"
      ]
    }
  ],
  "outputs": [
    {
      "name": "inputPreview",
      "fields": [
        "originalText",
        "normalizedText",
        "originalImageRef",
        "recognizedElements",
        "pronunciationCandidates",
        "classificationSuggestions",
        "confirmationState"
      ]
    },
    {
      "name": "searchTask",
      "fields": [
        "taskId",
        "status",
        "requestId",
        "inputManifest",
        "actualScope",
        "failedDimensions"
      ]
    },
    {
      "name": "candidate",
      "fields": [
        "sourceId",
        "trademarkId",
        "registrationNumber",
        "name",
        "imageRef",
        "classes",
        "items",
        "sourceStatus",
        "sourceUpdatedAt",
        "dimensionScoresOrLabels",
        "rankingVersion",
        "matchReasons"
      ]
    },
    {
      "name": "handoffSnapshot",
      "fields": [
        "targetSnapshot",
        "selectedCandidates",
        "classification",
        "scope",
        "dimensions",
        "sourceVersions",
        "scoreVersion"
      ]
    }
  ],
  "permissions": [
    {
      "action": "upload_or_parse",
      "enforcement": "用户身份、文件访问、模型通道和数据出域权限"
    },
    {
      "action": "search",
      "enforcement": "检索前过滤商标数据源、图样、类别地域和状态范围"
    },
    {
      "action": "read_candidate_or_task",
      "enforcement": "当前商标、图样、历史任务和来源权限"
    },
    {
      "action": "handoff_to_comparison",
      "enforcement": "目标及候选仍可访问且由调用方明确选择"
    }
  ],
  "states": [
    {
      "name": "排队",
      "kind": "task",
      "allowedNext": [
        "处理中",
        "失败",
        "取消"
      ]
    },
    {
      "name": "处理中",
      "kind": "task",
      "allowedNext": [
        "成功",
        "部分成功",
        "失败",
        "取消"
      ]
    },
    {
      "name": "成功",
      "kind": "task",
      "allowedNext": []
    },
    {
      "name": "部分成功",
      "kind": "task",
      "allowedNext": [],
      "invariant": "列出未完成维度、来源和覆盖"
    },
    {
      "name": "失败",
      "kind": "task",
      "allowedNext": []
    },
    {
      "name": "取消",
      "kind": "task",
      "allowedNext": []
    },
    {
