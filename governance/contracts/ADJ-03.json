  "clauses": [
    {
      "id": "ADJ-03-MUST-001",
      "type": "MUST",
      "statement": "统一承接既有外部一次性要点生成导入、关联校验、维护和完整列表；要点关联法规、条文及 ADJ-02 来源解析的具体版本。",
      "sourceAnchors": [
        "1. 功能概述",
        "2. 字段与内容约束",
        "既有/1. 功能概述",
        "既有/2. 数据来源与导入"
      ],
      "acceptanceScenarioIds": [
        "ADJ-03-AC-001"
      ]
    },
    {
      "id": "ADJ-03-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "要点不是法规原文或正式法律引用，不得仅凭要点内容生成正式依据；正式引用必须回到具体条文版本。",
      "sourceAnchors": [
        "1. 功能概述"
      ],
      "acceptanceScenarioIds": [
        "ADJ-03-AC-001"
      ]
    },
    {
      "id": "ADJ-03-MUST-002",
      "type": "MUST",
      "statement": "要点唯一编号编辑不变，版本保存来源解析、法规条文、内容类别、程序场景、案例版本、提取与导入主体时间及变更原因。",
      "sourceAnchors": [
        "2. 字段与内容约束",
        "既有/3. 条文要点信息管理"
      ],
      "acceptanceScenarioIds": [
        "ADJ-03-AC-002"
      ]
    },
    {
      "id": "ADJ-03-MUST-003",
      "type": "MUST",
      "statement": "导入逐项校验必填、编号重复、来源解析、法规条文关系、类别字典、场景、案例和日期并返回成功失败及原因。",
      "sourceAnchors": [
        "3. 导入与维护规则",
        "既有/2.2 导入校验"
      ],
      "acceptanceScenarioIds": [
        "ADJ-03-AC-002"
      ]
    },
    {
      "id": "ADJ-03-MUST-004",
      "type": "MUST",
      "statement": "仅来源为已审核且一致的解析、原文支持充分并经校核的要点可标可用；否则待核实。",
      "sourceAnchors": [
        "2. 字段与内容约束",
        "3. 导入与维护规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-03-AC-003"
      ]
    },
    {
      "id": "ADJ-03-MUST_NOT-002",
      "type": "MUST_NOT",
      "statement": "未审核、来源已变更、缺原文支持、停用或越权要点不得作为当前已校核知识进入检索、匹配或报告。",
      "sourceAnchors": [
        "2. 字段与内容约束",
        "3. 导入与维护规则",
        "5. 服务契约"
      ],
      "acceptanceScenarioIds": [
        "ADJ-03-AC-003"
      ]
    },
    {
      "id": "ADJ-03-MUST-005",
      "type": "MUST",
      "statement": "处罚标准要点仅在来源存在且程序匹配时展示，不得因含处罚内容自动用于行政裁决报告。",
      "sourceAnchors": [
        "2. 字段与内容约束"
      ],
      "acceptanceScenarioIds": [
        "ADJ-03-AC-004"
      ]
    },
    {
      "id": "ADJ-03-MUST-006",
      "type": "MUST",
      "statement": "重复导入可跳过、更新草稿或创建新版本；已引用版本不得覆盖，改变来源条文须新版本重新校验。",
      "sourceAnchors": [
        "3. 导入与维护规则",
        "既有/2.2 导入校验",
        "既有/3.2 信息维护"
      ],
      "acceptanceScenarioIds": [
        "ADJ-03-AC-005"
      ]
    },
    {
      "id": "ADJ-03-MUST-007",
      "type": "MUST",
      "statement": "来源解析或法规变化标记待核实并保留历史引用；人工停用保留历史，外部更新不得无确认自动启用。",
      "sourceAnchors": [
        "3. 导入与维护规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-03-AC-005"
      ]
    },
    {
      "id": "ADJ-03-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "事实或关联缺失不得由模型推测补齐，外部故障不得写成空结果或成功。",
      "sourceAnchors": [
        "前言",
        "5. 服务契约"
      ],
      "acceptanceScenarioIds": [
        "ADJ-03-AC-006"
      ]
    },
    {
      "id": "ADJ-03-MUST-011",
      "type": "MUST",
      "statement": "中心确认类别场景程序字典、校核人员、外部生成通道、规模和专业样例，未确认不升级验收。",
      "sourceAnchors": [
        "7. 验收要求",
        "8. 依赖与交付"
      ],
      "acceptanceScenarioIds": [
        "ADJ-03-AC-008"
      ]
    }
  ],
  "inputs": [
    {
      "name": "keyPointBatch",
      "required": true,
      "rules": [
        "要点、法规条文版本、来源解析版本、类别场景案例及幂等键"
      ]
    },
    {
      "name": "maintenanceAction",
      "required": "编辑校核停用时",
      "rules": [
        "当前版本、动作、变更原因和可信身份"
      ]
    },
    {
      "name": "sourceChange",
      "required": "来源变化时",
      "rules": [
        "稳定来源 ID、旧新版本和事件"
      ]
    }
  ],
  "outputs": [
    {
      "name": "keyPointVersion",
      "fields": [
        "keyPointId",
        "version",
        "regulationVersion",
        "articleId",
        "analysisVersion",
        "content",
        "category",
        "procedureScope",
        "scenarios",
        "cases",
        "availability",
        "audit"
      ]
    },
    {
      "name": "batchResult",
      "fields": [
        "successCount",
        "failureCount",
        "itemResults",
        "errors",
        "requestId"
      ]
    },
    {
      "name": "sourceImpact",
      "fields": [
        "affectedVersions",
        "newStatuses",
        "historicalReferences"
      ]
    }
  ],
  "permissions": [
    {
      "action": "import",
      "enforcement": "来源解析、字典和机构权限"
    },
    {
      "action": "edit_or_calibrate",
      "enforcement": "维护校核角色和当前版本"
    },
    {
      "action": "disable",
      "enforcement": "授权停用角色和原因"
    },
    {
      "action": "consume",
      "enforcement": "运行时仅返回范围内可用要点"
    }
  ],
  "states": [
    {
      "name": "待核实",
      "kind": "availability",
      "allowedNext": [
        "可用",
        "停用"
      ]
    },
    {
      "name": "可用",
      "kind": "availability",
      "allowedNext": [
        "来源已变更",
        "停用"
      ]
    },
    {
      "name": "来源已变更",
      "kind": "availability",
      "allowedNext": [
        "停用"
      ],
      "invariant": "不得作为当前可用知识"
    },
    {
      "name": "停用",
      "kind": "availability",
      "allowedNext": [],
      "invariant": "外部导入不得自动启用"
    }
  ],
  "sourceAndVersionRules": [
    "要点、来源解析、法规条文和案例均固定稳定 ID 与版本。",
    "要点是派生知识，不替代原文引用。",
    "已引用版本和人工停用状态不可破坏性覆盖。",
    "来源变化保留旧版并传播待核实。"
  ],
  "errorsAndExceptions": [
    {
      "case": "missing_or_invalid_relation",
      "result": "逐项失败并说明法规条文解析案例差异"
    },
    {
      "case": "source_not_approved_or_changed",
      "result": "保存为待核实且不进入当前消费"
    },
    {
      "case": "procedure_mismatch",
      "result": "过滤并阻止处罚要点误用"
    },
    {
      "case": "duplicate",
      "result": "按确认策略跳过、草稿更新或新版本"
    },
    {
      "case": "version_conflict",
      "result": "拒绝覆盖"
    },
    {
      "case": "unauthorized",
      "result": "拒绝且不泄露要点来源"
    }
  ],
