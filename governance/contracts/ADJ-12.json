    },
    {
      "id": "ADJ-12-MUST-012",
      "type": "MUST",
      "statement": "复核通过只形成可进入正式办理流程的锁定版本；复核状态、案件办结、签发、签章、正式文件、送达和执行状态相互分离。",
      "sourceAnchors": [
        "1. 功能概述",
