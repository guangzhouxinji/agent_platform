  "inputs": [
    {
      "name": "caseSnapshot",
      "required": true,
      "rules": [
        "中心案件 ID、事件材料延期中止和固定版本"
      ]
    },
    {
      "name": "validationScope",
      "required": true,
      "rules": [
        "地区、程序、环节和适用时间"
      ]
    },
    {
      "name": "remediationRecord",
      "required": "整改时",
      "rules": [
        "报告版本、说明、证据、人员和时间"
      ]
    },
    {
      "name": "idempotencyKey",
      "required": true,
      "rules": [
        "绑定案件快照、规则范围和操作"
      ]
    }
  ],
