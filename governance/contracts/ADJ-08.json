  "clauses": [
    {
      "id": "ADJ-08-MUST-001",
      "type": "MUST",
      "statement": "分别输出指定时点可核实的官方法律状态及权利基础资料，以及基于明确有限材料的新颖性和创造性风险分析。",
      "sourceAnchors": [
        "1. 功能概述与分析边界",
        "2. 字段与输入"
      ],
      "acceptanceScenarioIds": [
        "ADJ-08-AC-001"
      ]
    },
    {
      "id": "ADJ-08-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "无效请求不得冒充无效决定，技术风险不得改写官方状态，本模块不得作无效宣告或替代有权机关程序。",
      "sourceAnchors": [
        "1. 功能概述与分析边界"
      ],
      "acceptanceScenarioIds": [
        "ADJ-08-AC-001"
      ]
    },
    {
      "id": "ADJ-08-MUST-002",
      "type": "MUST",
      "statement": "固定案件资料、ADJ-07 解析、所选权利要求、分析目的、相关时点地域及状态缴费无效事件来源版本；不能仅比较摘要。",
      "sourceAnchors": [
        "2. 字段与输入",
        "3. 分析流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-08-AC-002"
      ]
    },
    {
      "id": "ADJ-08-MUST-003",
      "type": "MUST",
      "statement": "来源时间、事件时间和获取时间分开并显示冲突；当前状态不能自动回答历史时点，无历史资料返回无法核实。",
      "sourceAnchors": [
        "2. 字段与输入",
        "3. 分析流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-08-AC-002"
      ]
    },
    {
      "id": "ADJ-08-MUST_NOT-002",
      "type": "MUST_NOT",
      "statement": "缺缴费记录不得推断权利终止，官方状态冲突不得由模型改写，API 超时不得返回未发生无效或已有效。",
      "sourceAnchors": [
        "3. 分析流程与规则",
        "5. 服务契约"
      ],
      "acceptanceScenarioIds": [
        "ADJ-08-AC-003"
      ]
    },
    {
      "id": "ADJ-08-MUST-004",
      "type": "MUST",
      "statement": "对比文献逐项保存公开日期、来源和与相关日期关系；日期不能核实时不得作为已确认现有技术，检索范围和未覆盖文献类型必须披露。",
      "sourceAnchors": [
        "2. 字段与输入",
        "3. 分析流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-08-AC-004"
      ]
    },
    {
      "id": "ADJ-08-MUST-005",
      "type": "MUST",
      "statement": "新颖性按单篇文献逐全部必要要素对照，不把多篇拼接覆盖冒充单篇公开。",
      "sourceAnchors": [
        "3. 分析流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-08-AC-005"
      ]
    },
    {
      "id": "ADJ-08-MUST-006",
      "type": "MUST",
      "statement": "创造性列出比较基础、区别特征、技术问题、组合启示及来源；缺组合依据明确不足，语义相似不替代分析。",
      "sourceAnchors": [
        "3. 分析流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-08-AC-005"
      ]
    },
    {
      "id": "ADJ-08-MUST-007",
      "type": "MUST",
      "statement": "每栏分别标完成、资料不足或失败；状态成功而技术分析失败可为部分成功，但未分析失败不得折算成有效或低风险。",
      "sourceAnchors": [
        "4. 内部验证页面",
        "5. 服务契约"
      ],
      "acceptanceScenarioIds": [
        "ADJ-08-AC-006"
      ]
    },
    {
      "id": "ADJ-08-MUST-008",
      "type": "MUST",
      "statement": "外观设计采用经确认的独立评价流程和依据，能力须单独确认验收，不套用发明实用新型模板。",
      "sourceAnchors": [
        "3. 分析流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-08-AC-006"
      ]
    },
    {
      "id": "ADJ-08-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "分析或复核不得自动改变案件流程、启动无效程序，未授权材料不得进入模型上下文。",
      "sourceAnchors": [
        "3. 分析流程与规则",
        "5. 服务契约"
      ],
      "acceptanceScenarioIds": [
        "ADJ-08-AC-007"
      ]
    },
    {
      "id": "ADJ-08-MUST-012",
      "type": "MUST",
      "statement": "中心确认历史状态覆盖、对比资料来源、各专利类型能力、评价口径和专家样本，未确认分支不得标通过。",
      "sourceAnchors": [
        "7. 验收要求",
        "8. 依赖与交付"
      ],
      "acceptanceScenarioIds": [
        "ADJ-08-AC-010"
      ]
    }
  ],
  "inputs": [
    {
      "name": "verificationRequest",
      "required": true,
      "rules": [
        "案件、专利解析、权利要求、目的、时点、地域和幂等键"
