    {
      "id": "ENF-13-DD-001",
      "decision": "Document Rule 领域拥有字段映射版本，Authority/Evidence/Analysis 提供来源，Model 仅执行允许段落；Agent 仅编排。",
      "basis": "ARC-03",
      "changesBusinessMeaning": false
    },
    {
      "id": "ENF-13-DD-002",
      "decision": "字段级来源和段落级来源统一进入可信链，完整性状态独立于生成任务。",
      "basis": "原文来源与缺失要求。",
      "changesBusinessMeaning": false
    },
    {
      "id": "ENF-13-DD-003",
      "decision": "具体 API、字段路径语法、转换、模型角色和 DM8 类型延后至 D 门禁。；仅在后续纳入该能力的 Task 中按已获证据确定，当前 V0/合成范围保持可替换并显式披露能力缺口",
      "basis": "中心字段映射模型环境未确认。",
      "changesBusinessMeaning": false
    }
