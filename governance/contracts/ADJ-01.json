      ]
    },
    {
      "id": "ADJ-01-MUST_NOT-007",
      "type": "MUST_NOT",
      "statement": "不得仅凭日期自动认定法规适用于案件，业务人员仍需核实过渡条款、地域、用途和案件时间。",
      "sourceAnchors": [
        "3. 接入与维护流程",
        "7. 验收要求",
        "总览/4. 行政裁决业务边界"
      ],
      "acceptanceScenarioIds": [
        "ADJ-01-AC-005"
      ]
    },
    {
      "id": "ADJ-01-MUST-014",
      "type": "MUST",
      "statement": "修订记录按修订日期倒序，支持新增、编辑和错误记录处理；已被引用的错误记录只能撤回并留痕。",
      "sourceAnchors": [
        "3. 接入与维护流程",
        "既有/5.3 修订记录弹窗",
        "总览/3. 与已有法规需求的衔接"
      ],
      "acceptanceScenarioIds": [
        "ADJ-01-AC-006"
      ]
    },
    {
      "id": "ADJ-01-MUST_NOT-008",
      "type": "MUST_NOT",
      "statement": "已引用法规或修订记录不得物理删除，撤回不得破坏历史引用链。",
      "sourceAnchors": [
        "3. 接入与维护流程",
        "7. 验收要求",
        "总览/3. 与已有法规需求的衔接"
      ],
      "acceptanceScenarioIds": [
        "ADJ-01-AC-006"
      ]
    },
    {
      "id": "ADJ-01-MUST-015",
      "type": "MUST",
      "statement": "修订时原文保持本次修订前全文语义并明确所属旧版本；当前正文修改不改变历史快照，多版本或编号歧义返回候选供确认。",
      "sourceAnchors": [
        "3. 接入与维护流程",
        "既有/5.4 修订时原文查看"
      ],
