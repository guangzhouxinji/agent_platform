  "clauses": [
    {
      "id": "ADJ-07-MUST-001",
      "type": "MUST",
      "statement": "复用授权专利库和文献解析能力，增加案件绑定、文献及权利要求选择、原文定位、人工修订和可供下游选择的解析版本。",
      "sourceAnchors": [
        "1. 功能概述",
        "3. 解析流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-07-AC-001"
      ]
    },
    {
      "id": "ADJ-07-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "技术特征提取不得冒充最终权利保护范围，保护期限来源信息不得冒充专利始终或当前有效。",
      "sourceAnchors": [
        "1. 功能概述"
      ],
      "acceptanceScenarioIds": [
        "ADJ-07-AC-001"
      ]
    },
    {
      "id": "ADJ-07-MUST-002",
      "type": "MUST",
      "statement": "申请号、公开号、授权公告号和文献版本分开保存并校验材料归属；缺失字段不推测，标题不是唯一定位依据。",
      "sourceAnchors": [
        "2. 输入输出字段",
        "3. 解析流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-07-AC-002"
      ]
    },
    {
      "id": "ADJ-07-MUST-003",
      "type": "MUST",
      "statement": "保留权利要求书、说明书、附图的页码段落权项附图定位，OCR 质量、不可读页和未处理内容可见。",
      "sourceAnchors": [
        "2. 输入输出字段",
        "3. 解析流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-07-AC-003"
      ]
    },
    {
      "id": "ADJ-07-MUST_NOT-002",
      "type": "MUST_NOT",
      "statement": "权利要求无法读取时不得用摘要替代，也不得把说明书任意细节自动增加为权利要求限定。",
      "sourceAnchors": [
        "3. 解析流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-07-AC-003"
      ]
    },
    {
      "id": "ADJ-07-MUST-004",
      "type": "MUST",
      "statement": "提取独立从属关系并展开所选从属项实际引用链，逐项特征保留限定关系、必要上下文及说明书支持位置。",
      "sourceAnchors": [
        "2. 输入输出字段",
        "3. 解析流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-07-AC-004"
      ]
    },
    {
      "id": "ADJ-07-MUST-005",
      "type": "MUST",
      "statement": "人工修订特征、依赖和定位生成确认新版本，机器原始结果、人工版本、人员时间和原因分开。",
      "sourceAnchors": [
        "2. 输入输出字段",
        "3. 解析流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-07-AC-005"
      ]
    },
    {
      "id": "ADJ-07-MUST-006",
      "type": "MUST",
      "statement": "材料或权利要求变化新建解析并标旧结果来源已变更，不替换下游历史输入。",
      "sourceAnchors": [
        "3. 解析流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-07-AC-005"
      ]
    },
    {
      "id": "ADJ-07-MUST-007",
      "type": "MUST",
      "statement": "外观设计采用视图、产品名称和简要说明的独立分支，不生成文本权利要求或套用发明特征矩阵。",
      "sourceAnchors": [
        "3. 解析流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-07-AC-006"
      ]
    },
    {
      "id": "ADJ-07-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "哈希只证明完整性，不证明真实性；禁止任意服务器路径读取或执行文件内容指令。",
      "sourceAnchors": [
        "5. 服务契约"
      ],
      "acceptanceScenarioIds": [
        "ADJ-07-AC-007"
      ]
    },
    {
      "id": "ADJ-07-MUST-011",
      "type": "MUST",
      "statement": "中心确认文献覆盖、文件限制、外观能力、模型程序和专家基准，未确认能力不得标通过。",
      "sourceAnchors": [
        "7. 验收要求",
        "8. 依赖与交付"
      ],
      "acceptanceScenarioIds": [
        "ADJ-07-AC-010"
      ]
    },
    {
      "id": "ADJ-07-SEM-MUST-001",
      "type": "MUST",
      "statement": "本能力参与智能体任务时，一次工具执行成功、局部输出、通知或审核动作不直接认定整个用户业务目标完成；跨轮对象绑定稳定版本，纠正保留原目标与历史并重核依赖结果；人工接收须有实际记录，业务、任务、审核、正式状态分别表达。",
      "sourceAnchors": [
        "docs/02-待确认事项清单.md#23",
        "docs/01-总体需求与架构方案.md#5"
      ],
      "acceptanceScenarioIds": [
        "ADJ-07-SEM-AC-001"
      ]
    }
  ],
  "inputs": [
    {
      "name": "materialRequest",
      "required": true,
      "rules": [
        "专利号码类型或受控文件、文献版本、案件权限"
      ]
    },
    {
      "name": "parseRequest",
      "required": true,
      "rules": [
        "固定文献、所选权利要求、解析配置和幂等键"
      ]
