  "sourceAndVersionRules": [
    "规则版本固定程序环节、地区机构、公式、例外、依据、有效期和工作日历版本。",
    "事件时间、计算时间和配置发布时间分别保存。",
    "相同输入、规则与日历版本必须产生相同轨迹和结果。",
    "发布版本不可变，历史计算引用原规则与日历。",
    "时点筛选候选与人工确认历史适用性分开。",
    "模拟规则日历数据库与真实验收证据隔离。"
  ],
  "errorsAndExceptions": [
    {
      "case": "start_event_or_calendar_missing",
      "result": "阻止发布或试算并列出缺口"
    },
    {
      "case": "overlapping_rule_conflict",
      "result": "阻止发布并列出冲突规则和范围"
    },
    {
      "case": "basis_expired_or_unavailable",
      "result": "阻止新发布或标记现有规则待复核"
    },
    {
      "case": "rule_not_applicable",
      "result": "返回地区、机构、程序或时点不匹配"
    },
    {
      "case": "historical_version_ambiguous",
      "result": "返回候选版本待人工确认，不默认现行规则"
    },
    {
      "case": "unauthorized",
      "result": "拒绝且不泄露规则、案件事件或日历"
    }
  ],
