    {
      "id": "ADJ-01-MUST-012",
      "type": "MUST",
      "statement": "人工编辑保留修改前值、修改后值、理由、真实人员、时间及来源差异；来源冲突标记待核实。",
      "sourceAnchors": [
        "3. 接入与维护流程"
      ],
      "acceptanceScenarioIds": [
        "ADJ-01-AC-004"
      ]
    },
    {
      "id": "ADJ-01-MUST_NOT-006",
      "type": "MUST_NOT",
      "statement": "待核实的本地校核内容不得自动确认为裁决依据。",
      "sourceAnchors": [
