      "id": "ADJ-12-MUST-011",
      "type": "MUST",
      "statement": "已通过版本发生实质修改或其证据、法规、事实等依赖变化时转为待复核或已失效，旧批准不得用于签发新内容。",
      "sourceAnchors": [
        "3. 审核流程与规则",
        "总览/5. 数据、版本与变更规则"
      ],
      "acceptanceScenarioIds": [
