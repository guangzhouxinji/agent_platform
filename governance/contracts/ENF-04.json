  "clauses": [
    {
      "id": "ENF-04-MUST-001",
      "type": "MUST",
      "statement": "从有权访问的固定线索原文版本中提取疑似主体、事实、时间、地点和证据引用，并给出分类及优先级建议。",
      "sourceAnchors": [
        "1. 功能概述与交付范围",
        "2. 数据来源与依赖"
      ],
      "acceptanceScenarioIds": [
        "ENF-04-AC-001",
        "ENF-04-AC-004"
      ]
    },
    {
      "id": "ENF-04-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "解析输出不得表述为违法主体认定、违法成立、正式优先处置决定或其他正式执法结论。",
      "sourceAnchors": [
        "1. 功能概述与交付范围",
        "4. 功能与处理规则",
        "总览/5. 审核与版本通用要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-04-AC-003",
        "ENF-04-AC-005"
      ]
    },
    {
      "id": "ENF-04-MUST-003",
      "type": "MUST",
      "statement": "解析前校验线索编号、输入版本、关联关系、机构和当前访问权限；源数据缺失与接口调用失败分开记录。",
      "sourceAnchors": [
        "2. 数据来源与依赖"
      ],
      "acceptanceScenarioIds": [
        "ENF-04-AC-007"
      ]
    },
    {
      "id": "ENF-04-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "来源、源版本、原文事实和缺失信息不得由模型生成、替换或为了满足字段而编造。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "4. 功能与处理规则",
        "总览/4. 信息字段说明"
      ],
      "acceptanceScenarioIds": [
        "ENF-04-AC-001",
        "ENF-04-AC-007"
      ]
    },
    {
      "id": "ENF-04-MUST-004",
      "type": "MUST",
      "statement": "主体核验仅在中心提供并授权企业主体查询 API 时执行，核验结果保留来源、版本和时间。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "8. 联调前需确认的条件"
      ],
      "acceptanceScenarioIds": [
        "ENF-04-AC-002",
        "ENF-04-AC-011"
      ]
    },
    {
      "id": "ENF-04-MUST-005",
      "type": "MUST",
      "statement": "每个抽取字段保留输入原文片段以及页码、字段路径或等效稳定定位；无法确定时字段留空并列出缺失项。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-04-AC-001"
      ]
    },
    {
      "id": "ENF-04-MUST-006",
      "type": "MUST",
      "statement": "主体候选支持多个并区分投诉人、经营者、权利人等原文角色，提示授权人员核实。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-04-AC-002"
      ]
    },
    {
      "id": "ENF-04-MUST_NOT-004",
      "type": "MUST_NOT",
      "statement": "不得把原文提及主体直接认定为违法主体，也不得把不同角色合并为一个无角色主体。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-04-AC-002"
      ]
    },
    {
      "id": "ENF-04-MUST-007",
      "type": "MUST",
      "statement": "统一社会信用代码仅来自输入原文或有来源的主体核验结果；未提供或未核实时保持为空。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-04-AC-002"
      ]
    },
    {
      "id": "ENF-04-MUST_NOT-005",
      "type": "MUST_NOT",
      "statement": "不得根据主体名称、地址或其他线索推算、生成或猜测统一社会信用代码。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-04-AC-002"
      ]
    },
    {
      "id": "ENF-04-MUST-008",
      "type": "MUST",
      "statement": "发生时间同时保留原始表述和标准化值，地点同时保留原文和标准化地址；标准化失败不覆盖原值。",
      "sourceAnchors": [
        "3. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "ENF-04-AC-001"
      ]
    },
    {
      "id": "ENF-04-MUST-009",
      "type": "MUST",
      "statement": "关联证据仅记录真实材料编号或明确的待接入引用，不得将无来源描述伪装成已接入证据。",
      "sourceAnchors": [
        "3. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "ENF-04-AC-004"
      ]
    },
    {
      "id": "ENF-04-MUST-010",
      "type": "MUST",
      "statement": "优先级只能依据中心确认的因素和规则计算，并输出高、中、低或待评估以及可追溯理由。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则",
        "8. 联调前需确认的条件"
      ],
      "acceptanceScenarioIds": [
        "ENF-04-AC-003",
        "ENF-04-AC-011"
      ]
    },
    {
      "id": "ENF-04-MUST_NOT-006",
      "type": "MUST_NOT",
      "statement": "缺少必要优先级因素时不得猜测高、中、低，优先级或模型分值不得表示违法成立概率。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-04-AC-003"
      ]
    },
    {
      "id": "ENF-04-MUST-012",
      "type": "MUST",
      "statement": "审核状态为待审核、已确认和退回；授权人员可以修订、确认或退回，所有动作保留前后值、人员、时间和理由。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则",
        "5. 服务接口需求"
      ],
      "acceptanceScenarioIds": [
        "ENF-04-AC-005"
      ]
    },
    {
      "id": "ENF-04-MUST-013",
      "type": "MUST",
      "statement": "重新解析创建新的机器结果版本并关联原结果，不覆盖已人工修订或确认版本。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求",
        "总览/5. 审核与版本通用要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-04-AC-006"
      ]
    },
    {
      "id": "ENF-04-MUST_NOT-007",
      "type": "MUST_NOT",
      "statement": "模型重跑不得改变人工确认结果、审核记录或历史引用。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "总览/5. 审核与版本通用要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-04-AC-006"
      ]
    },
    {
      "id": "ENF-04-MUST_NOT-008",
      "type": "MUST_NOT",
      "statement": "部分解析不得伪装完整成功，源接口失败不得伪装字段为空或规则不适用。",
      "sourceAnchors": [
        "5. 服务接口需求",
        "总览/3. 通用接口约定",
        "总览/5. 审核与版本通用要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-04-AC-007"
      ]
    },
    {
      "id": "ENF-04-MUST-018",
      "type": "MUST",
      "statement": "模型效果使用中心专家标注的独立样本集评测，记录样本量、输入和模型版本、字段级指标、来源定位正确性、缺失处理及复核结果。",
      "sourceAnchors": [
        "7. 验收要求",
        "总览/9. 验收组织"
      ],
      "acceptanceScenarioIds": [
        "ENF-04-AC-010"
      ]
    },
    {
      "id": "ENF-04-MUST_NOT-009",
      "type": "MUST_NOT",
      "statement": "模型置信度、自评分、静态演示或模拟结果不得作为解析准确率或真实业务验收。",
      "sourceAnchors": [
        "7. 验收要求",
        "8. 联调前需确认的条件",
        "总览/6. 内部前端通用要求",
        "总览/9. 验收组织"
      ],
      "acceptanceScenarioIds": [
        "ENF-04-AC-010",
        "ENF-04-AC-011"
      ]
    },
    {
      "id": "ENF-04-MUST-020",
      "type": "MUST",
      "statement": "未确认优先级因素和主体核验接口时允许显式模拟的可逆开发，但相关能力保持未联调或待确认状态。",
      "sourceAnchors": [
        "8. 联调前需确认的条件"
      ],
      "acceptanceScenarioIds": [
        "ENF-04-AC-011"
      ]
    }
  ],
  "inputs": [
    {
      "name": "clueReference",
      "required": true,
      "rules": [
        "有权限的线索稳定编号和固定输入版本"
      ]
    },
    {
      "name": "parseConfiguration",
      "required": true,
      "rules": [
        "固定模型、规则和字段版本"
      ]
    },
    {
      "name": "idempotencyKey",
      "required": true,
      "rules": [
        "绑定主体、操作和输入"
      ]
    },
    {
      "name": "humanRevision",
      "required": "修订或审核时",
      "rules": [
        "预期结果版本、字段前后值、理由和可信身份"
      ]
    }
  ],
  "outputs": [
    {
      "name": "parseTask",
      "fields": [
        "taskId",
        "status",
        "requestId",
        "inputVersion",
        "parseVersion",
        "attempts",
        "unprocessedItems"
      ]
    },
    {
      "name": "candidateSubject",
      "fields": [
        "name",
        "role",
        "creditCode",
        "sourceAnchor",
        "verificationStatus",
        "verificationSource"
      ]
    },
    {
      "name": "extractedFact",
      "fields": [
        "value",
        "rawValue",
        "normalizedValue",
        "sourceFragment",
        "pageOrFieldPath",
        "missingReason"
      ]
    },
    {
      "name": "prioritySuggestion",
      "fields": [
        "levelOrPending",
        "factors",
        "reason",
        "ruleVersion",
        "notLegalProbability"
      ]
    },
    {
      "name": "reviewedResult",
      "fields": [
        "resultId",
        "version",
        "reviewStatus",
        "machineVersion",
        "revisions",
        "reviewer",
        "reviewedAt"
      ]
    }
  ],
  "permissions": [
    {
      "action": "submit_parse",
      "enforcement": "校验机构、线索和固定输入版本访问权限"
    },
    {
      "action": "read_result_or_source",
      "enforcement": "每次读取重新检查线索、来源和结果权限"
    },
    {
      "action": "revise",
      "enforcement": "授权业务人员及预期版本校验"
    },
    {
      "action": "confirm_or_return",
      "enforcement": "中心授权审核角色，不能由模型或 Agent 触发"
    },
    {
      "action": "verify_subject",
      "enforcement": "仅调用中心批准主体接口且遵守数据范围"
    }
  ],
  "states": [
    {
      "name": "queued",
      "kind": "task",
      "allowedNext": [
        "running",
        "cancelled",
        "failed"
      ]
    },
    {
      "name": "running",
      "kind": "task",
      "allowedNext": [
        "succeeded",
        "partial_failed",
        "failed",
        "cancelled"
      ]
    },
    {
      "name": "succeeded",
      "kind": "task",
      "allowedNext": []
    },
    {
      "name": "partial_failed",
      "kind": "task",
      "allowedNext": [],
      "invariant": "列出未处理字段或来源"
    },
    {
      "name": "failed",
      "kind": "task",
      "allowedNext": []
    },
    {
      "name": "cancelled",
      "kind": "task",
      "allowedNext": []
    },
    {
      "name": "待审核",
      "kind": "review",
      "allowedNext": [
        "已确认",
        "退回"
      ]
    },
    {
      "name": "退回",
      "kind": "review",
      "allowedNext": [
        "待审核"
      ],
      "invariant": "重新提交形成新结果版本"
    },
    {
      "name": "已确认",
      "kind": "review",
      "allowedNext": [],
      "invariant": "模型重跑不得覆盖"
    }
  ],
  "sourceAndVersionRules": [
    "解析固定线索输入、原文内容摘要、模型、规则和字段配置版本。",
    "每个抽取值关联原文片段及页码或字段路径，缺失有明确原因。",
    "主体核验值绑定权威接口记录、版本和时间，不覆盖原文候选。",
    "机器重跑形成新版本，人工修订及确认结果形成独立可追溯版本。",
    "上游变化不重写历史结果，受影响结果标记需复核。",
    "模拟输入、主体核验及评测证据与真实环境隔离。"
  ],
  "errorsAndExceptions": [
    {
      "case": "clue_missing_or_unauthorized",
      "result": "拒绝任务且不泄露线索内容"
    },
    {
      "case": "source_data_missing",
      "result": "字段留空并列缺失项，不由模型补造"
    },
    {
      "case": "source_or_model_failure",
      "result": "返回失败或部分失败，不伪装为空字段"
    },
    {
      "case": "subject_api_unavailable",
      "result": "保留候选并标记未核验，不推算信用代码"
    },
    {
      "case": "priority_factors_missing",
      "result": "返回待评估及缺失因素"
    },
    {
      "case": "version_or_state_conflict",
      "result": "拒绝覆盖并返回当前版本或状态"
    },
    {
      "case": "partial_parse",
      "result": "列出已处理字段、未处理字段和来源失败"
    }
  ],
  "decisionPoints": [
