  "inputs": [
    {
      "name": "caseSnapshot",
      "required": true,
      "rules": [
        "案件稳定 ID、资料版本、事实状态和来源"
      ]
    },
    {
      "name": "scope",
      "required": true,
      "rules": [
        "程序、地域、相关日期和法律问题用途"
      ]
    },
    {
      "name": "confirmedQuery",
      "required": true,
      "rules": [
        "模型建议关键词和问题可人工修正并冻结"
      ]
    },
    {
      "name": "idempotencyKey",
      "required": true,
      "rules": [
        "绑定调用方、操作及完整输入"
      ]
    },
    {
      "name": "humanAdjustment",
      "required": "调整时",
      "rules": [
        "结果版本、具体条文版本、动作、理由和可信身份"
      ]
    }
  ],
  "outputs": [
    {
      "name": "matchTask",
      "fields": [
        "taskId",
        "status",
        "requestId",
        "inputManifest",
        "actualScope",
        "failedSources"
      ]
    },
    {
      "name": "candidate",
      "fields": [
        "articleId",
        "articleVersion",
        "verbatimText",
        "rank",
        "scoreOrLabel",
        "rankingVersion",
        "factRefs",
        "elementMapping",
        "missingConditions",
        "inapplicabilityRisks",
        "purpose"
      ]
    },
    {
      "name": "matchResult",
      "fields": [
        "resultId",
        "version",
        "systemCandidates",
        "humanConfirmedItems",
        "adjustmentHistory",
        "needsReview"
      ]
    }
  ],
  "permissions": [
    {
      "action": "prepare_or_match",
      "enforcement": "案件、事实、法规、解析要点及检索范围权限"
    },
    {
      "action": "read_candidate_or_source",
      "enforcement": "实时检查案件、法规原文和历史结果权限"
    },
    {
      "action": "adjust_or_confirm",
      "enforcement": "授权裁决人员、结果版本和具体条文版本校验"
    },
    {
      "action": "prepare_citation",
      "enforcement": "仅输出人工确认项，ADJ-06 再次校验"
    }
  ],
  "states": [
    {
      "name": "排队",
      "kind": "task",
      "allowedNext": [
        "处理中",
        "失败",
        "取消"
      ]
    },
    {
      "name": "处理中",
      "kind": "task",
      "allowedNext": [
        "成功",
        "部分成功",
        "失败",
        "取消"
      ]
    },
    {
      "name": "成功",
      "kind": "task",
      "allowedNext": []
    },
    {
      "name": "部分成功",
      "kind": "task",
      "allowedNext": [],
      "invariant": "列出失败来源或未处理步骤"
    },
    {
      "name": "失败",
      "kind": "task",
      "allowedNext": []
    },
    {
      "name": "取消",
      "kind": "task",
      "allowedNext": []
    },
    {
      "name": "系统候选",
      "kind": "match_item",
      "allowedNext": [
        "人工确认",
        "已移除"
      ]
    },
    {
      "name": "人工确认",
      "kind": "match_item",
      "allowedNext": [
        "待复核",
        "已移除"
      ],
      "invariant": "只适用于固定案件和法规版本"
    },
    {
      "name": "待复核",
      "kind": "match_item",
      "allowedNext": [
        "人工确认",
        "已移除"
      ]
    },
    {
      "name": "已移除",
      "kind": "match_item",
      "allowedNext": []
    }
  ],
  "sourceAndVersionRules": [
    "任务固定案件事实、程序、地域、时间、法规、解析、要点、模型和排序版本。",
    "每个匹配原因引用案件来源和具体条文版本，原文不可由解释替换。",
    "系统候选与人工调整形成分离、不可覆盖的结果版本。",
    "案件或法规变化标记旧结果待复核，人工确认不跨输入版本继承。",
    "有限候选、失败来源、实际范围和无结果分别披露。",
    "模拟与真实数据、检索和评测证据隔离。"
  ],
  "errorsAndExceptions": [
    {
      "case": "scope_information_missing",
      "result": "返回程序、地域或时间补充要求，不默认现行法"
    },
    {
      "case": "article_source_unreadable",
      "result": "返回原文不可读，不使用解析或要点冒充原文"
    },
    {
      "case": "search_dependency_failure",
      "result": "返回失败或部分成功，不伪装无匹配"
    },
    {
      "case": "case_or_regulation_unauthorized",
      "result": "拒绝且不泄露内容"
    },
    {
      "case": "no_match",
      "result": "返回实际检索范围和无结果，不形成确认依据"
    },
    {
      "case": "version_or_state_conflict",
      "result": "拒绝覆盖并返回当前结果版本或状态"
    }
  ],
  "decisionPoints": [
    {
      "id": "ADJ-05-DEC-001",
      "owner": "AI",
      "description": "提取法律问题、生成候选排序和要件解释；不得补造案情、改写原文或确认法律适用。",
      "sourceAnchors": [
        "1. 功能概述",
        "3. 匹配流程与规则"
      ]
    },
    {
      "id": "ADJ-05-DEC-002",
      "owner": "RULE",
      "description": "执行输入充分性、权限、时间地域程序、版本、评分映射、任务、调整状态和需复核传播。",
      "sourceAnchors": [
        "2. 输入输出字段",
        "3. 匹配流程与规则",
        "5. 服务契约"
      ]
    },
    {
      "id": "ADJ-05-DEC-003",
      "owner": "HUMAN",
      "description": "裁决人员补充范围、修正关键词、确认移除新增条文并填写理由；专家确认评测预期和阈值。",
      "sourceAnchors": [
