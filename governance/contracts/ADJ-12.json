  "clauses": [
    {
      "id": "ADJ-12-MUST-001",
      "type": "MUST",
      "statement": "由中心授权专业人员审核和修正固定版本的法律匹配、引用、专利分析、证据意见和裁决报告，保留完整修改、来源与决定依据。",
      "sourceAnchors": [
        "1. 功能概述",
        "2. 字段与状态"
      ],
      "acceptanceScenarioIds": [
        "ADJ-12-AC-001"
      ]
    },
    {
      "id": "ADJ-12-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "模型、服务账号、提交人冒用身份或未经授权人员不得代替专业人员作出审核、签发或正式状态确认。",
      "sourceAnchors": [
        "1. 功能概述",
        "3. 审核流程与规则",
        "6. 服务契约"
      ],
      "acceptanceScenarioIds": [
        "ADJ-12-AC-005",
        "ADJ-12-AC-009"
      ]
    },
    {
      "id": "ADJ-12-MUST-002",
      "type": "MUST",
      "statement": "共用审核对象可复用技术能力，但知识解析审核、单项分析审核、报告最终复核和正式签发的状态、权限与责任分别管理。",
      "sourceAnchors": [
        "1. 功能概述",
        "3. 审核流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-12-AC-001",
        "ADJ-12-AC-005"
      ]
    },
    {
      "id": "ADJ-12-MUST-003",
      "type": "MUST",
      "statement": "复核任务固定案件、对象类型、对象 ID/版本、原始结果快照、证据、依赖版本、提交人与时间，并使用真实身份确定复核人员和角色。",
      "sourceAnchors": [
        "2. 字段与状态",
        "3. 审核流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-12-AC-001"
      ]
    },
    {
      "id": "ADJ-12-MUST-004",
      "type": "MUST",
      "statement": "提交前执行完整性、案件与对象一致性、权限和依赖检查；缺少必填内容或关键证据的最终报告必须阻止提交。",
      "sourceAnchors": [
        "3. 审核流程与规则",
        "6. 服务契约"
      ],
      "acceptanceScenarioIds": [
        "ADJ-12-AC-001"
      ]
    },
    {
      "id": "ADJ-12-MUST-005",
      "type": "MUST",
      "statement": "按中心角色分配、领取和转派任务并记录人员、时间、理由与并发版本，防止多人覆盖同一结论。",
      "sourceAnchors": [
        "3. 审核流程与规则",
        "5. 内部验证页面",
        "6. 服务契约"
      ],
      "acceptanceScenarioIds": [
        "ADJ-12-AC-002"
      ]
    },
    {
      "id": "ADJ-12-MUST-006",
      "type": "MUST",
      "statement": "复核逐项核对事实、证据、技术对照、法规时点、引用格式和模板必填项；每个冲突、缺项及争议必须关闭或保留有依据的说明。",
      "sourceAnchors": [
        "2. 字段与状态",
        "3. 审核流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-12-AC-003"
      ]
    },
    {
      "id": "ADJ-12-MUST_NOT-002",
      "type": "MUST_NOT",
      "statement": "存在未核实重要事实或引用时，不得以已阅读勾选、模型建议、空意见或一般说明绕过逐项校验。",
      "sourceAnchors": [
        "3. 审核流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-12-AC-003"
      ]
    },
    {
      "id": "ADJ-12-MUST-007",
      "type": "MUST",
      "statement": "专业人员可认定事项不适用或资料已补齐，但必须填写依据并关联证据；通过、不通过或退回均形成具名决定记录。",
      "sourceAnchors": [
        "3. 审核流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-12-AC-003",
        "ADJ-12-AC-004"
      ]
    },
    {
      "id": "ADJ-12-MUST-008",
      "type": "MUST",
      "statement": "退回修改和不通过必须填写理由；通过也记录审核结论和实际采用的对象、来源及依赖版本清单。",
      "sourceAnchors": [
        "3. 审核流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-12-AC-004"
      ]
    },
    {
      "id": "ADJ-12-MUST-009",
      "type": "MUST",
      "statement": "复核中修正形成新修订并保留原始模型和人工版本及前后差异；最终决定必须针对已保存的确切修订版本。",
      "sourceAnchors": [
        "2. 字段与状态",
        "3. 审核流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-12-AC-004"
      ]
    },
    {
      "id": "ADJ-12-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "不得先审核旧版后静默替换内容，也不得在重提、转派、撤回或新审核尝试时覆盖历史意见和决定。",
      "sourceAnchors": [
        "3. 审核流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-12-AC-004"
      ]
    },
