  "sourceAndVersionRules": [
    "固定案件事件材料、适用范围、规则日历依据和权限版本。",
    "逐项四类结果不可互换，汇总保留缺口与失败。",
    "时限轨迹引用 ENF-08 固定版本。",
    "整改记录与计算报告分开，重跑创建新版本。",
    "任务、提醒、校验结果和案件流程状态分开。",
    "模拟流程数据库与真实验收证据隔离。"
  ],
  "errorsAndExceptions": [
    {
      "case": "required_event_or_material_missing",
      "result": "逐项无法判断，不计通过或违法"
    },
    {
      "case": "rule_not_applicable",
      "result": "该规则项标不适用并说明范围"
    },
    {
      "case": "calendar_or_deadline_input_missing",
      "result": "时限项无法判断，不生成截止结论"
    },
    {
      "case": "source_partial_failure",
      "result": "任务部分成功并列出未处理项"
    },
    {
      "case": "version_conflict",
      "result": "拒绝覆盖整改或报告并返回当前版本"
    },
    {
      "case": "unauthorized",
      "result": "拒绝且不泄露案件流程材料报告"
    }
  ],
