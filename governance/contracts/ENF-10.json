      ],
      "acceptanceScenarioIds": [
        "ENF-10-AC-001"
      ]
    },
    {
      "id": "ENF-10-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "系统或模型不得自行发明侵权要件、证据标准、抗辩、职权程序、严重程度或通用规则。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "4. 功能与处理规则",
        "8. 联调前需确认的条件"
