    {
      "id": "CON-08-AC-008",
      "given": [
        "重复请求、取消和重试"
      ],
      "when": "调用异步服务",
      "then": [
        "幂等和状态正确",
        "迟到结果不恢复取消",
        "错误 request_id 可追踪"
