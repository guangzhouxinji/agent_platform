        "ADJ-05-AC-010"
      ]
    },
    {
      "id": "ADJ-05-MUST_NOT-011",
      "type": "MUST_NOT",
      "statement": "不得自行设定效果或性能阈值，也不得只取成功样本计算结果。",
      "sourceAnchors": [
        "7. 验收要求",
        "8. 依赖与交付",
        "总览/8. 依赖与待落实材料",
        "总览/9. 开发与验收组织"
