        "affectedVersions",
        "newStatuses",
        "historicalReferences"
      ]
    }
  ],
  "permissions": [
    {
      "action": "import",
      "enforcement": "来源解析、字典和机构权限"
    },
    {
      "action": "edit_or_calibrate",
