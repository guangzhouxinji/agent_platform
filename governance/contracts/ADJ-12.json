    {
      "id": "ADJ-12-MUST_NOT-004",
      "type": "MUST_NOT",
      "statement": "未接通权威系统时不得生成虚构签章、正式文号、送达或办结事件，首版不得自动通知、送达当事人或执行裁决。",
      "sourceAnchors": [
