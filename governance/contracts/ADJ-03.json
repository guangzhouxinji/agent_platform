    },
    {
      "name": "停用",
      "kind": "availability",
      "allowedNext": [],
      "invariant": "外部导入不得自动启用"
    }
  ],
  "sourceAndVersionRules": [
    "要点、来源解析、法规条文和案例均固定稳定 ID 与版本。",
    "要点是派生知识，不替代原文引用。",
    "已引用版本和人工停用状态不可破坏性覆盖。",
    "来源变化保留旧版并传播待核实。"
  ],
  "errorsAndExceptions": [
