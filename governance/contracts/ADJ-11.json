      ]
    },
    {
      "name": "复核通过",
      "kind": "review",
      "allowedNext": [
        "待复核"
      ],
      "invariant": "实质修改必须创建新版本重新审核"
    },
    {
      "name": "未签发",
      "kind": "signing",
      "allowedNext": [
        "待签发"
      ]
    },
    {
      "name": "待签发",
      "kind": "signing",
      "allowedNext": [
        "已签发"
      ],
      "invariant": "复核通过但不是正式文件"
    },
    {
      "name": "已签发",
      "kind": "signing",
      "allowedNext": [],
      "invariant": "必须有授权动作或中心真实回执"
    },
    {
      "name": "排队",
      "kind": "task",
      "allowedNext": [
        "处理中",
        "失败",
        "取消"
      ]
    },
    {
      "name": "处理中",
      "kind": "task",
      "allowedNext": [
        "成功",
        "部分成功",
        "失败",
        "取消"
      ]
    },
    {
      "name": "成功",
      "kind": "task",
      "allowedNext": []
    },
    {
      "name": "部分成功",
      "kind": "task",
      "allowedNext": [],
