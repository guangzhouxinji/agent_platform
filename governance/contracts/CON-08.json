      ]
    },
    {
      "name": "scope",
      "required": "正式检索前确认；问题原文可先进入解析和补问",
      "rules": [
        "机构程序日期案例类型和授权范围"
      ]
    },
    {
      "name": "idempotencyKey",
      "required": "正式检索前确认；问题原文可先进入解析和补问",
      "rules": [
        "绑定调用方和完整确认输入"
      ]
    }
  ],
