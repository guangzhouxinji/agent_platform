      "acceptanceScenarioIds": [
        "ADJ-05-AC-004"
      ]
    },
    {
      "id": "ADJ-05-MUST-010",
      "type": "MUST",
      "statement": "人工可确认、移除或新增条文，必须选择具体版本并填写理由、人员和时间，形成新的匹配结果版本。",
      "sourceAnchors": [
        "2. 输入输出字段",
        "3. 匹配流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-05-AC-006"
      ]
    },
    {
      "id": "ADJ-05-MUST-011",
      "type": "MUST",
      "statement": "中心检索或混合检索的实际数据源、覆盖、筛选、召回和排序能力可核验；只在有限候选内重排时披露范围和候选数。",
      "sourceAnchors": [
        "2. 输入输出字段",
        "3. 匹配流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-05-AC-005"
      ]
    },
    {
      "id": "ADJ-05-MUST_NOT-006",
      "type": "MUST_NOT",
      "statement": "有限候选重排不得宣称全库或完整法律检索，上游失败不得伪装无匹配。",
      "sourceAnchors": [
        "3. 匹配流程与规则",
        "5. 服务契约",
        "总览/6.1 服务契约"
      ],
      "acceptanceScenarioIds": [
        "ADJ-05-AC-005",
        "ADJ-05-AC-009"
      ]
    },
    {
      "id": "ADJ-05-MUST-012",
      "type": "MUST",
      "statement": "数值相关度只有在确定算法与映射存在时输出并绑定排序版本；未标定时只输出稳定排序和标签，数值能力标记待补齐。",
      "sourceAnchors": [
        "2. 输入输出字段",
        "3. 匹配流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-05-AC-005"
      ]
    },
    {
      "id": "ADJ-05-MUST_NOT-007",
      "type": "MUST_NOT",
      "statement": "不得由大模型编造精确相关度或用模型置信分替代检索指标和人工评测。",
      "sourceAnchors": [
        "3. 匹配流程与规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ADJ-05-AC-005",
        "ADJ-05-AC-010"
      ]
    },
    {
      "id": "ADJ-05-MUST-013",
      "type": "MUST",
      "statement": "重新匹配创建新任务和结果版本，不覆盖人工调整；案件资料或法规变化使受影响结果待复核，旧人工确认不得自动继承。",
      "sourceAnchors": [
        "3. 匹配流程与规则",
        "总览/5.2 资料变化影响"
      ],
      "acceptanceScenarioIds": [
        "ADJ-05-AC-008"
      ]
    },
    {
      "id": "ADJ-05-MUST_NOT-008",
      "type": "MUST_NOT",
      "statement": "法规中的处罚内容不得因关键词命中自动纳入行政裁决理由，行政处罚和行政裁决程序不得混用。",
      "sourceAnchors": [
        "3. 匹配流程与规则",
        "7. 验收要求",
        "总览/4. 行政裁决业务边界"
      ],
      "acceptanceScenarioIds": [
        "ADJ-05-AC-004"
      ]
    },
    {
      "id": "ADJ-05-MUST-015",
      "type": "MUST",
      "statement": "案件和法规权限在召回、原文查看、调整及引用候选读取时由后端实时检查；权限撤回后不从缓存或历史结果泄露内容。",
      "sourceAnchors": [
