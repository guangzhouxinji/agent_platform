    },
    {
      "name": "失败",
      "kind": "task",
      "allowedNext": []
    },
    {
      "name": "取消",
      "kind": "task",
      "allowedNext": []
    }
  ],
  "sourceAndVersionRules": [
    "每个报告版本固定案件、模板、引用、解析、有效性、证据、模型和规则版本及确认状态。",
    "关键事实、法条和意见逐项关联来源；确定性内容和辅助生成内容分开。",
    "人工修订、候选重生成和采用结果分版本保存，重生成不覆盖人工内容。",
    "输入变化传播待复核，历史报告及其快照不被新输入改写。",
    "完整性、审核、签发和生成/导出任务状态分别保存。",
    "结构化正文是输出基准，DOCX/PDF 绑定同一摘要和渲染配置。",
    "模拟与真实案件、模型、渲染、DM8 和验收证据隔离。"
  ],
  "errorsAndExceptions": [
    {
      "case": "required_input_missing",
      "result": "返回完整缺项；可保存不完整草稿但阻止正式复核"
    },
    {
      "case": "template_not_applicable_or_revoked",
      "result": "拒绝正常生成并返回模板状态或用途错误"
    },
    {
      "case": "source_conflict_or_pending_review",
      "result": "保留冲突和辅助意见身份，不生成确定事实"
    },
    {
      "case": "generation_partial_or_failed",
      "result": "明确失败步骤并补偿孤立引用，不提升报告状态"
    },
    {
      "case": "revision_conflict",
      "result": "拒绝覆盖并返回当前报告版本和差异"
    },
    {
      "case": "render_failure",
      "result": "输出任务失败但结构化草稿保持可用"
    },
    {
      "case": "dependency_changed",
      "result": "标记受影响版本待复核，历史快照保留"
    },
    {
      "case": "unauthorized",
      "result": "拒绝且不通过缓存、历史或旧文件链接泄露内容"
    }
  ],
  "decisionPoints": [
    {
      "id": "ADJ-11-DEC-001",
      "owner": "AI",
      "description": "仅在授权模板范围内辅助生成解释性草稿和候选修订；不得补事实、生成正式认定裁决签章文号、通过复核或签发。",
      "sourceAnchors": [
        "1. 功能概述",
        "3. 生成及修订流程"
      ]
    },
    {
