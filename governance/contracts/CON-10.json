  "clauses": [
    {
      "id": "CON-10-MUST-001",
      "type": "MUST",
      "statement": "提示词分为面向用户的提问引导和内部系统执行模板，两类记录共用版本机制但用途、可见范围和使用统计分开。",
      "sourceAnchors": [
        "1. 功能概述",
        "4. 测试与统计"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-001",
        "CON-10-AC-008"
      ]
    },
    {
      "id": "CON-10-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "用户提问引导不得被直接拼接为高权限系统指令。",
      "sourceAnchors": [
        "1. 功能概述"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-001",
        "CON-10-AC-006"
      ]
    },
    {
      "id": "CON-10-MUST-002",
      "type": "MUST",
      "statement": "首版支持人工维护、预览、测试、发布、停用、复制新版本和归档。",
      "sourceAnchors": [
        "1. 功能概述",
        "3. 管理规则"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-002",
        "CON-10-AC-003"
      ]
    },
    {
      "id": "CON-10-MUST_NOT-002",
      "type": "MUST_NOT",
      "statement": "首版不要求自动批量生成提示词或自动上线优化；未经中心评审的生成模板不得直接发布。",
      "sourceAnchors": [
        "1. 功能概述",
        "8. 依赖与交付"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-011"
      ]
    },
    {
      "id": "CON-10-MUST-003",
      "type": "MUST",
      "statement": "每条提示词具有唯一且创建后不可修改的稳定编号，并记录名称、类型、正文、场景或意图稳定 ID、适用用户、语言、状态和不可变版本。",
      "sourceAnchors": [
        "2. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-002"
      ]
    },
    {
      "id": "CON-10-MUST-004",
      "type": "MUST",
      "statement": "模板变量记录名称、类型、必填性、来源和默认值规则；系统变量具有明确类型、转义和分隔规则。",
      "sourceAnchors": [
        "2. 信息字段",
        "3. 管理规则"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-004",
        "CON-10-AC-006"
      ]
    },
    {
      "id": "CON-10-MUST-005",
      "type": "MUST",
      "statement": "记录创建或辅助生成来源、创建时间、更新时间、创建人、修改人、发布人、变更说明和版本测试记录。",
      "sourceAnchors": [
        "2. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-002",
        "CON-10-AC-011"
      ]
    },
    {
      "id": "CON-10-MUST-006",
      "type": "MUST",
      "statement": "管理查询支持编号精确、名称或内容关键词包含查询，以及类型、场景和状态筛选；默认更新时间倒序、每页 20 条。",
      "sourceAnchors": [
        "3. 管理规则"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-002"
      ]
    },
    {
      "id": "CON-10-MUST-007",
      "type": "MUST",
      "statement": "已发布正文不可原地修改；编辑创建新草稿，保存时检查并发版本冲突。",
      "sourceAnchors": [
        "3. 管理规则",
        "总目录/3.4 配置引用与发布"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-003",
        "CON-10-AC-010"
      ]
    },
    {
      "id": "CON-10-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "草稿保存不得自动影响正式服务，也不得覆盖已发布或历史版本。",
      "sourceAnchors": [
        "3. 管理规则",
        "总目录/3.4 配置引用与发布"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-003"
      ]
    },
    {
      "id": "CON-10-MUST-008",
      "type": "MUST",
      "statement": "发布前校验变量定义、场景关联和模板完整性，未定义变量或缺失必填变量必须阻止发布或调用。",
      "sourceAnchors": [
        "3. 管理规则"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-004"
      ]
    },
    {
      "id": "CON-10-MUST_NOT-004",
      "type": "MUST_NOT",
      "statement": "变量无值且无允许的默认值时不得残留占位符或静默继续渲染。",
      "sourceAnchors": [
        "3. 管理规则"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-004"
      ]
    },
    {
      "id": "CON-10-MUST-009",
      "type": "MUST",
      "statement": "用户文本和检索文献始终作为数据输入并按变量规则转义或分隔，不能改变工具权限、系统规则或资源访问范围。",
      "sourceAnchors": [
        "3. 管理规则",
        "总目录/3.2 来源、版本和权限"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-006"
      ]
    },
    {
      "id": "CON-10-MUST_NOT-005",
      "type": "MUST_NOT",
      "statement": "模板不得声明超出智能体授权的资源访问，模型输出不得授予权限。",
      "sourceAnchors": [
        "3. 管理规则"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-006"
      ]
    },
    {
      "id": "CON-10-MUST-010",
      "type": "MUST",
      "statement": "用户引导按场景、用户范围和配置顺序展示；点击仅填入或发起普通用户问题，不执行管理动作；展示条数由调用方配置。",
      "sourceAnchors": [
        "3. 管理规则"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-001"
      ]
    },
    {
      "id": "CON-10-MUST-011",
      "type": "MUST",
      "statement": "发布新版本不自动替换智能体的固定版本引用，升级须通过智能体配置另行发布。",
      "sourceAnchors": [
        "3. 管理规则",
        "总目录/3.4 配置引用与发布"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-003"
      ]
    },
    {
      "id": "CON-10-MUST-012",
      "type": "MUST",
      "statement": "普通停用禁止新绑定和新展示但允许已有固定引用继续；紧急撤销立即拒绝所有运行时调用并进入已配置的回退或不可用状态。",
      "sourceAnchors": [
        "3. 管理规则",
        "总目录/3.4 配置引用与发布"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-005"
      ]
    },
    {
      "id": "CON-10-MUST_NOT-006",
      "type": "MUST_NOT",
      "statement": "普通停用与紧急撤销不得合并为语义不明的单一操作，界面和服务必须区分。",
      "sourceAnchors": [
        "3. 管理规则"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-005"
      ]
    },
    {
      "id": "CON-10-MUST-013",
      "type": "MUST",
      "statement": "草稿可以删除；有历史引用的版本只能归档并保留审计，历史审计不得因归档而破坏。",
      "sourceAnchors": [
        "3. 管理规则",
        "总目录/3.4 配置引用与发布"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-003"
      ]
    },
    {
      "id": "CON-10-MUST-014",
      "type": "MUST",
      "statement": "系统模板测试接收变量样例并返回渲染结果和逐项校验错误；模型试运行明确标为测试且记录模型与模板版本。",
      "sourceAnchors": [
        "4. 测试与统计"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-007"
      ]
    },
    {
      "id": "CON-10-MUST_NOT-007",
      "type": "MUST_NOT",
      "statement": "测试或模型试运行不得计入正式使用频率，也不得自动改变已发布配置。",
      "sourceAnchors": [
        "4. 测试与统计",
        "总目录/3.4 配置引用与发布"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-007",
        "CON-10-AC-008"
      ]
    },
    {
      "id": "CON-10-MUST-015",
      "type": "MUST",
      "statement": "用户引导的展示与点击分开统计；执行模板的成功渲染或调用与失败分开统计；重复事件 ID 幂等去重并注明时间范围和统计延迟。",
      "sourceAnchors": [
        "2. 信息字段",
        "4. 测试与统计"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-008"
      ]
    },
    {
      "id": "CON-10-MUST_NOT-008",
      "type": "MUST_NOT",
      "statement": "展示、点击、成功执行、失败执行不得合并成一个无法解释的使用次数。",
      "sourceAnchors": [
        "4. 测试与统计"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-008"
      ]
    },
    {
      "id": "CON-10-MUST-016",
      "type": "MUST",
      "statement": "普通用户仅能查询允许展示的用户引导，内部模板正文与管理接口只对有管理权限的账号或授权服务身份开放。",
      "sourceAnchors": [
        "5. 内部验证页面",
        "6. 服务契约"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-009"
      ]
    },
    {
      "id": "CON-10-MUST-018",
      "type": "MUST",
      "statement": "变量缺失、版本冲突、模板不可用、关联无效和无权限错误可区分，错误不得返回密钥、内部模板给无权用户或敏感内部堆栈。",
      "sourceAnchors": [
        "6. 服务契约",
        "总目录/3.2 来源、版本和权限"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-004",
        "CON-10-AC-009",
        "CON-10-AC-010"
      ]
    },
    {
      "id": "CON-10-MUST-022",
      "type": "MUST",
      "statement": "模板正文业务内容、首批引导问题、变量清单、发布权限、紧急撤销角色和事件保留时间须由中心确认后才能进入对应正式配置与验收。",
      "sourceAnchors": [
        "8. 依赖与交付"
      ],
      "acceptanceScenarioIds": [
        "CON-10-AC-011"
      ]
    }
  ],
  "inputs": [
    {
      "name": "promptDraft",
      "required": true,
      "rules": [
        "稳定编号创建后不可修改",
        "类型二选一",
        "正文、范围、语言、关联稳定 ID 和变更说明"
      ]
    },
    {
      "name": "variableDefinitions",
      "required": "系统执行模板时",
      "rules": [
        "名称、类型、必填、来源、默认规则、转义或分隔规则"
      ]
    },
    {
      "name": "expectedVersion",
      "required": "编辑、状态操作时",
      "rules": [
        "用于并发冲突检查"
      ]
    },
    {
      "name": "lifecycleAction",
      "required": "状态变更时",
      "rules": [
        "publish|disable|emergency_revoke|archive 明确区分并带原因"
      ]
    },
    {
      "name": "renderSample",
      "required": "测试时",
      "rules": [
        "样例变量和可选批准模型"
      ]
    },
    {
      "name": "usageEvent",
      "required": "统计上报时",
      "rules": [
        "唯一事件 ID、事件类型、提示词版本、时间"
      ]
    }
  ],
  "outputs": [
    {
      "name": "promptVersion",
      "fields": [
        "promptId",
        "versionId",
        "type",
        "status",
        "contentOrAllowedView",
        "scope",
        "audit"
      ]
    },
    {
      "name": "validation",
      "fields": [
        "valid",
        "fieldErrors",
        "undefinedVariables",
        "missingRequiredVariables"
      ]
    },
    {
      "name": "renderResult",
      "fields": [
        "renderedContent",
        "promptVersion",
        "modelVersionWhenTested",
        "testMarker"
      ]
    },
    {
      "name": "lifecycleResult",
      "fields": [
        "oldStatus",
        "newStatus",
        "operation",
        "operator",
        "reason",
        "affectedBindings"
      ]
    },
    {
      "name": "usageStatistics",
      "fields": [
        "timeRange",
        "delay",
        "displayCount",
        "clickCount",
        "successCount",
        "failureCount"
      ]
    }
  ],
  "permissions": [
    {
      "action": "read_user_guidance",
      "enforcement": "按场景、语言和用户范围由服务端过滤"
    },
    {
      "action": "read_internal_template",
      "enforcement": "仅授权服务身份及模板管理人员可读取固定版本"
    },
    {
      "action": "create_or_edit_draft",
      "enforcement": "模板管理权限且执行并发版本检查"
    },
    {
      "action": "publish",
      "enforcement": "中心确认的发布角色，记录真实人员身份"
    },
    {
      "action": "disable",
      "enforcement": "授权配置管理角色"
    },
    {
      "action": "emergency_revoke",
      "enforcement": "中心确认的紧急撤销角色，立即由运行时强制执行"
    },
    {
      "action": "view_internal_content",
      "enforcement": "普通咨询用户明确禁止"
    }
  ],
  "states": [
    {
      "name": "草稿",
      "allowedNext": [
        "已发布"
      ],
      "actions": [
        "编辑",
        "测试",
        "删除"
      ]
    },
    {
      "name": "已发布",
      "allowedNext": [
        "已停用",
        "已归档"
      ],
      "actions": [
        "固定版本调用",
        "复制新草稿",
        "紧急撤销"
      ]
    },
    {
      "name": "已停用",
      "allowedNext": [
        "已归档"
      ],
      "invariant": "禁止新绑定和新展示；已有固定引用可继续，除非紧急撤销"
    },
    {
      "name": "已归档",
      "allowedNext": [],
      "invariant": "历史引用与审计保留"
    },
    {
      "name": "紧急撤销标记",
      "kind": "runtime_control",
      "invariant": "不是普通停用的别名；立即阻止所有后续运行并触发配置回退或不可用状态"
    }
  ],
  "sourceAndVersionRules": [
    "提示词使用稳定编号加不可变版本；已发布版本不原地修改。",
    "草稿、发布、普通停用、紧急撤销和归档分别留存操作者、原因、时间和版本。",
    "流程和智能体绑定固定已发布版本，新版本发布不隐式漂移现有绑定。",
    "模板试运行记录模板和模型版本且标为测试，不计正式统计。",
    "运行清单记录实际提示词版本；紧急撤销在运行时重新校验。",
    "内部模板和日志遵守当前权限与脱敏要求，不向普通页面暴露正文、凭据或敏感堆栈。"
  ],
  "errorsAndExceptions": [
    {
      "case": "undefined_or_missing_variable",
      "result": "阻止发布或调用并逐项返回变量错误，不遗留占位符"
    },
    {
      "case": "version_conflict",
      "result": "拒绝覆盖并返回当前版本信息"
    },
    {
      "case": "invalid_scene_or_intent_reference",
      "result": "阻止发布并返回关联无效"
    },
    {
      "case": "template_disabled",
      "result": "拒绝新绑定或新展示，固定引用按普通停用规则处理"
    },
    {
      "case": "template_emergency_revoked",
      "result": "所有运行时调用立即拒绝并进入配置回退或明确不可用"
    },
    {
      "case": "unauthorized_template_read",
      "result": "拒绝且不返回内部正文、密钥或敏感错误"
    },
    {
      "case": "duplicate_usage_event",
      "result": "幂等接受且不重复累计"
    },
    {
      "case": "database_or_transaction_failure",
      "result": "状态变更不部分生效并返回可追踪失败"
    }
  ],
  "decisionPoints": [
    {
      "id": "CON-10-DEC-001",
      "owner": "AI",
      "description": "仅在人工发起的测试或辅助生成中产生候选内容；输出保持测试或草稿，不可自行发布。",
      "sourceAnchors": [
        "1. 功能概述",
        "4. 测试与统计",
        "8. 依赖与交付"
      ]
    },
    {
      "id": "CON-10-DEC-002",
      "owner": "RULE",
      "description": "执行变量校验、转义、权限限制、版本冲突、状态转换、固定版本解析、撤销和事件去重。",
      "sourceAnchors": [
        "3. 管理规则",
        "4. 测试与统计",
        "6. 服务契约"
      ]
    },
    {
      "id": "CON-10-DEC-003",
      "owner": "HUMAN",
      "description": "维护和确认正文、变量、适用范围与变更说明，并由授权人员执行发布、停用、紧急撤销和归档。",
      "sourceAnchors": [
        "3. 管理规则",
        "8. 依赖与交付"
      ]
    },
