  "sourceAndVersionRules": [
    "原文、外部生成、人工修订和审核版本分层保存。",
    "法规条文稳定 ID 与版本是关联主键，名称不是唯一依据。",
    "已审核版本不可覆盖，来源变化只标待复核。",
    "任务状态、解析状态和审核状态分离。"
  ],
  "errorsAndExceptions": [
    {
      "case": "ambiguous_or_mismatched_article",
      "result": "逐项失败并返回法规版本条号摘要差异"
    },
    {
      "case": "external_parser_failure",
      "result": "任务失败或部分成功，不写解析成功"
    },
    {
      "case": "duplicate_import",
      "result": "按确认策略跳过或新修订，仅未审核草稿可更新"
    },
    {
      "case": "source_changed",
      "result": "标待复核并保留旧版"
    },
    {
      "case": "version_conflict",
      "result": "拒绝覆盖"
    },
    {
      "case": "unauthorized",
      "result": "拒绝且不泄露未授权原文解析"
    }
  ],
