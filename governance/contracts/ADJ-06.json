        "历史版本需人工时点依据",
        "当前状态不替代历史判断",
        "缺口只保存待核实草稿"
      ],
      "sourceClauseIds": [
        "ADJ-06-MUST-004",
        "ADJ-06-MUST_NOT-003",
        "ADJ-06-MUST-005"
      ]
    },
    {
      "id": "ADJ-06-AC-004",
      "given": [
        "已创建引用和编辑前后两个报告版本"
      ],
      "when": "绑定章节位置",
      "then": [
        "使用稳定锚点",
        "新旧绑定分别保存",
        "页码不作为唯一位置"
      ],
      "sourceClauseIds": [
        "ADJ-06-MUST-006",
        "ADJ-06-MUST-008"
      ]
    },
    {
      "id": "ADJ-06-AC-005",
      "given": [
        "跨案件请求、冲突报告版本和失败生成批次"
      ],
      "when": "提交绑定",
      "then": [
        "跨案件和冲突被拒绝",
        "事务或补偿可核验",
        "不留下已采用孤立引用"
      ],
      "sourceClauseIds": [
        "ADJ-06-MUST_NOT-004",
        "ADJ-06-MUST-007"
      ]
    },
    {
      "id": "ADJ-06-AC-006",
      "given": [
        "待确认、修改后和撤回的引用"
      ],
      "when": "执行复核或撤回",
      "then": [
        "复核四类要素并留痕",
        "修改后重新审核",
        "撤回保留历史且不等于正式裁决"
      ],
      "sourceClauseIds": [
        "ADJ-06-MUST_NOT-001",
        "ADJ-06-MUST-009",
        "ADJ-06-MUST-010"
      ]
    },
    {
      "id": "ADJ-06-AC-007",
      "given": [
        "来源法规发布新版本或状态改变"
      ],
      "when": "检测依赖变化",
      "then": [
        "受影响当前引用和报告待复核",
        "旧原文和历史引用不被自动改写"
      ],
      "sourceClauseIds": [
        "ADJ-06-MUST_NOT-003",
        "ADJ-06-MUST-011"
      ]
