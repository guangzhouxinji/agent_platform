      "result": "返回缺口，不按零计算"
    },
    {
      "case": "out_of_statutory_range",
      "result": "阻止确认人工调整并说明范围依据"
    },
    {
      "case": "source_or_rule_failure",
      "result": "返回明确失败，不伪装不适用或无处罚"
    },
    {
      "case": "version_conflict",
      "result": "拒绝覆盖并返回当前版本"
    },
    {
      "case": "unauthorized",
      "result": "拒绝且不泄露案件建议证据"
    }
