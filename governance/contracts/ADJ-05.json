    {
      "id": "ADJ-05-MUST-007",
      "type": "MUST",
      "statement": "历史案件在授权法规版本内召回当时可能适用版本并保留过渡规则核实项，不只检索现行有效法。",
      "sourceAnchors": [
        "3. 匹配流程与规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-05-AC-003"
      ]
    },
    {
      "id": "ADJ-05-MUST-008",
      "type": "MUST",
      "statement": "每个候选逐项列出对应事实、构成要件、已满足条件、尚缺条件、不适用风险，以及实体、程序等用途。",
