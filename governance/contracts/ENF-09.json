  "clauses": [
    {
      "id": "ENF-09-MUST-001",
      "type": "MUST",
      "statement": "对中心案件固定事件和材料快照执行 ENF-08 已发布适用规则，形成逐项校验、依据、缺项和整改建议。",
      "sourceAnchors": [
        "1. 功能概述与交付范围",
        "2. 数据来源与依赖",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-09-AC-001"
      ]
    },
    {
      "id": "ENF-09-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "流程校验、疑似问题、整改建议或任务成功不得自动认定程序违法、案件违法成立、办结或处罚。",
      "sourceAnchors": [
        "3. 信息字段",
        "总览/5. AI、规则与人工边界"
      ],
      "acceptanceScenarioIds": [
        "ENF-09-AC-001"
      ]
    },
    {
      "id": "ENF-09-MUST-002",
      "type": "MUST",
      "statement": "接入校验案件稳定 ID、事件材料关联、案件快照版本、来源与权限；来源字段和业务编号不得由模型生成替换。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "3. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "ENF-09-AC-002"
      ]
    },
    {
      "id": "ENF-09-MUST-003",
      "type": "MUST",
      "statement": "按地区、程序和适用时间筛选规则，对所有适用项逐项检查并固定规则版本。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-09-AC-003"
      ]
    },
    {
      "id": "ENF-09-MUST-004",
      "type": "MUST",
      "statement": "每项结果严格区分通过、不通过、无法判断和不适用，并保存当前涉及环节、校验要求、事实、依据和缺口。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-09-AC-003"
      ]
    },
    {
      "id": "ENF-09-MUST_NOT-002",
      "type": "MUST_NOT",
      "statement": "字段缺失或中心接口未覆盖只能标无法判断，不得视为通过、不适用或程序违法；规则范围不匹配才可标不适用。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-09-AC-003"
      ]
    },
    {
      "id": "ENF-09-MUST-005",
      "type": "MUST",
      "statement": "时限项调用固定 ENF-08 确定性规则，保存输入事件、工作日历、例外、截止时间和逐步计算过程。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-09-AC-004"
      ]
    },
    {
      "id": "ENF-09-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "不得由模型重新计算或修改法定时限，也不得在缺少日历、事件或例外依据时生成通过或超期结论。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "总览/5. AI、规则与人工边界"
      ],
      "acceptanceScenarioIds": [
        "ENF-09-AC-004"
      ]
    },
    {
      "id": "ENF-09-MUST-006",
      "type": "MUST",
      "statement": "临期提醒仅使用中心确认的配置和计算结果，提醒状态与校验结论、案件流程状态分开。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-09-AC-004"
      ]
    },
    {
      "id": "ENF-09-MUST-007",
      "type": "MUST",
      "statement": "业务人员可登记整改说明及证据，重新校验创建新任务与报告并保留前后结果、输入和规则版本。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "5. 服务接口需求"
      ],
      "acceptanceScenarioIds": [
        "ENF-09-AC-005"
      ]
    },
    {
      "id": "ENF-09-MUST_NOT-004",
      "type": "MUST_NOT",
      "statement": "人工整改说明不得直接把旧计算结果改为通过、覆盖旧报告或跳过重新校验。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-09-AC-005"
      ]
    },
    {
      "id": "ENF-09-MUST-008",
      "type": "MUST",
      "statement": "源接口失败、解析失败或部分规则无法执行时任务为失败或部分成功并列出未处理项，不生成全部通过报告。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "5. 服务接口需求"
      ],
      "acceptanceScenarioIds": [
        "ENF-09-AC-006"
      ]
    },
    {
      "id": "ENF-09-MUST-010",
      "type": "MUST",
      "statement": "案件、事件、材料、规则、报告、整改和历史均由后端按机构角色实时鉴权，关联资源缺失或无权限时拒绝。",
      "sourceAnchors": [
        "5. 服务接口需求",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-09-AC-008"
      ]
    },
    {
      "id": "ENF-09-MUST-013",
      "type": "MUST",
      "statement": "固定中心样例记录案件事件材料、规则日历、预期实际、计算过程、权限、API、页面和问题编号，专业预期由中心确认。",
      "sourceAnchors": [
        "7. 验收要求",
        "8. 联调前需确认的条件"
      ],
      "acceptanceScenarioIds": [
        "ENF-09-AC-011"
      ]
    },
    {
      "id": "ENF-09-SEM-MUST-001",
      "type": "MUST",
      "statement": "本能力参与智能体任务时，一次工具执行成功、局部输出、通知或审核动作不直接认定整个用户业务目标完成；跨轮对象绑定稳定版本，纠正保留原目标与历史并重核依赖结果；人工接收须有实际记录，业务、任务、审核、正式状态分别表达。",
      "sourceAnchors": [
        "docs/02-待确认事项清单.md#23",
        "docs/01-总体需求与架构方案.md#5"
      ],
      "acceptanceScenarioIds": [
        "ENF-09-SEM-AC-001"
      ]
    }
