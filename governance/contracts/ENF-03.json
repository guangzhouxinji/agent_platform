  "clauses": [
    {
      "id": "ENF-03-MUST-001",
      "type": "MUST",
      "statement": "对 ENF-01 固定接入记录执行 ENF-02 已发布适用规则，形成带命中证据的待核实线索。",
      "sourceAnchors": [
        "1. 功能概述与交付范围",
        "2. 数据来源与依赖",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-03-AC-001"
      ]
    },
    {
      "id": "ENF-03-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "规则命中、模型置信度、通知成功或任务成功不得称为违法成立、正式立案或处置决定。",
      "sourceAnchors": [
        "1. 功能概述与交付范围",
        "3. 信息字段",
        "总览/5. AI、规则与人工边界"
      ],
      "acceptanceScenarioIds": [
        "ENF-03-AC-001"
      ]
    },
    {
      "id": "ENF-03-MUST-002",
      "type": "MUST",
      "statement": "首版按同步批次触发，事件推送仅在中心提供且确认协议后接入；固定数据批次、源记录和规则版本。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "5. 服务接口需求"
      ],
      "acceptanceScenarioIds": [
        "ENF-03-AC-002"
      ]
    },
    {
      "id": "ENF-03-MUST-003",
      "type": "MUST",
      "statement": "接入前校验资源编号、关联、版本和权限，源数据缺失、源调用失败、解析失败和规则不适用分别记录。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "5. 服务接口需求"
      ],
      "acceptanceScenarioIds": [
        "ENF-03-AC-002",
        "ENF-03-AC-006"
      ]
    },
    {
      "id": "ENF-03-MUST_NOT-002",
      "type": "MUST_NOT",
      "statement": "来源、业务编号、原记录引用和事实字段不得由模型生成、替换或随意改写。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "3. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "ENF-03-AC-002"
      ]
    },
    {
      "id": "ENF-03-MUST-005",
      "type": "MUST",
      "statement": "置信度仅在模型实际评分时记录并绑定模型版本，不得补默认值或替代规则命中事实。",
      "sourceAnchors": [
        "3. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "ENF-03-AC-003"
      ]
    },
    {
      "id": "ENF-03-MUST-006",
      "type": "MUST",
      "statement": "同一源记录同一版本只生成一条线索，多规则命中合并明细；源新版本追加发现记录且不覆盖历史处置。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-03-AC-004"
      ]
    },
    {
      "id": "ENF-03-MUST-007",
      "type": "MUST",
      "statement": "跨来源相似记录只标疑似重复，由人工确认后建立关联，不自动合并线索或处置。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-03-AC-004"
      ]
    },
    {
      "id": "ENF-03-MUST-008",
      "type": "MUST",
      "statement": "线索状态区分待核实、核实中、已转处置、排除和关闭；排除关闭必须保留原因、人员、时间和版本。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-03-AC-005"
      ]
    },
    {
      "id": "ENF-03-MUST-009",
      "type": "MUST",
      "statement": "通知状态与线索处置状态分开；中心接收接口存在且授权时按事件编号幂等推送，失败有限重试。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则",
        "8. 联调前需确认的条件"
      ],
      "acceptanceScenarioIds": [
        "ENF-03-AC-005"
      ]
    },
    {
      "id": "ENF-03-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "不得默认短信等通知渠道，推送失败不得改变线索事实或重复通知。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "8. 联调前需确认的条件"
      ],
      "acceptanceScenarioIds": [
        "ENF-03-AC-005"
      ]
    },
    {
      "id": "ENF-03-MUST-010",
      "type": "MUST",
      "statement": "源接口、规则或模型失败进入失败或部分失败及未处理明细，不得计为未命中或完整成功。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "5. 服务接口需求"
      ],
      "acceptanceScenarioIds": [
        "ENF-03-AC-006"
      ]
    },
    {
      "id": "ENF-03-MUST-012",
      "type": "MUST",
      "statement": "来源、线索、状态、通知和历史在后端按机构与角色实时鉴权，关联资源不存在或无权限时拒绝且不泄露。",
      "sourceAnchors": [
        "5. 服务接口需求",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-03-AC-008"
      ]
    },
    {
      "id": "ENF-03-MUST-015",
      "type": "MUST",
      "statement": "固定专业样例记录请求、期望、实际、来源、规则模型、任务和证据版本，业务期望与效果性能阈值由中心确认。",
      "sourceAnchors": [
        "7. 验收要求",
        "8. 联调前需确认的条件"
      ],
      "acceptanceScenarioIds": [
        "ENF-03-AC-011"
      ]
    },
    {
      "id": "ENF-03-SEM-MUST-001",
      "type": "MUST",
      "statement": "本能力参与智能体任务时，一次工具执行成功、局部输出、通知或审核动作不直接认定整个用户业务目标完成；跨轮对象绑定稳定版本，纠正保留原目标与历史并重核依赖结果；人工接收须有实际记录，业务、任务、审核、正式状态分别表达。",
      "sourceAnchors": [
        "docs/02-待确认事项清单.md#23",
        "docs/01-总体需求与架构方案.md#5"
      ],
      "acceptanceScenarioIds": [
        "ENF-03-SEM-AC-001"
      ]
    },
    {
      "id": "ENF-03-SEM-MUST-002",
      "type": "MUST",
      "statement": "通知投递或待办创建不能称为人员已受理；交接须有可信人员实际受理记录或接收系统真实回执，未受理仍保留待处理和重试/查询入口。",
      "sourceAnchors": [
        "docs/02-待确认事项清单.md#23",
        "1. 功能概述与交付范围"
      ],
      "acceptanceScenarioIds": [
        "ENF-03-SEM-AC-002"
      ]
    }
