    },
    {
      "id": "ADJ-05-MUST-019",
      "type": "MUST",
      "statement": "专家样本评测 Recall@K、排序质量和适用解释支持度，冻结案件、法规、检索、模型与排序版本，阈值经试测和中心确认。",
      "sourceAnchors": [
        "7. 验收要求",
        "8. 依赖与交付",
        "总览/9. 开发与验收组织"
      ],
