  "sourceAndVersionRules": [
    "目标候选原始和确认输入、分类地域时间、依据、模型规则固定版本。",
    "各维度事实证据意见和状态分开，原图可核验。",
    "检索相关度、维度意见、综合辅助意见和法律结论分开。",
    "模型原始报告与人工复核意见分开保存。",
    "来源或依据变化创建新分析并保留历史。",
    "模拟图像数据数据库与真实验收证据隔离。"
  ],
  "errorsAndExceptions": [
    {
      "case": "classification_or_scope_missing",
      "result": "返回补问，不默认类别地域时间"
    },
    {
      "case": "image_missing_or_expired",
      "result": "图形整体视觉为材料不足，不生成意见"
    },
    {
      "case": "standard_unavailable",
      "result": "保留可观察差异并标依据缺口，不编条款"
    },
    {
      "case": "candidate_partial_failure",
      "result": "其他结果保留并标部分成功"
    },
    {
      "case": "version_conflict",
      "result": "拒绝覆盖并返回当前报告版本"
    },
    {
      "case": "unauthorized",
      "result": "拒绝且不从图样缓存报告历史泄露"
    }
  ],
  "decisionPoints": [
    {
      "id": "CON-07-DEC-001",
      "owner": "AI",
      "description": "可识别文字读音含义图形并生成有证据的辅助意见；不得猜输入、伪图形分析、编标准、打法律分或作近似结论。",
      "sourceAnchors": [
        "3. 分析流程与规则",
        "4. 报告与复核"
      ]
    },
    {
      "id": "CON-07-DEC-002",
      "owner": "RULE",
      "description": "执行完整性、权限、维度状态、分类依据、任务、版本和依赖变化规则。",
      "sourceAnchors": [
        "2. 输入输出字段",
        "3. 分析流程与规则",
        "6. 服务契约"
      ]
    },
    {
      "id": "CON-07-DEC-003",
      "owner": "HUMAN",
      "description": "用户确认输入分类范围和识别歧义，专业人员复核报告并确认业务标准及样本。",
      "sourceAnchors": [
        "3. 分析流程与规则",
        "4. 报告与复核",
        "7. 验收要求"
      ]
    },
    {
      "id": "CON-07-DEC-004",
      "owner": "AUTHORITY_SYSTEM",
      "description": "中心提供商标图样状态、分类审查标准、商品服务关系、权限和正式审核渠道。",
      "sourceAnchors": [
        "1. 功能概述",
        "8. 依赖与交付"
      ]
    }
  ],
  "acceptanceScenarios": [
    {
      "id": "CON-07-AC-001",
      "given": [
        "检索跳转或直接选定目标候选"
      ],
      "when": "创建辅助比对",
      "then": [
        "对象和来源版本固定",
        "逐维分析",
        "不输出注册率或正式近似结论"
      ],
      "sourceClauseIds": [
        "CON-07-MUST-001",
        "CON-07-MUST_NOT-001"
      ]
    },
    {
      "id": "CON-07-AC-002",
      "given": [
        "类别时间地域目的缺失"
      ],
      "when": "分析准备",
      "then": [
        "返回补问",
        "不默认或模型猜测",
        "确认后冻结范围"
      ],
      "sourceClauseIds": [
        "CON-07-MUST-002",
        "CON-07-MUST_NOT-002"
      ]
    },
    {
      "id": "CON-07-AC-003",
      "given": [
        "检索快照、源更新和识别歧义"
      ],
      "when": "重新获取并确认输入",
      "then": [
        "实时鉴权和源状态可见",
        "原始与修正值分开",
        "不只沿用摘要"
      ],
      "sourceClauseIds": [
        "CON-07-MUST-003",
        "CON-07-MUST-004"
      ]
    },
    {
      "id": "CON-07-AC-004",
      "given": [
        "多音外文、含义推测、缺图和完整原图"
      ],
      "when": "逐维分析",
      "then": [
        "不确定与材料支持分开",
        "图形只基于实际图样",
        "缺图不伪装已分析"
      ],
      "sourceClauseIds": [
        "CON-07-MUST-005",
        "CON-07-MUST-006",
        "CON-07-MUST_NOT-003"
      ]
    },
    {
      "id": "CON-07-AC-005",
      "given": [
        "同类别不同项目和跨类别相关项目"
      ],
      "when": "分析商品服务关系",
      "then": [
        "项目类似群版本和理由完整",
        "类别一致与否不直接决定结果"
      ],
      "sourceClauseIds": [
        "CON-07-MUST-007"
      ]
    },
    {
      "id": "CON-07-AC-006",
      "given": [
        "已分析、不适用和材料不足维度"
      ],
      "when": "生成综合意见",
      "then": [
        "状态缺口准确",
        "只用辅助措辞和具体理由",
        "不以投票阈值检索分数得法律结论"
      ],
      "sourceClauseIds": [
        "CON-07-MUST_NOT-001",
        "CON-07-MUST-008",
        "CON-07-MUST-009",
        "CON-07-MUST_NOT-004"
      ]
    },
    {
      "id": "CON-07-AC-007",
      "given": [
        "未复核报告和源依据更新"
      ],
