  "inputs": [
    {
      "name": "reviewSubmission",
      "required": true,
      "rules": [
        "案件、对象类型、对象 ID/版本、快照、依赖清单、提交人和幂等键"
      ]
    },
    {
      "name": "assignmentAction",
      "required": "分配领取转派时",
      "rules": [
        "任务版本、真实人员、角色、动作和转派理由"
      ]
    },
    {
      "name": "reviewRevision",
      "required": "修正时",
      "rules": [
        "被审版本、逐项修改、依据、证据关联和可信身份"
      ]
    },
    {
      "name": "reviewDecision",
      "required": "决定时",
      "rules": [
        "最终保存版本、动作、意见、依赖版本和当前任务版本"
      ]
    },
    {
      "name": "formalStatusEvidence",
      "required": "签发衔接时",
      "rules": [
        "锁定报告版本、授权动作、真实签发事实或源回执"
      ]
    }
  ],
  "outputs": [
    {
      "name": "reviewTask",
      "fields": [
        "taskId",
        "caseId",
        "objectType",
        "objectId",
        "objectVersion",
        "status",
        "assignee",
        "version",
        "gaps"
      ]
    },
    {
      "name": "reviewRevision",
      "fields": [
        "revisionId",
        "baseVersion",
        "content",
        "diff",
        "reason",
        "evidenceRefs",
        "author"
      ]
    },
    {
      "name": "decisionEvent",
      "fields": [
        "decisionId",
        "reviewedVersion",
        "result",
        "opinion",
        "reviewer",
        "role",
        "dependencyManifest",
        "decidedAt"
      ]
    },
    {
      "name": "reviewChain",
      "fields": [
        "attempts",
        "assignments",
        "revisions",
        "decisions",
        "dependencies",
        "invalidationEvents"
      ]
    },
    {
      "name": "formalStatus",
      "fields": [
        "signingStatus",
        "authorityReceipt",
        "reconciliationStatus",
        "formalFileRef",
        "lockedReportVersion"
      ]
    }
  ],
  "permissions": [
    {
      "action": "submit",
      "enforcement": "案件、被审对象和所有关键依赖读取权限及提交角色"
    },
    {
      "action": "assign_or_transfer",
      "enforcement": "中心任务分配角色、人员有效性和任务并发版本"
    },
    {
      "action": "review_or_revise",
      "enforcement": "专业复核角色、案件权限、职责分离和确切对象版本"
    },
    {
      "action": "decide",
      "enforcement": "最终审核角色、依赖未变、修订已保存及当前任务所有权"
    },
    {
      "action": "sign_or_register",
      "enforcement": "独立授权签发角色或权威系统回执，不继承普通复核权限"
    },
    {
      "action": "read_chain",
      "enforcement": "按当前案件、对象、证据和正式文件权限过滤历史"
    }
  ],
  "states": [
