      ]
    },
    {
      "id": "ENF-04-DEC-004",
      "owner": "AUTHORITY_SYSTEM",
      "description": "中心线索与主体系统提供真实原文、主体核验、版本和权限；其回执不能由 AI 替代。",
      "sourceAnchors": [
        "2. 数据来源与依赖"
      ]
    }
  ],
