  "clauses": [
    {
      "id": "ENF-15-MUST-001",
      "type": "MUST",
      "statement": "仅维护中心确认的处罚依据、行政处罚程序适用条件、法定幅度、地方裁量因素、证据要求、有效期间和地区程序范围。",
      "sourceAnchors": [
        "1. 功能概述与交付范围",
        "2. 数据来源与依赖",
        "3. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "ENF-15-AC-001"
      ]
    },
    {
      "id": "ENF-15-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "AI 或开发人员不得预置、推断或补充未经中心核实的处罚数值、裁量公式、惯例、条件或法律适用结论。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "8. 联调前需确认的条件"
      ],
      "acceptanceScenarioIds": [
        "ENF-15-AC-001"
      ]
    },
    {
      "id": "ENF-15-MUST-002",
      "type": "MUST",
      "statement": "处罚依据关联 ENF-17 的具体条文版本，来源字段固定稳定标识和版本并校验权限；缺失与源调用失败分开。",
      "sourceAnchors": [
        "2. 数据来源与依赖"
      ],
      "acceptanceScenarioIds": [
        "ENF-15-AC-002"
      ]
    },
    {
      "id": "ENF-15-MUST-003",
      "type": "MUST",
      "statement": "先确定该行为和机关程序是否适用行政处罚，不适用时规则不得生成罚款匹配。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-15-AC-003"
      ]
    },
    {
      "id": "ENF-15-MUST-004",
      "type": "MUST",
      "statement": "法定幅度与裁量基准分开维护；无适用裁量基准时返回缺口而非使用惯例。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-15-AC-003"
      ]
    },
    {
      "id": "ENF-15-MUST-005",
      "type": "MUST",
      "statement": "金额规则采用确定性公式，明确违法经营额、违法所得等口径、币种、精度、上下限、单位、舍入和逐步计算。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-15-AC-004"
      ]
    },
    {
      "id": "ENF-15-MUST_NOT-002",
      "type": "MUST_NOT",
      "statement": "缺少金额口径、边界或舍入规则时不得发布金额规则，也不得默认按零或任意口径试算。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-15-AC-004"
      ]
    },
    {
      "id": "ENF-15-MUST-006",
      "type": "MUST",
      "statement": "减轻、从轻、不予处罚等情形分别配置条件、证据要求和依据；冲突或依据不清转人工判断。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-15-AC-005"
      ]
    },
    {
      "id": "ENF-15-MUST-007",
      "type": "MUST",
      "statement": "发布前执行适用性、上下限和边界试算；重叠规则必须有中心确认的优先关系，否则阻止发布并列出冲突。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-15-AC-005"
      ]
    },
    {
      "id": "ENF-15-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "冲突规则不得静默选择处罚更重、更轻、最新或模型评分最高的一条。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-15-AC-005"
      ]
    },
    {
      "id": "ENF-15-MUST-008",
      "type": "MUST",
      "statement": "发布规则为不可变快照，编辑创建新草稿版本，停用限制新任务，历史建议保留原规则版本。",
      "sourceAnchors": [
        "3. 信息字段",
        "5. 服务接口需求"
      ],
      "acceptanceScenarioIds": [
        "ENF-15-AC-006"
      ]
    },
    {
      "id": "ENF-15-MUST-012",
      "type": "MUST",
      "statement": "固定专业样例记录输入、规则版本、预期、逐步实际、依据和问题，专业预期由中心确认。",
      "sourceAnchors": [
        "7. 验收要求",
        "8. 联调前需确认的条件"
      ],
      "acceptanceScenarioIds": [
        "ENF-15-AC-009"
      ]
    }
  ],
  "inputs": [
    {
      "name": "penaltyRuleDraft",
      "required": true,
