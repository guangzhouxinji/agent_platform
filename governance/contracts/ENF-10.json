      ]
    },
    {
      "id": "ENF-10-MUST-010",
      "type": "MUST",
      "statement": "发布版本不可原地修改，编辑创建新草稿，停用限制新分析，历史分析继续引用旧规则和依据。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则"
