  "clauses": [
    {
      "id": "ENF-02-MUST-001",
      "type": "MUST",
      "statement": "配置从已授权源记录中筛选疑似违法线索的规则，并提供草稿、试运行、发布、停用和版本能力。",
      "sourceAnchors": [
        "1. 功能概述与交付范围",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-02-AC-001",
        "ENF-02-AC-005"
      ]
    },
    {
      "id": "ENF-02-MUST-003",
      "type": "MUST",
      "statement": "规则业务内容依赖中心提供并确认的违法行为分类、业务规则、标注样例以及获授权的商标或专利数据服务。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "8. 联调前需确认的条件"
      ],
      "acceptanceScenarioIds": [
        "ENF-02-AC-011"
      ]
    },
    {
      "id": "ENF-02-MUST_NOT-002",
      "type": "MUST_NOT",
      "statement": "不得由 AI 或开发人员自行预置违法分类、法定标准、阈值、例外或专业期望结果。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "8. 联调前需确认的条件",
        "总览/7. API 与业务材料依赖清单"
      ],
      "acceptanceScenarioIds": [
        "ENF-02-AC-011"
      ]
    },
    {
      "id": "ENF-02-MUST-004",
      "type": "MUST",
      "statement": "规则接入和试运行校验资源编号、关联关系、版本、来源和当前访问权限，并分开表示源数据缺失、调用失败和规则不适用。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "5. 服务接口需求"
      ],
      "acceptanceScenarioIds": [
        "ENF-02-AC-007"
      ]
    },
    {
      "id": "ENF-02-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "来源字段、样例事实和缺失信息不得由模型生成、替换或为满足必填而编造。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "总览/4. 信息字段说明"
      ],
      "acceptanceScenarioIds": [
        "ENF-02-AC-007"
      ]
    },
    {
      "id": "ENF-02-MUST-005",
      "type": "MUST",
      "statement": "规则记录唯一编号、名称、中心确认的适用违法行为类型、规则说明、结构化匹配条件、适用数据源、状态、不可变发布版本、机构和审计字段。",
      "sourceAnchors": [
        "3. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "ENF-02-AC-001"
      ]
    },
    {
      "id": "ENF-02-MUST-006",
      "type": "MUST",
      "statement": "评分型规则必须定义触发阈值及有效范围；阈值越界或条件字段缺失时阻止发布并定位字段。",
      "sourceAnchors": [
        "3. 信息字段",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-02-AC-002"
      ]
    },
    {
      "id": "ENF-02-MUST-007",
      "type": "MUST",
      "statement": "确定性匹配仅支持已登记字段上的存在、文本包含、数值比较及 AND/OR 组合，并使用固定规则解释器执行。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-02-AC-003"
      ]
    },
    {
      "id": "ENF-02-MUST_NOT-004",
      "type": "MUST_NOT",
      "statement": "规则内容不得接受或执行任意脚本、任意 URL、数据库语句或未登记工具调用。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-02-AC-003"
      ]
    },
    {
      "id": "ENF-02-MUST-008",
      "type": "MUST",
      "statement": "需要语义判断时显式配置模型任务、输入范围、结构化输出字段、模型版本和阈值；模型结果仅为疑似筛选信号。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-02-AC-004"
      ]
    },
    {
      "id": "ENF-02-MUST_NOT-005",
      "type": "MUST_NOT",
      "statement": "模型置信分不得表述为评测准确率、违法概率或正式执法结论。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求",
        "总览/5. 审核与版本通用要求",
        "总览/9. 验收组织"
      ],
      "acceptanceScenarioIds": [
        "ENF-02-AC-004",
        "ENF-02-AC-010"
      ]
    },
    {
      "id": "ENF-02-MUST-009",
      "type": "MUST",
      "statement": "发布前必须以中心确认样例试运行并逐条件展示命中和未命中理由，再由授权人员执行发布。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-02-AC-002",
        "ENF-02-AC-003"
      ]
    },
    {
      "id": "ENF-02-MUST_NOT-006",
      "type": "MUST_NOT",
      "statement": "草稿试运行不得创建正式线索、改变正式规则绑定或发送通知。",
      "sourceAnchors": [
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-02-AC-005"
      ]
    },
    {
      "id": "ENF-02-MUST-010",
      "type": "MUST",
      "statement": "假冒专利、专利侵权和宣传问题分类分别配置，不得默认其适用相同规则或处置程序。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-02-AC-006"
      ]
    },
    {
      "id": "ENF-02-MUST_NOT-007",
      "type": "MUST_NOT",
      "statement": "不得因分类名称相似而合并业务类别、规则条件或后续处置含义。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-02-AC-006"
      ]
    },
    {
      "id": "ENF-02-MUST-011",
      "type": "MUST",
      "statement": "配置生命周期支持新增和编辑草稿、复制版本、试运行、发布和停用；发布前校验条件完整、数据源可访问及依赖有效。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-02-AC-001",
        "ENF-02-AC-002"
      ]
    },
    {
      "id": "ENF-02-MUST-012",
      "type": "MUST",
      "statement": "发布后版本不可原地修改；已有运行固定绑定原版本，新版需显式发布和绑定；停用只影响后续新任务并保留历史依据。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则",
        "总览/5. 审核与版本通用要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-02-AC-005",
        "ENF-02-AC-009"
      ]
    },
    {
      "id": "ENF-02-MUST_NOT-008",
      "type": "MUST_NOT",
      "statement": "草稿保存、新版发布或停用不得重写历史结果、历史规则版本或已有运行绑定。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "总览/5. 审核与版本通用要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-02-AC-005",
        "ENF-02-AC-009"
      ]
    },
    {
      "id": "ENF-02-MUST-014",
      "type": "MUST",
      "statement": "写入返回规则编号和版本；列表支持文档筛选、分页及更新时间倒序；详情返回完整字段、来源和历史版本而非摘要。",
      "sourceAnchors": [
        "3. 信息字段",
        "5. 服务接口需求",
        "6. 内部验证页面"
      ],
      "acceptanceScenarioIds": [
        "ENF-02-AC-008"
      ]
    },
    {
      "id": "ENF-02-MUST-015",
      "type": "MUST",
      "statement": "配置变更、人工修订、审核和状态变更记录真实操作人、前后状态、时间和版本；编辑使用预期版本并拒绝冲突覆盖。",
      "sourceAnchors": [
        "5. 服务接口需求",
        "总览/3. 通用接口约定"
      ],
      "acceptanceScenarioIds": [
        "ENF-02-AC-009"
      ]
    },
    {
      "id": "ENF-02-MUST_NOT-009",
      "type": "MUST_NOT",
      "statement": "部分结果不得伪装完整成功，错误不得泄露凭证、敏感材料或内部堆栈。",
      "sourceAnchors": [
        "5. 服务接口需求",
        "总览/3. 通用接口约定"
      ],
      "acceptanceScenarioIds": [
        "ENF-02-AC-007"
      ]
    },
    {
      "id": "ENF-02-MUST-019",
      "type": "MUST",
      "statement": "确定性规则对固定规则版本和固定样例必须产生一致结果；模型规则使用中心专家标注的独立样本集评测并记录分母、版本和来源正确性。",
      "sourceAnchors": [
        "7. 验收要求",
        "8. 联调前需确认的条件",
        "总览/9. 验收组织"
      ],
      "acceptanceScenarioIds": [
        "ENF-02-AC-003",
        "ENF-02-AC-010"
      ]
    },
    {
      "id": "ENF-02-MUST_NOT-010",
      "type": "MUST_NOT",
      "statement": "未确认中心样例、阈值或独立评测结果时，不得把模型自评分、静态演示或模拟结果作为业务正确性验收。",
      "sourceAnchors": [
        "7. 验收要求",
        "8. 联调前需确认的条件",
        "总览/6. 内部前端通用要求",
        "总览/9. 验收组织"
      ],
      "acceptanceScenarioIds": [
        "ENF-02-AC-010",
        "ENF-02-AC-011"
      ]
    },
    {
      "id": "ENF-02-MUST-021",
      "type": "MUST",
      "statement": "模拟数据必须显式标记并与真实环境隔离；未确认的违法字典、评分阈值、样例和模型效果只能作为阻塞项。",
      "sourceAnchors": [
        "8. 联调前需确认的条件",
        "总览/3. 通用接口约定"
      ],
      "acceptanceScenarioIds": [
        "ENF-02-AC-011"
      ]
    }
  ],
  "inputs": [
    {
      "name": "ruleDraft",
      "required": true,
      "rules": [
        "稳定编号、名称、中心分类、说明、结构化条件、适用数据源、可选模型任务和预期版本"
      ]
    },
    {
      "name": "condition",
      "required": true,
      "rules": [
        "已登记字段、允许运算符、比较值、AND/OR；评分型含合法范围阈值"
      ]
    },
    {
      "name": "trialSamples",
      "required": "试运行或发布前",
      "rules": [
        "来源、版本、中心确认期望、模拟或真实标记"
      ]
    },
    {
      "name": "trustedIdentity",
      "required": true,
      "rules": [
        "来自认证上下文"
      ]
    }
  ],
  "outputs": [
    {
      "name": "ruleVersion",
      "fields": [
        "ruleId",
        "version",
        "status",
        "classification",
        "conditions",
        "dataSourceRefs",
        "modelTask",
        "audit"
      ]
    },
    {
      "name": "trialResult",
      "fields": [
        "sampleId",
        "matched",
        "conditionDetails",
        "modelScoreWhenApplicable",
        "missingOrFailureReason",
        "ruleVersion",
        "inputVersion"
      ]
    },
    {
      "name": "evaluation",
      "fields": [
        "taskId",
        "sampleCount",
        "actualDenominator",
        "metrics",
        "sourceCorrectness",
        "errors",
        "ruleVersion",
        "modelVersion"
      ]
    }
  ],
  "permissions": [
    {
      "action": "manage_draft",
      "enforcement": "规则配置角色、机构范围及预期版本校验"
    },
    {
      "action": "trial_run",
      "enforcement": "校验样例、数据源和模型通道权限，不产生正式业务副作用"
    },
    {
      "action": "publish",
      "enforcement": "中心授权发布或审核角色，后端执行完整性与依赖校验"
    },
    {
      "action": "disable",
      "enforcement": "授权角色，阻止新任务并保留历史"
    },
    {
      "action": "read_versions_or_results",
      "enforcement": "按机构、数据源、样例敏感级别和历史访问授权过滤"
    }
  ],
  "states": [
    {
      "name": "草稿",
      "kind": "rule",
      "allowedNext": [
        "已发布"
      ],
      "actions": [
        "编辑",
        "复制",
        "试运行"
      ]
    },
    {
      "name": "已发布",
      "kind": "rule",
      "allowedNext": [
        "已停用"
      ],
      "invariant": "不可原地修改，运行固定版本"
    },
    {
      "name": "已停用",
      "kind": "rule",
      "allowedNext": [],
      "invariant": "不参与新任务，历史结果及版本保留"
    },
    {
      "name": "queued",
      "kind": "evaluation_task",
      "allowedNext": [
        "running",
        "cancelled",
        "failed"
      ]
    },
    {
      "name": "running",
      "kind": "evaluation_task",
      "allowedNext": [
        "succeeded",
        "partial_failed",
        "failed",
        "cancelled"
      ]
    },
    {
      "name": "succeeded",
      "kind": "evaluation_task",
      "allowedNext": []
    },
    {
      "name": "partial_failed",
      "kind": "evaluation_task",
      "allowedNext": [],
      "invariant": "列出未处理样例和实际分母"
    },
    {
      "name": "failed",
      "kind": "evaluation_task",
      "allowedNext": []
    },
    {
      "name": "cancelled",
      "kind": "evaluation_task",
      "allowedNext": []
    }
  ],
  "sourceAndVersionRules": [
    "规则采用稳定编号和不可变发布版本，修改形成新草稿。",
    "试运行与正式任务固定规则、模型、样例、数据源和输入版本。",
    "规则命中理由引用实际字段和值；来源和缺失原因不由模型补造。",
    "历史结果保留所用规则版本，发布新版或停用不得重写。",
    "模拟和真实样例、试运行及验收证据隔离并显式标记。",
    "上游资源变化不改写历史结果，受影响结果标记需复核。"
  ],
  "errorsAndExceptions": [
    {
      "case": "invalid_condition_or_threshold",
      "result": "阻止发布并返回字段路径和合法范围"
    },
    {
      "case": "arbitrary_executable_content",
      "result": "拒绝保存或发布，不执行任何脚本或外部目标"
    },
    {
      "case": "data_source_missing_or_unauthorized",
      "result": "拒绝试运行或发布并返回可区分原因"
    },
    {
      "case": "source_data_missing",
      "result": "记录资料缺失，不解释为不命中"
    },
    {
      "case": "model_or_source_failure",
      "result": "返回失败或部分失败，不产生正式线索"
    },
    {
      "case": "rule_not_applicable",
      "result": "明确返回不适用及依据，不与失败或未命中混同"
    },
    {
      "case": "version_conflict",
      "result": "拒绝覆盖并返回当前版本"
    },
    {
      "case": "partial_evaluation",
      "result": "列出未处理样例、失败原因和实际分母"
    }
  ],
  "decisionPoints": [
    {
      "id": "ENF-02-DEC-001",
      "owner": "AI",
      "description": "仅执行已发布配置中明确的语义分类任务并输出结构化候选分值；不得生成规则、权限或正式违法结论。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ]
    },
    {
      "id": "ENF-02-DEC-002",
      "owner": "RULE",
      "description": "确定性条件、阈值范围、组合、版本、权限、状态、发布校验和试运行副作用隔离由规则运行时执行。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则",
        "7. 验收要求"
      ]
    },
    {
      "id": "ENF-02-DEC-003",
      "owner": "HUMAN",
      "description": "中心人员确认违法分类、规则、阈值、样例和期望；授权人员执行发布、停用和专业验收。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "7. 验收要求",
        "8. 联调前需确认的条件"
      ]
    },
    {
      "id": "ENF-02-DEC-004",
      "owner": "AUTHORITY_SYSTEM",
      "description": "身份系统决定权限，中心数据服务提供真实源记录和授权范围；规则配置不得扩展这些权限。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "5. 服务接口需求"
      ]
    }
  ],
  "acceptanceScenarios": [
    {
      "id": "ENF-02-AC-001",
      "given": [
        "中心确认分类、数据源和合法结构化条件"
      ],
