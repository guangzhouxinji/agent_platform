  "sourceAndVersionRules": [
    "固定源记录批次版本、规则版本、模型版本和权限范围。",
    "同源同版本线索唯一，多规则作为命中明细。",
    "跨源疑似重复与人工确认关联分开。",
    "新源版本追加发现，不覆盖处置历史。",
    "线索处置、任务和通知状态分开。",
    "模拟源规则通知数据库与真实验收隔离。"
  ],
  "errorsAndExceptions": [
    {
      "case": "source_missing",
      "result": "记录源缺失，不计未命中"
    },
    {
      "case": "source_or_model_failure",
      "result": "任务失败或部分失败并列出对象"
    },
    {
      "case": "rule_not_applicable",
      "result": "明确规则不适用及版本"
    },
    {
      "case": "duplicate_execution",
      "result": "返回既有线索和任务，不重复通知"
    },
    {
      "case": "notification_failure",
      "result": "保留线索并有限重试"
    },
    {
      "case": "unauthorized",
      "result": "拒绝且不泄露其他机构线索"
    }
  ],
