  "clauses": [
    {
      "id": "ADJ-09-MUST-001",
      "type": "MUST",
      "statement": "在固定案件、证据、涉案产品和 ADJ-07 权利要求解析版本上，关联待证事实并逐必要技术特征生成证据报告及辅助侵权意见。",
      "sourceAnchors": [
        "1. 功能概述",
        "2. 字段与资料结构",
        "3. 证据管理与分析流程"
      ],
      "acceptanceScenarioIds": [
        "ADJ-09-AC-001"
      ]
    },
    {
      "id": "ADJ-09-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "证据事实、当事人主张、质证意见、系统推断和人工认定必须分开；系统不得自动认定真实性、证明力、采信或侵权成立。",
      "sourceAnchors": [
        "1. 功能概述",
        "2. 字段与资料结构"
      ],
      "acceptanceScenarioIds": [
        "ADJ-09-AC-001"
      ]
    },
    {
      "id": "ADJ-09-MUST-002",
      "type": "MUST",
      "statement": "可复用受控文件和证据目录组件，但裁决案件关系、证据状态、审核规则独立，禁止沿用执法处罚结论。",
      "sourceAnchors": [
        "1. 功能概述"
      ],
      "acceptanceScenarioIds": [
        "ADJ-09-AC-002"
      ]
    },
    {
      "id": "ADJ-09-MUST-003",
      "type": "MUST",
      "statement": "证据版本保存类型、原文件或实物位置、提供方、收集人时间方式、上传时间、哈希、权限、待证事实、争议和人工采信状态。",
      "sourceAnchors": [
        "2. 字段与资料结构"
      ],
      "acceptanceScenarioIds": [
        "ADJ-09-AC-003"
      ]
    },
    {
      "id": "ADJ-09-MUST_NOT-002",
      "type": "MUST_NOT",
      "statement": "上传时间不得替代收集时间，照片不得冒充实物或不可观察内部结构，哈希/OCR/模型分不得证明真实性合法性充分性。",
      "sourceAnchors": [
        "2. 字段与资料结构",
        "3. 证据管理与分析流程"
      ],
      "acceptanceScenarioIds": [
        "ADJ-09-AC-003"
      ]
    },
    {
      "id": "ADJ-09-MUST-004",
      "type": "MUST",
      "statement": "不可读文件保留原材料并进入异常清单；提取可观察事实时同时保留支持、反向、冲突和双方意见。",
      "sourceAnchors": [
        "3. 证据管理与分析流程"
      ],
      "acceptanceScenarioIds": [
        "ADJ-09-AC-004"
      ]
    },
    {
      "id": "ADJ-09-MUST-005",
      "type": "MUST",
      "statement": "用户确认产品技术方案、权利要求版本、证据集合以及已认定和争议事实；逐全部必要特征关联页码、图片区域或可靠位置。",
      "sourceAnchors": [
        "3. 证据管理与分析流程"
      ],
      "acceptanceScenarioIds": [
        "ADJ-09-AC-005"
      ]
    },
    {
      "id": "ADJ-09-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "不得只比较专利标题摘要，销售记录只支持相应交易事实而不自动证明内部结构，缺证不得生成完整结论。",
      "sourceAnchors": [
        "3. 证据管理与分析流程"
      ],
      "acceptanceScenarioIds": [
        "ADJ-09-AC-005"
      ]
    },
    {
      "id": "ADJ-09-MUST-006",
      "type": "MUST",
      "statement": "文字对应与可能等同问题分开展示；等同仅列技术事实、依据和待专业判断，不按固定相似度阈值认定。",
      "sourceAnchors": [
        "3. 证据管理与分析流程"
      ],
      "acceptanceScenarioIds": [
        "ADJ-09-AC-006"
      ]
    },
    {
      "id": "ADJ-09-MUST-007",
      "type": "MUST",
      "statement": "产品、方法和外观采用各自所需证据及分析分支；外观按视图和整体视觉流程，不套文本权项矩阵。",
      "sourceAnchors": [
        "3. 证据管理与分析流程"
      ],
      "acceptanceScenarioIds": [
        "ADJ-09-AC-006"
      ]
    },
    {
      "id": "ADJ-09-MUST-008",
      "type": "MUST",
      "statement": "同哈希材料只提示重复并保留不同提交来源；追加替换证据新建版本并使相关分析待更新，旧报告和人工意见保留。",
      "sourceAnchors": [
        "3. 证据管理与分析流程"
      ],
      "acceptanceScenarioIds": [
        "ADJ-09-AC-007"
      ]
    },
    {
      "id": "ADJ-09-MUST_NOT-004",
      "type": "MUST_NOT",
      "statement": "材料下载和模型上下文不得绕过案件权限，跨案使用须显式授权；文件解析不得执行宏或文本指令。",
      "sourceAnchors": [
        "5. 服务契约"
      ],
      "acceptanceScenarioIds": [
        "ADJ-09-AC-008"
      ]
    },
    {
      "id": "ADJ-09-MUST-012",
      "type": "MUST",
      "statement": "中心确认质证采信流程、材料类型、文件限制、各专利类型能力和专家样本，未确认分支不得标通过。",
      "sourceAnchors": [
        "7. 验收要求",
        "8. 依赖与交付"
      ],
      "acceptanceScenarioIds": [
        "ADJ-09-AC-011"
      ]
    },
    {
      "id": "ADJ-09-SEM-MUST-001",
      "type": "MUST",
      "statement": "本能力参与智能体任务时，一次工具执行成功、局部输出、通知或审核动作不直接认定整个用户业务目标完成；跨轮对象绑定稳定版本，纠正保留原目标与历史并重核依赖结果；人工接收须有实际记录，业务、任务、审核、正式状态分别表达。",
      "sourceAnchors": [
        "docs/02-待确认事项清单.md#23",
        "docs/01-总体需求与架构方案.md#5"
      ],
      "acceptanceScenarioIds": [
        "ADJ-09-SEM-AC-001"
      ]
    }
  ],
  "inputs": [
