  "sourceAndVersionRules": [
    "目标原始文字原图、标准化和人工确认值分开保存。",
    "固定分类版本、检索范围、数据源、候选、评分组合、模型和任务版本。",
    "各维度是否执行及评分分别保存，未分析不等于零。",
    "实际范围、有限候选、截断和失败维度显式披露。",
    "选定候选向下游传递固定源版本和输入快照。",
    "模拟图像检索、数据、DM8 和真实评测证据隔离。"
  ],
  "errorsAndExceptions": [
    {
      "case": "classification_or_item_missing",
      "result": "返回补充要求，不猜测类别项目"
    },
    {
      "case": "invalid_or_unauthorized_image",
      "result": "拒绝上传或访问且不泄露文件"
    },
    {
      "case": "requested_dimension_unavailable",
      "result": "明确不可用，可继续其他维度并标部分成功"
    },
    {
      "case": "source_failure_or_limit",
      "result": "返回失败来源和实际覆盖，不伪装无结果"
    },
    {
      "case": "no_result",
      "result": "仅说明确认范围内无候选，不输出注册结论"
    },
    {
      "case": "score_mapping_unavailable",
      "result": "返回稳定排序和标签，不编造数值"
    },
    {
      "case": "permission_revoked",
      "result": "阻止候选图样历史任务和下游快照读取"
    }
  ],
  "decisionPoints": [
    {
      "id": "CON-05-DEC-001",
      "owner": "AI",
      "description": "可建议文字标准化、读音含义、OCR 元素和候选解释；不得修改原图、猜分类、伪造维度分数或给出注册法律结论。",
      "sourceAnchors": [
        "3. 检索流程与规则",
        "4. 评分规则"
      ]
    },
    {
      "id": "CON-05-DEC-002",
      "owner": "RULE",
      "description": "执行文件校验、权限、分类范围、状态过滤、任务幂等、去重排序、维度组合和评分映射版本。",
      "sourceAnchors": [
        "3. 检索流程与规则",
        "4. 评分规则",
        "6. 服务契约"
      ]
    },
    {
      "id": "CON-05-DEC-003",
      "owner": "HUMAN",
      "description": "用户确认文字图像解析、类别项目、类似群、范围维度并选择候选；专家确认样本和阈值。",
      "sourceAnchors": [
        "2. 输入输出字段",
        "3. 检索流程与规则",
        "7. 验收要求"
      ]
    },
    {
      "id": "CON-05-DEC-004",
      "owner": "AUTHORITY_SYSTEM",
      "description": "中心提供授权商标数据、分类字典、文字图形检索能力、状态和权限范围。",
      "sourceAnchors": [
        "1. 功能概述",
        "8. 依赖与交付"
      ]
    }
  ],
  "acceptanceScenarios": [
