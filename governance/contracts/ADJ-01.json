    },
    {
      "id": "ADJ-01-MUST-005",
      "type": "MUST",
      "statement": "发布与实施时间分开；生效失效区间和效力状态以来源为依据，状态支持未生效、现行有效、已失效、已废止和无法核实。",
      "sourceAnchors": [
        "2. 字段与数据规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-01-AC-005"
      ]
    },
    {
      "id": "ADJ-01-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "缺少事实、版本、效力或来源时不得由模型推测补齐，也不得把无法核实自动映射为有效或失效。",
      "sourceAnchors": [
        "文首开发要求",
        "2. 字段与数据规则",
        "总览/5.1 身份和来源"
