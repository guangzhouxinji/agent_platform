        "ENF-07-AC-004",
        "ENF-07-AC-008"
      ]
    },
    {
      "id": "ENF-07-MUST-010",
      "type": "MUST",
      "statement": "审核状态为待审核、已确认和退回；授权人员可修订事实证据关系并提交、确认或退回，保留前后值、理由、人员和时间。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则",
        "5. 服务接口需求"
      ],
      "acceptanceScenarioIds": [
        "ENF-07-AC-006"
      ]
    },
    {
      "id": "ENF-07-MUST-011",
      "type": "MUST",
      "statement": "证据或规则版本变化后旧结果标记需复核；重跑生成新机器版本，不覆盖人工修订、审核记录或历史引用。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求",
        "总览/5. 审核与版本通用要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-07-AC-005",
