        "status",
        "templateVersion",
        "renderVersion",
        "docxRef",
        "pdfPreviewRef",
        "errors",
        "requestId"
      ]
    }
  ],
  "permissions": [
    {
      "action": "upload_or_edit",
      "enforcement": "模板配置角色、机构程序和文件权限"
    },
    {
      "action": "preview",
      "enforcement": "模板样例字体渲染资源权限"
    },
    {
      "action": "publish_or_disable",
      "enforcement": "授权发布角色、中心确认和当前版本"
    },
    {
      "action": "download_history",
      "enforcement": "当前模板范围及历史文件权限"
    }
  ],
  "states": [
    {
      "name": "草稿",
      "kind": "template",
      "allowedNext": [
        "已发布",
        "已停用"
      ]
    },
    {
      "name": "已发布",
      "kind": "template",
      "allowedNext": [
        "已停用"
      ],
      "invariant": "不可原地修改"
    },
    {
      "name": "已停用",
      "kind": "template",
      "allowedNext": []
    },
    {
      "name": "排队",
      "kind": "preview_task",
      "allowedNext": [
        "处理中",
        "失败",
        "取消"
      ]
    },
    {
      "name": "处理中",
      "kind": "preview_task",
      "allowedNext": [
        "成功",
        "部分成功",
        "失败",
        "取消"
      ]
    },
    {
      "name": "成功",
      "kind": "preview_task",
      "allowedNext": []
    },
    {
      "name": "部分成功",
      "kind": "preview_task",
      "allowedNext": [],
      "invariant": "未完整文件不得标成功"
    },
    {
      "name": "失败",
      "kind": "preview_task",
      "allowedNext": []
    },
    {
      "name": "取消",
      "kind": "preview_task",
      "allowedNext": []
    }
  ],
  "sourceAndVersionRules": [
    "模板版本固定中心来源、文件摘要、字段、版式、适用范围和渲染依赖。",
    "发布版本不可变，历史文书使用原模板版本。",
    "模板配置、预览任务和正式文书状态分开。",
    "DOCX 输出与 PDF 预览角色分开。",
    "模拟模板样例数据库渲染与真实验收隔离。"
  ],
  "errorsAndExceptions": [
    {
      "case": "unsupported_or_unsafe_file",
      "result": "拒绝文件且不执行宏脚本外链"
    },
    {
      "case": "placeholder_mismatch",
      "result": "返回精确占位和字段错误并阻止发布"
    },
    {
      "case": "render_partial_or_failed",
      "result": "返回段落表格字体错误，不标完整成功"
    },
    {
      "case": "scope_not_applicable",
      "result": "拒绝运行并返回机构地区程序环节不匹配"
    },
    {
      "case": "version_conflict",
      "result": "拒绝覆盖并返回当前模板版本"
    },
    {
      "case": "unauthorized",
      "result": "拒绝且不泄露模板文件预览历史"
    }
  ],
