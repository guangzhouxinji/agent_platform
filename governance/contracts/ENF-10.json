      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-10-AC-004"
      ]
    },
    {
      "id": "ENF-10-MUST-007",
      "type": "MUST",
      "statement": "如输出严重程度，规则必须定义因素、取值、证据、计算或映射和依据版本。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-10-AC-005"
      ]
    },
    {
      "id": "ENF-10-MUST_NOT-005",
      "type": "MUST_NOT",
      "statement": "缺少严重程度标准或证据时不得生成等级、分数或模型概率，只描述有来源的已知情节。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-10-AC-005"
