  "clauses": [
    {
      "id": "ADJ-11-MUST-001",
      "type": "MUST",
      "statement": "基于固定案件、人工确认法律引用、专利解析、有效性与证据分析以及指定已发布模板生成可修订的专利裁决报告初稿。",
      "sourceAnchors": [
        "1. 功能概述",
        "2. 字段与输入快照"
      ],
      "acceptanceScenarioIds": [
        "ADJ-11-AC-001"
      ]
    },
    {
      "id": "ADJ-11-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "模型任务成功、草稿生成成功、文件导出成功或人工复核通过均不得自动成为正式裁决文件、正式签发或办结。",
      "sourceAnchors": [
        "1. 功能概述",
        "3. 生成及修订流程",
        "4. 版本变更与文件生成"
      ],
      "acceptanceScenarioIds": [
        "ADJ-11-AC-001",
        "ADJ-11-AC-008"
      ]
    },
    {
      "id": "ADJ-11-MUST-002",
      "type": "MUST",
      "statement": "生成前固定案件资料、模板、实际采用的引用、解析、有效性、证据分析、模型和规则版本及各自确认状态。",
      "sourceAnchors": [
        "2. 字段与输入快照",
        "3. 生成及修订流程"
      ],
      "acceptanceScenarioIds": [
        "ADJ-11-AC-001"
      ]
    },
    {
      "id": "ADJ-11-MUST-003",
      "type": "MUST",
      "statement": "准备阶段列出缺失必填字段、待复核分析、引用冲突、无权材料、模板不适用项和依赖版本。",
      "sourceAnchors": [
        "3. 生成及修订流程",
        "6. 服务契约"
      ],
      "acceptanceScenarioIds": [
        "ADJ-11-AC-002"
      ]
    },
    {
      "id": "ADJ-11-MUST-004",
      "type": "MUST",
      "statement": "模板不需要的分析项按配置标为不适用；模板需要但缺失的内容形成缺项，可生成明确标识的不完整草稿但不得提交正式复核。",
      "sourceAnchors": [
        "1. 功能概述",
        "3. 生成及修订流程"
      ],
      "acceptanceScenarioIds": [
        "ADJ-11-AC-002"
      ]
    },
    {
      "id": "ADJ-11-MUST_NOT-002",
      "type": "MUST_NOT",
      "statement": "不得用模型推测、默认值、相似案件或其他来源补齐缺失事实、调查过程、质证记录、办理日期、事实认定、裁决结果、签章或正式文号。",
      "sourceAnchors": [
        "文首通用约束",
        "1. 功能概述",
        "3. 生成及修订流程"
      ],
      "acceptanceScenarioIds": [
        "ADJ-11-AC-003"
      ]
    },
    {
      "id": "ADJ-11-MUST-005",
      "type": "MUST",
      "statement": "案件事实、数字、主体和法条原文使用确定性数据填充；解释性段落可辅助生成，但每个关键事实、法条和意见必须关联实际来源及版本。",
      "sourceAnchors": [
        "2. 字段与输入快照",
        "3. 生成及修订流程"
      ],
      "acceptanceScenarioIds": [
        "ADJ-11-AC-003"
      ]
    },
    {
      "id": "ADJ-11-MUST-006",
      "type": "MUST",
      "statement": "未复核的证据分析在报告中保持辅助意见身份，不得叙述成机关认定事实或裁决结论。",
      "sourceAnchors": [
        "3. 生成及修订流程",
        "总览/4. 行政裁决业务边界"
      ],
      "acceptanceScenarioIds": [
        "ADJ-11-AC-003"
      ]
    },
    {
      "id": "ADJ-11-MUST-007",
      "type": "MUST",
      "statement": "保存结构化报告、稳定章节与段落 ID、引用锚点、来源映射、完整性状态、审核状态、人工责任人和模型执行主体。",
      "sourceAnchors": [
        "2. 字段与输入快照",
        "3. 生成及修订流程"
      ],
      "acceptanceScenarioIds": [
        "ADJ-11-AC-004"
      ]
    },
    {
      "id": "ADJ-11-MUST-008",
      "type": "MUST",
      "statement": "人工编辑产生新修订版本并保留原生成内容和差异；整篇或单章节重新生成先形成候选修订，预览差异并由人工确认采用。",
      "sourceAnchors": [
        "3. 生成及修订流程"
      ],
      "acceptanceScenarioIds": [
        "ADJ-11-AC-005"
      ]
    },
    {
      "id": "ADJ-11-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "重新生成不得覆盖人工修改、既有报告版本、来源映射或已确认引用。",
      "sourceAnchors": [
        "3. 生成及修订流程",
        "总览/5. 数据、版本与变更规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-11-AC-005"
      ]
    },
    {
      "id": "ADJ-11-MUST-009",
      "type": "MUST",
      "statement": "内容和来源校验通过后才可提交 ADJ-12 人工复核；实质内容修改创建新报告版本并重新审核。",
      "sourceAnchors": [
        "3. 生成及修订流程",
        "4. 版本变更与文件生成"
      ],
      "acceptanceScenarioIds": [
        "ADJ-11-AC-006"
      ]
    },
    {
      "id": "ADJ-11-MUST-010",
      "type": "MUST",
      "statement": "复核通过版本只锁定为待签发或办结确认材料，正式状态必须来自授权签发动作或中心权威系统真实回执。",
      "sourceAnchors": [
        "3. 生成及修订流程",
        "4. 版本变更与文件生成"
      ],
      "acceptanceScenarioIds": [
        "ADJ-11-AC-006",
        "ADJ-11-AC-008"
      ]
    },
    {
      "id": "ADJ-11-MUST-011",
      "type": "MUST",
      "statement": "案件、证据、引用、分析或模板变化后新报告使用新输入并使受影响草稿待复核，历史报告保持原输入快照。",
      "sourceAnchors": [
        "4. 版本变更与文件生成",
        "总览/5. 数据、版本与变更规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-11-AC-007"
      ]
    },
    {
      "id": "ADJ-11-MUST-012",
      "type": "MUST",
      "statement": "首版提供结构化报告、DOCX 和 PDF；每次输出固定同一内容版本、摘要值、模板和渲染配置，重复导出不得混入其他版本。",
      "sourceAnchors": [
        "4. 版本变更与文件生成"
      ],
      "acceptanceScenarioIds": [
        "ADJ-11-AC-008"
      ]
    },
    {
      "id": "ADJ-11-MUST-013",
      "type": "MUST",
      "statement": "草稿文件显式标注草稿，复核通过未签发文件标注对应状态；仅在中心认可模板及真实签发状态下形成终版输出。",
      "sourceAnchors": [
        "4. 版本变更与文件生成"
      ],
      "acceptanceScenarioIds": [
        "ADJ-11-AC-008"
      ]
    },
    {
      "id": "ADJ-11-MUST-014",
      "type": "MUST",
      "statement": "渲染失败只标记输出任务失败，不丢失结构化草稿；生成失败通过事务或可追踪补偿避免已采用孤立引用。",
      "sourceAnchors": [
        "3. 生成及修订流程",
        "4. 版本变更与文件生成",
        "6. 服务契约"
      ],
      "acceptanceScenarioIds": [
        "ADJ-11-AC-009"
      ]
    },
    {
      "id": "ADJ-11-MUST-016",
      "type": "MUST",
      "statement": "准备、生成、编辑、重生成、提交审核、导出、下载和历史查看均由后端实时检查案件、各输入来源、报告和文件权限。",
      "sourceAnchors": [
        "3. 生成及修订流程",
        "6. 服务契约"
      ],
      "acceptanceScenarioIds": [
        "ADJ-11-AC-011"
      ]
    },
    {
      "id": "ADJ-11-MUST_NOT-004",
      "type": "MUST_NOT",
      "statement": "旧文件链接、缓存、历史版本或页面按钮状态不得绕过当前权限。",
      "sourceAnchors": [
        "6. 服务契约",
        "总览/5. 数据、版本与变更规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-11-AC-011"
      ]
    },
    {
      "id": "ADJ-11-MUST_NOT-005",
      "type": "MUST_NOT",
      "statement": "内部页面不得承载生成、权限、审核或签发规则，也不得作为对外交付页面。",
      "sourceAnchors": [
        "文首交付边界",
        "总览/1. 建设与交付范围"
      ],
      "acceptanceScenarioIds": [
        "ADJ-11-AC-012"
      ]
    },
    {
      "id": "ADJ-11-MUST-019",
      "type": "MUST",
      "statement": "模型、渲染器、字体、DOCX/PDF 和文件访问必须在目标国产环境按确认样例和规模验证。",
      "sourceAnchors": [
        "7. 国产化与 DM8 要求",
        "8. 验收要求",
        "9. 依赖与交付"
      ],
      "acceptanceScenarioIds": [
        "ADJ-11-AC-013"
      ]
    },
    {
      "id": "ADJ-11-SEM-MUST-001",
      "type": "MUST",
      "statement": "本能力参与智能体任务时，一次工具执行成功、局部输出、通知或审核动作不直接认定整个用户业务目标完成；跨轮对象绑定稳定版本，纠正保留原目标与历史并重核依赖结果；人工接收须有实际记录，业务、任务、审核、正式状态分别表达。",
      "sourceAnchors": [
        "docs/02-待确认事项清单.md#23",
        "docs/01-总体需求与架构方案.md#5"
      ],
      "acceptanceScenarioIds": [
        "ADJ-11-SEM-AC-001"
      ]
    }
  ],
  "inputs": [
    {
      "name": "generationSelection",
      "required": true,
      "rules": [
        "案件版本、用途、固定发布模板和选定输入版本"
      ]
    },
    {
      "name": "confirmedManifest",
      "required": true,
      "rules": [
        "准备结果、缺项接受范围、权限检查和所有依赖摘要"
      ]
    },
    {
      "name": "revision",
      "required": "编辑时",
      "rules": [
        "报告版本、结构化内容、来源映射、人工身份和并发版本"
      ]
    },
    {
      "name": "regeneration",
      "required": "重生成时",
      "rules": [
        "整篇或章节范围、原版本、冻结输入和采用确认"
      ]
    },
    {
      "name": "exportRequest",
      "required": "导出时",
      "rules": [
        "固定报告版本、DOCX/PDF 格式、模板和渲染配置"
      ]
    },
    {
      "name": "idempotencyKey",
      "required": true,
      "rules": [
        "绑定调用方、操作及完整输入"
      ]
    }
  ],
  "outputs": [
    {
      "name": "preparation",
      "fields": [
        "completenessItems",
        "dependencyManifest",
        "reviewWarnings",
        "conflicts",
        "permissionGaps"
      ]
    },
    {
      "name": "generationTask",
      "fields": [
        "taskId",
        "status",
        "requestId",
        "inputManifest",
        "failedSteps"
      ]
    },
    {
      "name": "reportVersion",
      "fields": [
        "reportId",
        "version",
        "purpose",
        "structure",
        "content",
        "sourceMap",
        "completenessStatus",
        "reviewStatus",
        "signingStatus",
        "author",
        "modelActor"
      ]
    },
    {
      "name": "candidateRevision",
      "fields": [
        "baseVersion",
        "scope",
        "generatedCandidate",
        "diff",
        "adoptionStatus"
      ]
    },
    {
      "name": "exportTask",
      "fields": [
        "taskId",
        "reportVersion",
        "contentDigest",
        "renderConfig",
        "format",
        "fileRef",
        "status"
      ]
    }
  ],
  "permissions": [
    {
      "action": "prepare_or_generate",
      "enforcement": "案件、模板及每项输入来源的当前权限"
    },
    {
      "action": "edit_or_regenerate",
      "enforcement": "报告编辑角色、当前版本和来源读取权限"
    },
    {
      "action": "submit_review",
      "enforcement": "内容来源校验、完整性和 ADJ-12 复核权限"
    },
    {
      "action": "export_or_download",
      "enforcement": "报告、模板、引用及文件的实时权限"
    },
    {
      "action": "sign_or_complete",
      "enforcement": "仅授权签发动作或中心权威回执可推进正式状态"
    }
  ],
  "states": [
    {
      "name": "完整",
      "kind": "completeness",
      "allowedNext": [
        "受影响待复核"
      ]
    },
    {
      "name": "不完整",
      "kind": "completeness",
      "allowedNext": [
        "完整",
        "受影响待复核"
      ],
      "invariant": "不得提交正式复核"
    },
    {
      "name": "受影响待复核",
      "kind": "completeness",
