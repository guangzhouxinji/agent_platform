  "clauses": [
    {
      "id": "ENF-16-MUST-001",
      "type": "MUST",
      "statement": "仅结合固定版本的 ENF-11 分析、ENF-05 证据、ENF-15 规则、ENF-17 引用和经业务确认的事实生成可解释处罚建议供人工审核。",
      "sourceAnchors": [
        "1. 功能概述与交付范围",
        "2. 数据来源与依赖"
      ],
      "acceptanceScenarioIds": [
        "ENF-16-AC-001"
      ]
    },
    {
      "id": "ENF-16-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "建议、模型输出、规则计算或审核结果不得冒充正式处罚决定、送达、执行或收缴。",
      "sourceAnchors": [
        "1. 功能概述与交付范围",
        "8. 联调前需确认的条件"
      ],
      "acceptanceScenarioIds": [
        "ENF-16-AC-001"
      ]
    },
    {
      "id": "ENF-16-MUST-002",
      "type": "MUST",
      "statement": "生成前固定并校验案件、职权、程序、行为类型、规则及所有事实证据引用版本和权限；缺失与源失败分开。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-16-AC-002"
      ]
    },
    {
      "id": "ENF-16-MUST-003",
      "type": "MUST",
      "statement": "不适用行政处罚时返回有依据的不适用说明，不生成罚款建议。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-16-AC-003"
      ]
    },
    {
      "id": "ENF-16-MUST-004",
      "type": "MUST",
      "statement": "必要事实未经确认或关键证据不足时状态为待补充，列明缺口且不生成确定处罚金额。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-16-AC-004"
      ]
    },
    {
      "id": "ENF-16-MUST_NOT-002",
      "type": "MUST_NOT",
      "statement": "金额输入缺失不得默认按零、历史值或模型估计计算，待确认行为类别不得冒充已确认。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-16-AC-004"
      ]
    },
    {
      "id": "ENF-16-MUST-005",
      "type": "MUST",
      "statement": "确定性规则计算法定范围和可用裁量方案，展示每个因素、证据、公式、口径、单位和逐步结果。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-16-AC-005"
      ]
    },
    {
      "id": "ENF-16-MUST-006",
      "type": "MUST",
      "statement": "规则允许多个合理选择时输出带适用条件的并列方案，不自动选择其中之一。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-16-AC-005"
      ]
    },
    {
      "id": "ENF-16-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "模型只可撰写基于计算和证据的解释，不得决定数值、适用性、事实确认、审核或最终处罚。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "总览/5. AI、规则与人工边界"
      ],
      "acceptanceScenarioIds": [
        "ENF-16-AC-005"
      ]
    },
    {
      "id": "ENF-16-MUST-007",
      "type": "MUST",
      "statement": "人工调整记录理由、依据、操作者及新版本；越出确认法定范围时阻止确认为有效结果。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-16-AC-006"
      ]
    },
    {
      "id": "ENF-16-MUST-008",
      "type": "MUST",
      "statement": "生成、修订、审核和重跑均保留输入、规则、输出和人工意见版本，旧结果不被覆盖。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "5. 服务接口需求"
      ],
      "acceptanceScenarioIds": [
        "ENF-16-AC-006"
      ]
    },
    {
      "id": "ENF-16-MUST-012",
      "type": "MUST",
      "statement": "固定专业样例记录输入规则预期实际步骤证据和问题，专业预期由中心确认，未确认不标通过。",
      "sourceAnchors": [
