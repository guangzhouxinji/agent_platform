    },
    {
      "action": "disable",
      "enforcement": "授权停用角色和原因"
    },
    {
      "action": "consume",
      "enforcement": "运行时仅返回范围内可用要点"
    }
  ],
  "states": [
    {
      "name": "待核实",
      "kind": "availability",
      "allowedNext": [
        "可用",
        "停用"
      ]
    },
    {
      "name": "可用",
      "kind": "availability",
      "allowedNext": [
