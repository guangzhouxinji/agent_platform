  "clauses": [
    {
      "id": "CON-12-MUST-001",
      "type": "MUST",
      "statement": "服务管理多轮咨询的会话、消息、当前分析对象、补问、工具任务、回复引用、复核或转接提示和结束流程，并提供可独立调用的会话与消息接口。",
      "sourceAnchors": [
        "1. 功能概述",
        "7. 服务契约"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-001",
        "CON-12-AC-014"
      ]
    },
    {
      "id": "CON-12-MUST-002",
      "type": "MUST",
      "statement": "首版使用可配置固定流程和场景分支，不要求通用拖拽流程设计器。",
      "sourceAnchors": [
        "1. 功能概述"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-011"
      ]
    },
    {
      "id": "CON-12-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "模型不得任意访问数据源，只能建议或调用当前已发布配置允许且经运行时鉴权的工具。",
      "sourceAnchors": [
        "1. 功能概述",
        "4. 状态、并发与上下文规则"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-009"
      ]
    },
    {
      "id": "CON-12-MUST-003",
      "type": "MUST",
      "statement": "会话使用稳定编号和不可重名归属标识；创建时固定智能体、提示词、意图和对话流发布版本，同时实时检查权限、暂停及紧急撤销。",
      "sourceAnchors": [
        "2. 数据字段",
        "3. 标准对话流程"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-001",
        "CON-12-AC-010"
      ]
    },
    {
      "id": "CON-12-MUST_NOT-002",
      "type": "MUST_NOT",
      "statement": "不得以可重名用户名判断会话归属，也不得因会话固定配置版本而跳过实时权限或撤销检查。",
      "sourceAnchors": [
        "2. 数据字段"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-009",
        "CON-12-AC-010"
      ]
    },
    {
      "id": "CON-12-MUST-004",
      "type": "MUST",
      "statement": "会话业务状态为进行中、已结束、已过期；当前阶段与消息处理状态单独记录，不得相互代替。",
      "sourceAnchors": [
        "2. 数据字段",
        "4. 状态、并发与上下文规则"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-005",
        "CON-12-AC-010"
      ]
    },
    {
      "id": "CON-12-MUST-005",
      "type": "MUST",
      "statement": "用户、助手、工具和系统事件消息分别记录消息 ID、角色、原始内容、事件顺序、时间、请求或工具任务 ID、状态和追踪信息。",
      "sourceAnchors": [
        "2. 数据字段"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-005",
        "CON-12-AC-006"
      ]
    },
    {
      "id": "CON-12-MUST-006",
      "type": "MUST",
      "statement": "一条接受成功的用户消息计一轮，工具消息不另计；重复提交、重连和失败重试不得重复计轮或重复记录用户提问。",
      "sourceAnchors": [
        "2. 数据字段",
        "4. 状态、并发与上下文规则",
        "5. 异常、复核与转接"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-005"
      ]
    },
    {
      "id": "CON-12-MUST-007",
      "type": "MUST",
      "statement": "收到用户消息后识别意图并检查必要信息；缺失或指代不清时补问，已确认信息不无故重复索要。",
      "sourceAnchors": [
        "3. 标准对话流程"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-001"
      ]
    },
    {
      "id": "CON-12-MUST-008",
      "type": "MUST",
      "statement": "信息齐全后调用相应查询、检索或比对服务，并记录实际输入、任务 ID、执行状态及固定版本。",
      "sourceAnchors": [
        "2. 数据字段",
        "3. 标准对话流程"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-001",
        "CON-12-AC-004"
      ]
    },
    {
      "id": "CON-12-MUST-009",
      "type": "MUST",
      "statement": "回复仅依据真实工具结果，区分检索发现、辅助意见和待核实事项，并附可解析到资源、版本及段落或页码的引用。",
      "sourceAnchors": [
        "2. 数据字段",
        "3. 标准对话流程",
        "总目录/3.5 评分及专业意见"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-004"
      ]
    },
    {
      "id": "CON-12-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "没有有效来源时不得生成虚构法条、案例、办理要求或数据事实；源故障不得解释为不存在相关权利、案例或资料。",
      "sourceAnchors": [
        "3. 标准对话流程",
        "5. 异常、复核与转接"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-004",
        "CON-12-AC-008"
      ]
    },
    {
      "id": "CON-12-MUST-010",
      "type": "MUST",
      "statement": "后续提问可沿用已确认当前对象；切换对象或更正关键事实时更新槽位，并显式使依赖旧事实或对象的分析失效。",
      "sourceAnchors": [
        "3. 标准对话流程"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-002"
      ]
    },
    {
      "id": "CON-12-MUST-011",
      "type": "MUST",
      "statement": "序数指代必须绑定上一轮实际展示的结果集、顺序和版本；存在多个可能对象时必须追问。",
      "sourceAnchors": [
        "3. 标准对话流程"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-003"
      ]
    },
    {
      "id": "CON-12-MUST_NOT-004",
      "type": "MUST_NOT",
      "statement": "不得依据后来变化的当前列表重新解释“第二个”等历史指代。",
      "sourceAnchors": [
        "3. 标准对话流程"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-003"
      ]
    },
    {
      "id": "CON-12-MUST-012",
      "type": "MUST",
      "statement": "用户结束或会话到期后关闭新输入；历史仅按当前权限查看；继续咨询新建会话并只显式继承获准资料。",
      "sourceAnchors": [
        "3. 标准对话流程",
        "4. 状态、并发与上下文规则"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-010"
      ]
    },
    {
      "id": "CON-12-MUST-013",
      "type": "MUST",
      "statement": "消息状态为已接收、处理中、完成、失败和取消；首版同一会话至多一条用户消息处理中，其他新消息返回忙碌。",
      "sourceAnchors": [
        "4. 状态、并发与上下文规则"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-005"
      ]
    },
    {
      "id": "CON-12-MUST-014",
      "type": "MUST",
      "statement": "幂等键绑定用户、会话和请求内容；同键同内容返回原消息，同键不同内容返回冲突并避免重复工具执行。",
      "sourceAnchors": [
        "4. 状态、并发与上下文规则",
        "总目录/3.3 异步任务契约"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-005"
      ]
    },
    {
      "id": "CON-12-MUST-015",
      "type": "MUST",
      "statement": "网络断开不默认取消服务端任务；重连按消息 ID 和事件位置恢复最新状态与内容。",
      "sourceAnchors": [
        "4. 状态、并发与上下文规则",
        "7. 服务契约"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-006"
      ]
    },
    {
      "id": "CON-12-MUST-016",
      "type": "MUST",
      "statement": "流式输出提供有序事件或恢复标识；中断内容标为未完成，最终回复只落一条完成记录。",
      "sourceAnchors": [
        "4. 状态、并发与上下文规则"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-006"
      ]
    },
    {
      "id": "CON-12-MUST-017",
      "type": "MUST",
      "statement": "用户取消后停止后续步骤；迟到工具结果仅可受控审计，不作为本轮新完成答复发布。",
      "sourceAnchors": [
        "4. 状态、并发与上下文规则"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-005"
      ]
    },
    {
      "id": "CON-12-MUST-018",
      "type": "MUST",
      "statement": "上下文容量不足时摘要保留已确认事实、对象版本和证据来源；不能可靠保留的关键材料重新获取或请求用户确认。",
      "sourceAnchors": [
        "4. 状态、并发与上下文规则"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-007"
      ]
    },
    {
      "id": "CON-12-MUST_NOT-005",
      "type": "MUST_NOT",
      "statement": "上下文摘要不得把推测变成确认事实、丢失关键来源，或用无法验证的摘要继续形成结论。",
      "sourceAnchors": [
        "4. 状态、并发与上下文规则"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-007"
      ]
    },
    {
      "id": "CON-12-MUST-019",
      "type": "MUST",
      "statement": "同一用户不同会话默认隔离，不同用户和组织在检索、附件及消息读取阶段隔离；用户数据和文献中的指令仅作为数据。",
      "sourceAnchors": [
        "4. 状态、并发与上下文规则",
        "总目录/3.2 来源、版本和权限"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-007",
        "CON-12-AC-009"
      ]
    },
    {
      "id": "CON-12-MUST_NOT-006",
      "type": "MUST_NOT",
      "statement": "用户或文献内容不得覆盖系统权限、改变系统规则或诱导调用未授权工具。",
      "sourceAnchors": [
        "4. 状态、并发与上下文规则"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-009"
      ]
    },
    {
      "id": "CON-12-MUST-020",
      "type": "MUST",
      "statement": "会话有效期以及消息和附件保留期限可配置并执行中心批准策略；过期与删除分开，删除规则另行配置。",
      "sourceAnchors": [
        "4. 状态、并发与上下文规则"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-010"
      ]
    },
    {
      "id": "CON-12-MUST-021",
      "type": "MUST",
      "statement": "工具无结果、工具故障和资料不足分别答复；部分成功仅返回有依据部分并标明未完成范围。",
      "sourceAnchors": [
        "5. 异常、复核与转接",
        "总目录/3.3 异步任务契约"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-008"
      ]
    },
    {
      "id": "CON-12-MUST-022",
      "type": "MUST",
      "statement": "需正式采用的判断进入复核提示或已配置复核流程，AI 回复本身不得变成正式决定。",
      "sourceAnchors": [
        "5. 异常、复核与转接",
        "总目录/3.5 评分及专业意见"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-008"
      ]
    },
    {
      "id": "CON-12-MUST-023",
      "type": "MUST",
      "statement": "人工转接未接通时只展示中心配置的办理指引；真实转接成功必须由权威受理系统返回受理编号和状态。",
      "sourceAnchors": [
        "5. 异常、复核与转接"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-012"
      ]
    },
    {
      "id": "CON-12-MUST_NOT-007",
      "type": "MUST_NOT",
      "statement": "未获真实受理回执不得显示已转人工或已受理，也不默认发送外部通知。",
      "sourceAnchors": [
        "5. 异常、复核与转接"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-012"
      ]
    },
    {
      "id": "CON-12-MUST-024",
      "type": "MUST",
      "statement": "智能体暂停或依赖配置紧急撤销时阻止后续工具调用并返回可识别状态；失败重试建立关联处理尝试。",
      "sourceAnchors": [
        "5. 异常、复核与转接"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-010"
      ]
    },
    {
      "id": "CON-12-MUST-025",
      "type": "MUST",
      "statement": "流程草稿可配置场景入口、补问、工具、回复、异常回退和结束节点；发布校验唯一入口、节点可达、异常出口、循环上限和引用版本有效。",
      "sourceAnchors": [
        "6. 流程配置与内部验证页面"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-011"
      ]
    },
    {
      "id": "CON-12-MUST-026",
      "type": "MUST",
      "statement": "已发布流程不可原地编辑，新版由智能体显式绑定后生效。",
      "sourceAnchors": [
        "6. 流程配置与内部验证页面",
        "总目录/3.4 配置引用与发布"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-011"
      ]
    },
    {
      "id": "CON-12-MUST-028",
      "type": "MUST",
      "statement": "后端对每个会话和受控附件引用检查稳定归属及当前权限，不能只凭客户端提供的 ID 放行。",
      "sourceAnchors": [
        "7. 服务契约"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-009"
      ]
    },
    {
      "id": "CON-12-MUST-029",
      "type": "MUST",
      "statement": "模型错误、工具失败、忙碌、过期、暂停、参数错误和越权返回可区分错误及追踪号。",
      "sourceAnchors": [
        "7. 服务契约"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-008",
        "CON-12-AC-010"
      ]
    },
    {
      "id": "CON-12-MUST-031",
      "type": "MUST",
      "statement": "首批场景、上下文预算、超时、循环上限、保留策略、人工受理接口、并发和响应时间目标须经中心确认后作为正式配置或验收依据。",
      "sourceAnchors": [
        "9. 依赖与交付"
      ],
      "acceptanceScenarioIds": [
        "CON-12-AC-015"
      ]
    }
  ],
  "inputs": [
    {
      "name": "createSession",
      "required": true,
      "rules": [
        "智能体稳定 ID 与可信身份上下文"
      ]
    },
    {
      "name": "userMessage",
      "required": true,
      "rules": [
        "会话 ID、内容、受控附件引用、幂等键"
      ]
    },
    {
      "name": "eventCursor",
      "required": false,
      "rules": [
        "用于有序恢复，不能由当前页面状态代替"
      ]
    },
    {
      "name": "cancelOrEnd",
      "required": "操作时",
      "rules": [
        "会话或消息 ID、动作、原因和预期状态"
      ]
    },
    {
      "name": "flowDraft",
      "required": "配置时",
      "rules": [
        "固定版本、节点、条件、工具稳定 ID、异常、超时、回退、循环上限"
      ]
    }
  ],
  "outputs": [
    {
      "name": "session",
      "fields": [
        "sessionId",
        "ownerId",
        "organizationId",
        "businessStatus",
        "currentStage",
        "boundVersions",
        "startedAt",
        "endedAt",
        "endReason"
      ]
    },
    {
      "name": "message",
      "fields": [
        "messageId",
        "role",
        "content",
        "turn",
        "processingStatus",
        "attempts",
        "requestId",
        "taskIds",
        "traceId"
      ]
    },
    {
      "name": "contextSnapshot",
      "fields": [
        "confirmedSlots",
        "currentObjectVersions",
        "invalidatedAnalyses",
        "sourceMessageIds",
        "evidenceReferences",
        "summaryVersion"
      ]
    },
    {
      "name": "event",
      "fields": [
        "sequence",
        "resumeToken",
        "type",
        "payload",
        "completion"
      ]
    },
    {
      "name": "reply",
      "fields": [
        "content",
        "findingTypes",
        "unverifiedItems",
        "citations",
        "completionStatus",
        "runManifest"
      ]
    }
  ],
  "permissions": [
    {
      "action": "create_session",
      "enforcement": "服务端校验真实身份、智能体状态和使用权限"
    },
    {
      "action": "send_or_cancel_message",
      "enforcement": "校验会话归属、组织范围、当前状态和附件引用"
    },
    {
      "action": "read_history_or_citation",
      "enforcement": "每次读取重新检查当前权限及源撤回状态"
    },
    {
      "action": "invoke_tool",
      "enforcement": "运行时校验用户、智能体、流程、工具、参数和资源权限"
    },
    {
