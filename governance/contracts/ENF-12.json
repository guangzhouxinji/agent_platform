  "clauses": [
    {
      "id": "ENF-12-MUST-001",
      "type": "MUST",
      "statement": "管理中心认可且按机构、地区、程序和执法环节限定的文书版式、章节、字段、填写规则和不可变模板版本。",
      "sourceAnchors": [
        "1. 功能概述与交付范围",
        "2. 数据来源与依赖",
        "3. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "ENF-12-AC-001"
      ]
    },
    {
      "id": "ENF-12-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "未获中心确认的样例、内部模板或通用模板不得标称正式执法文书模板或跨范围使用。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "8. 联调前需确认的条件"
      ],
      "acceptanceScenarioIds": [
        "ENF-12-AC-001"
      ]
    },
    {
      "id": "ENF-12-MUST-002",
      "type": "MUST",
      "statement": "首版支持 DOCX 模板上传、占位字段配置和 DOCX 输出，PDF 仅作为可选预览转换。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-12-AC-002"
      ]
    },
    {
      "id": "ENF-12-MUST_NOT-002",
      "type": "MUST_NOT",
      "statement": "首版不得扩大为在线富文本或通用可视化排版设计器；自定义版式通过上传新模板版本完成。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-12-AC-002"
      ]
    },
    {
      "id": "ENF-12-MUST-003",
      "type": "MUST",
      "statement": "模板保存唯一编号、名称、执法环节、结构、必填字段、格式、适用范围、状态、发布版本和完整审计。",
      "sourceAnchors": [
        "3. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "ENF-12-AC-003"
      ]
    },
    {
      "id": "ENF-12-MUST-004",
      "type": "MUST",
      "statement": "每个字段定义名称、类型、必填性、重复段落和展示格式；占位符稳定唯一且与字段配置一致。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-12-AC-003"
      ]
    },
    {
      "id": "ENF-12-MUST-005",
      "type": "MUST",
      "statement": "中心模板及填写说明保存稳定来源和版本并校验关联、适用范围与权限；源缺失和调用失败分开。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "3. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "ENF-12-AC-003"
      ]
    },
    {
      "id": "ENF-12-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "来源、业务编号、正式字段、版式和填写规则不得由模型生成或替换。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "总览/5. AI、规则与人工边界"
      ],
      "acceptanceScenarioIds": [
        "ENF-12-AC-003"
      ]
    },
    {
      "id": "ENF-12-MUST-006",
      "type": "MUST",
      "statement": "样例填充固定模板、字段和渲染版本，验证遗漏占位符、未定义字段、重复标识、重复段落、异常表格和中文长文本。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-12-AC-004"
      ]
    },
    {
      "id": "ENF-12-MUST-007",
      "type": "MUST",
      "statement": "渲染失败或部分完成返回具体字段、段落、表格或环境错误，不把未完成文件标为成功。",
      "sourceAnchors": [
        "5. 服务接口需求",
        "总览/4. 服务、任务与错误契约"
      ],
      "acceptanceScenarioIds": [
        "ENF-12-AC-004"
      ]
    },
    {
      "id": "ENF-12-MUST-008",
      "type": "MUST",
      "statement": "发布前检查模板文件、适用范围、全部占位字段、必填规则、格式依赖和中心确认状态。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "5. 服务接口需求"
      ],
      "acceptanceScenarioIds": [
        "ENF-12-AC-005"
      ]
    },
    {
      "id": "ENF-12-MUST-009",
      "type": "MUST",
      "statement": "已发布模板不可覆盖，修改上传新草稿和版本；停用限制新文书，旧文书继续绑定原模板版式。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-12-AC-005"
      ]
    },
    {
      "id": "ENF-12-MUST_NOT-004",
      "type": "MUST_NOT",
      "statement": "正式文号和签章区域只能预留，模板服务和模型不得自动分配文号、生成签章或执行签署。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-12-AC-006"
      ]
    },
    {
      "id": "ENF-12-MUST-011",
      "type": "MUST",
      "statement": "模板文件、预览、字段配置和历史版本由后端按机构程序及角色实时鉴权，附件宏脚本和外链不得执行。",
      "sourceAnchors": [
        "5. 服务接口需求",
        "总览/2. 数据、身份、权限与审计"
      ],
      "acceptanceScenarioIds": [
        "ENF-12-AC-007"
      ]
    },
    {
      "id": "ENF-12-MUST-014",
      "type": "MUST",
      "statement": "DOCX 与可选 PDF 转换、中文字体、表格和重复段落必须在目标国产环境按中心样例验证，不默认依赖 Windows Office 或外部 SaaS。",
      "sourceAnchors": [
        "7. 验收要求",
        "8. 联调前需确认的条件",
        "总览/7. 国产化与达梦 DM8"
      ],
      "acceptanceScenarioIds": [
        "ENF-12-AC-009"
      ]
    },
    {
      "id": "ENF-12-MUST-015",
      "type": "MUST",
      "statement": "固定中心样例记录模板、字段、字体、渲染器、DM8、环境、预期实际文件对照和问题编号；未确认模板环境不升级验收。",
      "sourceAnchors": [
        "7. 验收要求",
        "8. 联调前需确认的条件"
      ],
      "acceptanceScenarioIds": [
        "ENF-12-AC-010"
      ]
    }
  ],
  "inputs": [
    {
      "name": "templateUpload",
      "required": true,
      "rules": [
        "DOCX 文件、中心来源版本、适用范围和内容摘要"
      ]
    },
    {
      "name": "fieldConfiguration",
      "required": true,
      "rules": [
        "占位符、类型、必填、重复段落和展示格式"
      ]
    },
    {
      "name": "sampleData",
      "required": "预览时",
      "rules": [
        "明确模拟真实标识并覆盖长文本表格重复段落"
      ]
    },
    {
      "name": "lifecycleAction",
      "required": "发布停用时",
      "rules": [
        "模板版本、动作、意见、可信身份和并发版本"
      ]
    }
  ],
  "outputs": [
    {
      "name": "templateVersion",
      "fields": [
        "templateId",
        "version",
        "name",
        "scope",
        "stage",
        "fileRef",
        "contentDigest",
        "fields",
        "format",
        "status",
        "audit"
