    {
      "case": "interview_record_missing",
      "result": "阻止生成问答过程和签名"
    },
    {
      "case": "template_version_changed",
      "result": "规则待复核并要求重新验证"
    },
    {
      "case": "partial_dry_run",
      "result": "列出未处理项不标完整成功"
    },
    {
      "case": "unauthorized",
      "result": "拒绝且不泄露模板案件证据分析"
    }
  ],
