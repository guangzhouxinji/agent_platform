  "sourceAndVersionRules": [
    "固定目标候选原文、权利要求、视图、日期地域、特征、模型和规则版本。",
    "特征原文与人工修订分开，逐项结果定位具体文献版本。",
    "检索相关度、技术对照分数、法律结论和专家评测分开。",
    "每个候选独立状态，重试和新输入不覆盖历史结果。",
    "模型原始报告与人工复核意见分开保存。",
    "模拟数据、模型、DM8 和真实验收证据隔离。"
  ],
  "errorsAndExceptions": [
    {
      "case": "claim_or_fulltext_missing",
      "result": "返回缺口，不用摘要替代"
    },
    {
      "case": "claim_dependency_parse_failed",
      "result": "标记未执行并要求人工核对层级"
    },
    {
      "case": "design_views_insufficient",
      "result": "列出缺失视图，不形成完整外观意见"
    },
    {
      "case": "candidate_partial_failure",
      "result": "保留其他候选结果并标部分成功"
    },
    {
      "case": "score_not_calibrated",
      "result": "返回标签和对照表，不编数值"
    },
    {
      "case": "version_conflict",
      "result": "拒绝覆盖并返回当前报告版本"
    },
    {
      "case": "unauthorized_or_withdrawn",
      "result": "拒绝且不从历史或缓存泄露"
    }
  ],
  "decisionPoints": [
    {
      "id": "CON-06-DEC-001",
      "owner": "AI",
      "description": "提取候选技术特征、逐项对应和辅助解释；不得补全文视图日期、拼接文献、猜分或作法律结论。",
      "sourceAnchors": [
        "1. 功能概述与边界",
        "3. 分析流程"
      ]
    },
    {
      "id": "CON-06-DEC-002",
      "owner": "RULE",
      "description": "执行对象类型流程、输入完整性、权利要求依赖、权限、逐对状态、评分规则、版本和任务。",
      "sourceAnchors": [
        "2. 字段与输入校验",
        "3. 分析流程",
        "6. 服务契约与异常"
      ]
    },
    {
      "id": "CON-06-DEC-003",
      "owner": "HUMAN",
      "description": "用户确认对象范围特征和修订，中心专业人员复核意见并确认评分与验收标准。",
      "sourceAnchors": [
        "3. 分析流程",
        "4. 输出与评分",
        "7. 验收要求"
      ]
    },
    {
      "id": "CON-06-DEC-004",
      "owner": "AUTHORITY_SYSTEM",
      "description": "中心提供专利全文版本、视图、法规审查资料、权限和正式采用渠道。",
      "sourceAnchors": [
        "1. 功能概述与边界",
        "8. 依赖与交付"
      ]
    }
  ],
  "acceptanceScenarios": [
    {
      "id": "CON-06-AC-001",
      "given": [
        "检索候选或用户直接指定文献"
      ],
      "when": "创建技术对照",
      "then": [
        "选定版本重新鉴权",
        "逐项解释而非再次检索",
        "不输出确定法律结论"
      ],
      "sourceClauseIds": [
        "CON-06-MUST-001",
        "CON-06-MUST_NOT-001"
      ]
    },
    {
      "id": "CON-06-AC-002",
      "given": [
        "发明实用新型及视图完整或不足的外观设计"
      ],
      "when": "选择流程",
      "then": [
        "对象流程分离",
        "外观不复用文本分数",
        "视图不足阻止完整结论"
      ],
      "sourceClauseIds": [
        "CON-06-MUST-002",
        "CON-06-MUST_NOT-002",
        "CON-06-MUST-007"
      ]
    },
    {
      "id": "CON-06-AC-003",
      "given": [
        "法律目的但日期地域缺失、权利要求缺失或 OCR 差"
      ],
      "when": "分析准备",
      "then": [
        "固定已有版本",
        "逐项返回缺口",
        "不默认法域日期或用摘要模型补齐"
      ],
      "sourceClauseIds": [
        "CON-06-MUST-003",
        "CON-06-MUST_NOT-003",
        "CON-06-MUST-004"
      ]
    },
    {
      "id": "CON-06-AC-004",
      "given": [
        "含从属权利要求和未找到无法判断特征"
      ],
      "when": "确认特征并逐项分析",
      "then": [
        "前项特征完整展开",
        "原文定位可核对",
        "未找到与无法判断分开"
      ],
      "sourceClauseIds": [
        "CON-06-MUST_NOT-004",
        "CON-06-MUST-005",
        "CON-06-MUST-006"
      ]
    },
    {
      "id": "CON-06-AC-005",
      "given": [
        "两篇文献分别覆盖不同特征和技术文本相似样例"
      ],
      "when": "生成辅助意见",
      "then": [
        "逐篇结果分开",
        "不拼接成单篇公开",
        "不把文本相似变成落入保护范围"
