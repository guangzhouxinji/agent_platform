  "clauses": [
    {
      "id": "ADJ-02-MUST-001",
      "type": "MUST",
      "statement": "统一承接既有条文解析的一次性结构化导入、解析适配器接收、维护、完整列表和独立审核，不重复建设另一套来源库。",
