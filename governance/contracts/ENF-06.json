      "case": "duplicate_or_empty_mapping",
      "result": "阻止发布并定位冲突"
    },
    {
      "case": "basis_missing_or_expired",
      "result": "阻止发布或标待复核"
    },
    {
      "case": "rule_not_applicable",
      "result": "返回案件类型不匹配"
    },
    {
      "case": "partial_dry_run",
      "result": "列出未处理项不标完整成功"
    },
    {
      "case": "unauthorized",
      "result": "拒绝且不泄露规则依据证据"
    }
  ],
