  "clauses": [
    {
      "id": "ENF-08-MUST-001",
      "type": "MUST",
      "statement": "配置中心确认的执法程序、环节前置要求、必要字段材料和时限计算规则，并按地区、机构、程序及有效期间限定适用范围。",
      "sourceAnchors": [
        "1. 功能概述与交付范围",
        "2. 数据来源与依赖",
        "3. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "ENF-08-AC-001"
      ]
    },
    {
      "id": "ENF-08-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "不得预设未核实法定期限、地区口径、程序顺序、例外或工作日历，也不得将一套规则默认用于所有程序。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "8. 联调前需确认的条件"
      ],
      "acceptanceScenarioIds": [
        "ENF-08-AC-001",
        "ENF-08-AC-007"
      ]
    },
    {
      "id": "ENF-08-MUST-002",
      "type": "MUST",
      "statement": "规则保存唯一编号、名称、适用环节与范围、校验内容、条件时限、依据有效期、例外、不可变发布版本、机构和审计信息。",
      "sourceAnchors": [
        "3. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "ENF-08-AC-002"
      ]
    },
    {
      "id": "ENF-08-MUST-003",
      "type": "MUST",
      "statement": "规范、地区口径、工作日历及法规条文均保存稳定 ID 与版本；接入校验关联、有效性和权限，缺失与源调用失败分开。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "3. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "ENF-08-AC-002"
      ]
    },
    {
      "id": "ENF-08-MUST_NOT-002",
      "type": "MUST_NOT",
      "statement": "规则来源、法律依据、日历、事件时间和业务编号不得由模型生成或替换。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "总览/5. AI、规则与人工边界"
      ],
      "acceptanceScenarioIds": [
        "ENF-08-AC-002"
      ]
    },
    {
      "id": "ENF-08-MUST-004",
      "type": "MUST",
      "statement": "必填校验、环节顺序、适用条件和日期计算必须作为可审计的确定性规则执行；模型只可解释已有规则和计算步骤。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-08-AC-003"
      ]
    },
    {
      "id": "ENF-08-MUST-005",
      "type": "MUST",
      "statement": "时限规则明确自然日或工作日、起算事件、起算日是否计入、截止调整、延期和中止条件及恢复方式。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-08-AC-003"
      ]
    },
    {
      "id": "ENF-08-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "模型输出、提示词、当前日期或通用日历不得参与确定期限数值、起算点、截止调整或例外是否成立。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "总览/5. AI、规则与人工边界"
      ],
      "acceptanceScenarioIds": [
        "ENF-08-AC-003"
      ]
    },
    {
      "id": "ENF-08-MUST-006",
      "type": "MUST",
      "statement": "日期试算固定事件、例外、规则和工作日历版本，输出截止时间、逐步计算轨迹、适用依据和缺口。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "5. 服务接口需求"
      ],
      "acceptanceScenarioIds": [
        "ENF-08-AC-004"
      ]
    },
    {
      "id": "ENF-08-MUST-007",
      "type": "MUST",
      "statement": "发布前执行边界样例试算，并检查同一适用范围的冲突规则、起算点、日历、完整公式、依据和有效期间。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-08-AC-005"
      ]
    },
    {
      "id": "ENF-08-MUST-008",
      "type": "MUST",
      "statement": "冲突、缺少起算点或日历、公式不完整、依据失效和适用范围不明均阻止发布并返回具体位置。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-08-AC-005"
      ]
    },
    {
      "id": "ENF-08-MUST-009",
      "type": "MUST",
      "statement": "发布版本不可原地修改，编辑创建新草稿；停用或过期规则不用于新校验，历史结果继续引用原规则和日历版本。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-08-AC-006"
      ]
    },
    {
      "id": "ENF-08-MUST-010",
      "type": "MUST",
      "statement": "历史案件按事件时点筛选候选规则版本并保留人工业务确认，不因存在现行规则自动认定历史适用版本。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-08-AC-006"
      ]
    },
    {
      "id": "ENF-08-MUST-014",
      "type": "MUST",
      "statement": "固定边界样例记录输入事件、例外、地区程序、规则日历依据版本、中心预期、实际轨迹和问题编号；未确认规则不升级验收。",
      "sourceAnchors": [
        "7. 验收要求",
        "8. 联调前需确认的条件"
      ],
      "acceptanceScenarioIds": [
        "ENF-08-AC-010"
      ]
    },
    {
      "id": "ENF-08-SEM-MUST-001",
      "type": "MUST",
      "statement": "本配置/来源/模板能力参与智能体任务时，服务操作或发布成功仅是执行/资源状态，不直接认定用户业务目标完成；运行结果固定所用来源、规则/模板或审核版本，后续纠正只使依赖结果待复核，历史留存且继续原目标链。若发生人工交接，须有真实受理记录。",
      "sourceAnchors": [
        "docs/02-待确认事项清单.md#23",
        "docs/01-总体需求与架构方案.md#5"
      ],
      "acceptanceScenarioIds": [
        "ENF-08-SEM-AC-001"
      ]
    }
  ],
  "inputs": [
