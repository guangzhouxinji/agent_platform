  "inputs": [
    {
      "name": "caseReference",
      "required": true,
      "rules": [
        "中心案件稳定编号和固定快照版本"
      ]
    },
    {
      "name": "evidenceVersions",
      "required": true,
      "rules": [
        "有权读取的具体证据版本集合"
      ]
    },
    {
      "name": "ruleVersion",
      "required": true,
      "rules": [
        "已发布且适用的固定证据链规则版本"
      ]
    },
    {
      "name": "idempotencyKey",
      "required": true,
      "rules": [
        "绑定主体、操作和完整输入"
      ]
    },
    {
      "name": "humanRevision",
      "required": "修订或审核时",
      "rules": [
        "预期结果版本、前后关系、理由和可信身份"
      ]
    }
  ],
  "outputs": [
    {
      "name": "chainTask",
      "fields": [
        "taskId",
        "status",
        "requestId",
        "inputVersion",
        "ruleVersion",
        "attempts",
        "unprocessedItems"
      ]
    },
    {
      "name": "factEvidenceRelation",
      "fields": [
        "factId",
        "factStatus",
        "evidenceId",
        "evidenceVersion",
        "relationType",
        "reason",
        "sourceAnchor"
      ]
    },
    {
      "name": "timelineItem",
      "fields": [
        "timeKind",
        "rawTime",
        "normalizedTime",
        "sourceAnchor",
        "unknownReason"
      ]
    },
    {
      "name": "chainResult",
      "fields": [
        "chainId",
        "version",
        "gaps",
        "conflicts",
        "completenessStatus",
        "reviewStatus",
        "needsReview"
      ]
    }
  ],
  "permissions": [
    {
      "action": "submit_chain_task",
      "enforcement": "校验机构、案件、全部证据和规则版本权限"
    },
    {
      "action": "read_chain_or_source",
      "enforcement": "每次读取重新检查案件、证据及原件权限"
    },
    {
      "action": "revise_relations",
      "enforcement": "授权业务人员和预期版本校验"
    },
    {
      "action": "confirm_or_return",
      "enforcement": "中心授权审核角色，模型和 Agent 不得执行"
    }
  ],
  "states": [
    {
      "name": "queued",
      "kind": "task",
      "allowedNext": [
        "running",
        "failed",
        "cancelled"
      ]
    },
    {
      "name": "running",
      "kind": "task",
      "allowedNext": [
        "succeeded",
        "partial_failed",
        "failed",
        "cancelled"
      ]
    },
    {
      "name": "succeeded",
      "kind": "task",
      "allowedNext": []
    },
    {
      "name": "partial_failed",
      "kind": "task",
      "allowedNext": [],
      "invariant": "列出未处理材料或步骤"
    },
    {
      "name": "failed",
      "kind": "task",
      "allowedNext": []
    },
    {
      "name": "cancelled",
      "kind": "task",
      "allowedNext": []
    },
    {
      "name": "待审核",
      "kind": "review",
      "allowedNext": [
        "已确认",
        "退回"
      ]
    },
    {
      "name": "退回",
      "kind": "review",
      "allowedNext": [
        "待审核"
      ],
      "invariant": "重新提交产生新版本"
    },
    {
      "name": "已确认",
      "kind": "review",
      "allowedNext": [],
      "invariant": "重跑不得覆盖"
    }
  ],
  "sourceAndVersionRules": [
    "任务固定案件快照、证据版本集合、规则、模型和解析版本。",
    "每个事实关系和时间节点引用具体证据版本与稳定位置。",
    "支持、反对、冲突、缺口和未处理材料分别记录，不能互相覆盖。",
    "人工修订形成可追溯新版本，保留机器原始输出。",
    "证据排除、撤回或规则变化使历史结果标记需复核，不重写历史。",
    "模拟、转写及真实来源证据分别标记并隔离。"
  ],
  "errorsAndExceptions": [
    {
      "case": "case_or_evidence_unauthorized",
      "result": "拒绝任务或读取且不泄露材料"
    },
    {
      "case": "source_missing_or_unavailable",
      "result": "记录缺口或失败，不表示无证据"
    },
    {
      "case": "unsupported_media",
      "result": "列入未处理材料并保留文件引用"
    },
    {
      "case": "rule_not_applicable",
      "result": "明确返回不适用，不执行猜测整理"
    },
    {
      "case": "partial_chain",
      "result": "返回有依据部分、缺口、冲突和未处理项"
    },
    {
      "case": "version_or_state_conflict",
      "result": "拒绝覆盖并返回当前版本或状态"
    }
  ],
