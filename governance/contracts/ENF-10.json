  "clauses": [
    {
      "id": "ENF-10-MUST-001",
      "type": "MUST",
      "statement": "按中心确认的疑似行为类型配置分析标准、权利基础、行为事实、逐项证据需求、排除抗辩、适用地区职权和程序。",
      "sourceAnchors": [
        "1. 功能概述与交付范围",
