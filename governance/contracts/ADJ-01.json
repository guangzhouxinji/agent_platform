  "clauses": [
    {
      "id": "ADJ-01-MUST-001",
      "type": "MUST",
      "statement": "复用统一法规服务接入、导入和维护知识产权法律、行政法规、部门规章、司法解释等，并提供版本查询、修订历史、效力状态、条款定位和引用基础。",
      "sourceAnchors": [
        "1. 功能概述与已有需求关系",
        "既有/1. 功能概述"
      ],
      "acceptanceScenarioIds": [
        "ADJ-01-AC-001",
        "ADJ-01-AC-009"
      ]
    },
    {
      "id": "ADJ-01-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "不得为裁决助手重复建设另一套法规源库，也不得取消既有批量导入、人工新增编辑、修订弹窗和历史原文能力。",
      "sourceAnchors": [
        "1. 功能概述与已有需求关系",
        "总览/3. 与已有法规需求的衔接"
      ],
      "acceptanceScenarioIds": [
        "ADJ-01-AC-009"
      ]
    },
    {
      "id": "ADJ-01-MUST-002",
      "type": "MUST",
      "statement": "中心 API 原始法规数据只读；人工维护写入本地校核版本，保存来源、修改理由和差异。",
      "sourceAnchors": [
        "1. 功能概述与已有需求关系",
        "总览/3. 与已有法规需求的衔接"
      ],
      "acceptanceScenarioIds": [
        "ADJ-01-AC-004"
      ]
    },
    {
      "id": "ADJ-01-MUST_NOT-002",
      "type": "MUST_NOT",
      "statement": "本地人工新增、编辑、导入更新或模型处理不得回写、覆盖或伪装成中心原始记录。",
      "sourceAnchors": [
        "1. 功能概述与已有需求关系",
        "总览/3. 与已有法规需求的衔接"
      ],
      "acceptanceScenarioIds": [
        "ADJ-01-AC-004"
      ]
    },
    {
      "id": "ADJ-01-MUST-003",
      "type": "MUST",
      "statement": "法规编号稳定唯一且名称不得作为唯一关联键；跨系统使用稳定记录 ID、源系统 ID 和具体版本。",
      "sourceAnchors": [
        "2. 字段与数据规则",
        "总览/5.1 身份和来源",
        "既有/3.1 法规信息字段"
      ],
      "acceptanceScenarioIds": [
        "ADJ-01-AC-001"
      ]
    },
    {
      "id": "ADJ-01-MUST-004",
      "type": "MUST",
      "statement": "法规记录正式名称、发布部门、发布时间、实施时间、类别、可多选业务领域、适用地域、全文、源 ID、版本 ID、获取时间、创建更新人员和时间。",
      "sourceAnchors": [
        "2. 字段与数据规则",
        "既有/3.1 法规信息字段"
      ],
      "acceptanceScenarioIds": [
        "ADJ-01-AC-001"
