{
  "name": "agent-platform-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:consultation": "tsc -b && vite build --config vite.consultation.config.ts",
    "build:adjudication": "tsc -p tsconfig.app.json && vite build --config vite.adjudication.config.ts",
    "build:enforcement": "tsc -p tsconfig.app.json && vite build --config vite.enforcement.config.ts"
  },
  "dependencies": {
    "@ant-design/pro-components": "3.1.14-7",
    "@tanstack/react-query": "5.103.1",
    "antd": "6.6.4",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
