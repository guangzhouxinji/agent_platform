  "clauses": [
    {
      "id": "ENF-11-MUST-001",
      "type": "MUST",
      "statement": "综合固定版本的线索解析、证据、证据链和已发布分析规则形成逐要件辅助分析报告，供执法人员复核。",
      "sourceAnchors": [
        "1. 功能概述与交付范围",
        "2. 数据来源与依赖"
      ],
      "acceptanceScenarioIds": [
        "ENF-11-AC-001",
        "ENF-11-AC-007"
      ]
    },
    {
      "id": "ENF-11-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "辅助报告不得自动立案、正式认定侵权、决定适用程序、确认处罚或执行任何处罚。",
      "sourceAnchors": [
        "1. 功能概述与交付范围",
        "4. 功能与处理规则",
        "总览/5. 审核与版本通用要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-11-AC-007",
        "ENF-11-AC-008"
      ]
    },
    {
      "id": "ENF-11-MUST-003",
      "type": "MUST",
      "statement": "分析前校验案件、线索、证据、证据链、规则和权利信息的稳定编号、关联、固定版本与当前权限。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-11-AC-001",
        "ENF-11-AC-009"
      ]
    },
    {
      "id": "ENF-11-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "来源、输入事实、证据、权利状态、规则或缺失信息不得由模型生成或替换。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "总览/4. 信息字段说明"
      ],
      "acceptanceScenarioIds": [
        "ENF-11-AC-004",
        "ENF-11-AC-009"
      ]
    },
    {
      "id": "ENF-11-MUST-005",
      "type": "MUST",
      "statement": "先按固定规则检查适用范围，再对每个要件分别记录事实、证据、法律或规则依据、支持或排除关系、缺口和不确定性。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-11-AC-002",
        "ENF-11-AC-003"
      ]
    },
    {
      "id": "ENF-11-MUST-006",
      "type": "MUST",
      "statement": "报告明确区分已确认事实、当事人陈述和模型推断，每项模型推断必须给出具体证据与不确定性。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-11-AC-002"
      ]
    },
    {
      "id": "ENF-11-MUST_NOT-004",
      "type": "MUST_NOT",
      "statement": "当事人陈述或模型推断不得被提升为已确认事实，也不得省略反对、冲突或排除依据。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "总览/5. 审核与版本通用要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-11-AC-002"
      ]
    },
    {
      "id": "ENF-11-MUST-007",
      "type": "MUST",
      "statement": "辅助结论限定为支持疑似成立、存在排除依据或材料不足无法判断，并逐要件解释形成原因。",
      "sourceAnchors": [
        "3. 信息字段",
        "5. 服务接口需求"
      ],
      "acceptanceScenarioIds": [
        "ENF-11-AC-003",
        "ENF-11-AC-004"
      ]
    },
    {
      "id": "ENF-11-MUST-008",
      "type": "MUST",
      "statement": "侵权严重程度只有在中心确认的适用规则存在且所需数据充分时才输出，否则返回无法评估及缺口。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-11-AC-004"
      ]
    },
    {
      "id": "ENF-11-MUST_NOT-005",
      "type": "MUST_NOT",
      "statement": "输入不足时不得补造行为、金额、权利有效性、严重程度、适用程序或其他事实。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-11-AC-004"
      ]
    },
    {
      "id": "ENF-11-MUST-009",
      "type": "MUST",
      "statement": "权利状态记录来源、版本、状态时间和查询时间，并按行为发生时点检查历史适用性。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-11-AC-005"
      ]
    },
    {
      "id": "ENF-11-MUST_NOT-006",
      "type": "MUST_NOT",
      "statement": "当前权利状态不得直接替代行为发生时的历史状态；历史状态缺失时不得宣称当时权利有效或无效。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-11-AC-005"
      ]
    },
    {
      "id": "ENF-11-MUST-010",
      "type": "MUST",
      "statement": "材料不足时仍返回有依据的部分分析、具体补证事项和未处理项，不能将源失败、规则不适用和资料不足混同。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "5. 服务接口需求",
        "总览/5. 审核与版本通用要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-11-AC-004",
        "ENF-11-AC-009"
      ]
    },
    {
      "id": "ENF-11-MUST_NOT-007",
      "type": "MUST_NOT",
      "statement": "部分结果、资料不足或接口失败不得伪装为完整分析、侵权不成立或成功无缺口。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "5. 服务接口需求"
      ],
      "acceptanceScenarioIds": [
        "ENF-11-AC-004",
        "ENF-11-AC-009"
      ]
    },
    {
      "id": "ENF-11-MUST-011",
      "type": "MUST",
      "statement": "审核状态为待审核、已确认和退回；授权人员可修订、提交、确认或退回，保留前后值、理由、人员、时间及机器原始结果。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则",
        "总览/5. 审核与版本通用要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-11-AC-007"
      ]
    },
    {
      "id": "ENF-11-MUST-012",
      "type": "MUST",
      "statement": "新增材料、规则或权利状态后重跑生成新报告版本，旧报告、人工修订和审核记录保持不变并按影响标记需复核。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求",
        "总览/3. 通用接口约定"
      ],
      "acceptanceScenarioIds": [
        "ENF-11-AC-006"
      ]
    },
    {
      "id": "ENF-11-MUST_NOT-008",
      "type": "MUST_NOT",
      "statement": "重跑或模型更新不得覆盖已人工确认报告、修改历史引用或改变正式案件状态。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "总览/5. 审核与版本通用要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-11-AC-006",
        "ENF-11-AC-007"
      ]
    },
    {
      "id": "ENF-11-MUST-017",
      "type": "MUST",
      "statement": "模型质量使用中心标注案件独立评估，记录逐要件、来源正确性、缺失处理、辅助结论、分母、模型/规则版本和专家复核。",
      "sourceAnchors": [
        "7. 验收要求",
        "8. 联调前需确认的条件",
        "总览/9. 验收组织"
      ],
      "acceptanceScenarioIds": [
        "ENF-11-AC-011"
      ]
    },
    {
      "id": "ENF-11-MUST_NOT-009",
      "type": "MUST_NOT",
      "statement": "模型置信度、自评分、模拟案件或静态页面不得替代业务准确率、真实联调或专家验收。",
      "sourceAnchors": [
        "7. 验收要求",
        "8. 联调前需确认的条件",
        "总览/6. 内部前端通用要求",
        "总览/9. 验收组织"
      ],
      "acceptanceScenarioIds": [
        "ENF-11-AC-011"
      ]
    },
    {
      "id": "ENF-11-SEM-MUST-001",
      "type": "MUST",
      "statement": "本能力参与智能体任务时，一次工具执行成功、局部输出、通知或审核动作不直接认定整个用户业务目标完成；跨轮对象绑定稳定版本，纠正保留原目标与历史并重核依赖结果；人工接收须有实际记录，业务、任务、审核、正式状态分别表达。",
      "sourceAnchors": [
        "docs/02-待确认事项清单.md#23",
        "docs/01-总体需求与架构方案.md#5"
      ],
      "acceptanceScenarioIds": [
        "ENF-11-SEM-AC-001"
      ]
    }
  ],
  "inputs": [
    {
      "name": "caseReference",
      "required": true,
      "rules": [
        "中心案件稳定编号和固定快照"
      ]
    },
    {
      "name": "behaviorAndClueVersion",
      "required": true,
      "rules": [
        "事实描述或已确认线索版本"
      ]
    },
    {
      "name": "evidenceAndChainVersions",
      "required": true,
      "rules": [
        "允许为空但必须产生材料不足状态"
      ]
    },
    {
      "name": "analysisRuleVersion",
      "required": true,
      "rules": [
        "已发布、适用且中心确认"
      ]
    },
    {
      "name": "historicalRightsContext",
      "required": false,
      "rules": [
        "来源、版本、行为时点状态；缺失必须披露"
      ]
    },
    {
      "name": "idempotencyKey",
      "required": true,
      "rules": [
        "绑定主体、操作和完整输入"
      ]
    }
  ],
  "outputs": [
    {
      "name": "analysisTask",
      "fields": [
        "taskId",
        "status",
        "requestId",
        "inputManifest",
        "attempts",
        "unprocessedItems"
      ]
    },
    {
      "name": "elementAnalysis",
      "fields": [
        "elementId",
        "applicability",
        "confirmedFacts",
        "statements",
        "inferences",
        "evidenceRefs",
        "authorityRefs",
        "gaps",
        "uncertainty"
      ]
    },
    {
      "name": "auxiliaryConclusion",
      "fields": [
        "status",
        "reason",
        "severityOrUnavailable",
        "candidateProcedure",
        "itemsToConfirm",
        "notOfficialDecision"
      ]
    },
    {
      "name": "report",
      "fields": [
        "reportId",
        "version",
        "reviewStatus",
        "ruleVersion",
        "modelVersion",
        "rightsVersions",
        "needsReview",
        "audit"
      ]
    }
  ],
  "permissions": [
    {
      "action": "submit_analysis",
      "enforcement": "校验案件、事实、全部证据链、规则和权利信息权限"
    },
    {
      "action": "read_report_or_source",
      "enforcement": "每次读取重新校验案件、证据、法条和报告权限"
    },
    {
      "action": "revise",
      "enforcement": "授权执法人员和预期报告版本校验"
    },
    {
      "action": "confirm_or_return",
      "enforcement": "中心授权审核角色；AI、Agent 和模型不得执行"
    },
    {
      "action": "official_case_or_penalty_state",
      "enforcement": "仅权威案件系统或真实授权人员可改变，本服务禁止写入"
    }
  ],
  "states": [
    {
      "name": "queued",
      "kind": "task",
      "allowedNext": [
        "running",
        "failed",
        "cancelled"
      ]
    },
    {
      "name": "running",
      "kind": "task",
      "allowedNext": [
        "succeeded",
        "partial_failed",
        "failed",
        "cancelled"
      ]
    },
    {
      "name": "succeeded",
      "kind": "task",
      "allowedNext": []
    },
    {
      "name": "partial_failed",
      "kind": "task",
      "allowedNext": [],
      "invariant": "列出未处理要件或来源"
    },
    {
      "name": "failed",
      "kind": "task",
      "allowedNext": []
    },
    {
      "name": "cancelled",
      "kind": "task",
      "allowedNext": []
    },
    {
      "name": "待审核",
      "kind": "review",
      "allowedNext": [
        "已确认",
        "退回"
      ]
    },
    {
      "name": "退回",
      "kind": "review",
      "allowedNext": [
        "待审核"
      ],
      "invariant": "重新提交形成新报告版本"
    },
    {
      "name": "已确认",
      "kind": "review",
      "allowedNext": [],
      "invariant": "不等于正式执法决定，重跑不得覆盖"
    }
  ],
  "sourceAndVersionRules": [
    "任务固定案件、事实、线索、证据、证据链、规则、权利、法条和模型版本。",
    "每个要件的事实、陈述、推断、证据、依据和缺口分别记录并定位来源。",
    "权利状态保存行为时点、状态时点、查询时间、来源和版本。",
    "机器结果、人工修订和审核记录独立版本化，重跑不覆盖。",
    "输入或依据变化使旧结果标记需复核，不重写历史报告。",
    "模拟、真实和部分失败证据分别标记并隔离。"
  ],
  "errorsAndExceptions": [
    {
      "case": "input_resource_unauthorized",
      "result": "拒绝分析且不泄露材料"
    },
    {
      "case": "rule_not_applicable",
      "result": "返回不适用及依据，不继续生成侵权结论"
    },
    {
      "case": "materials_insufficient",
      "result": "返回无法判断、部分分析及具体补证事项"
    },
    {
      "case": "historical_right_status_missing",
      "result": "标记待核实，不使用当前状态替代"
    },
    {
      "case": "source_or_model_failure",
      "result": "返回失败或部分失败和未处理项"
    },
    {
      "case": "version_or_review_state_conflict",
      "result": "拒绝覆盖并返回当前状态与版本"
    }
  ],
  "decisionPoints": [
    {
      "id": "ENF-11-DEC-001",
      "owner": "AI",
      "description": "生成逐要件推断、候选辅助结论、缺口和程序候选；必须引用证据并披露不确定性，不得作正式认定。",
      "sourceAnchors": [
        "1. 功能概述与交付范围",
        "4. 功能与处理规则"
      ]
    },
    {
      "id": "ENF-11-DEC-002",
      "owner": "RULE",
      "description": "执行适用范围、要件结构、数据充分性、严重程度前提、状态、权限、版本和需复核传播。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则",
        "5. 服务接口需求"
      ]
    },
    {
      "id": "ENF-11-DEC-003",
      "owner": "HUMAN",
      "description": "执法人员区分和确认事实、修订报告、选择程序、确认或退回；中心专家确认规则和评测预期。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求",
        "8. 联调前需确认的条件"
      ]
    },
    {
      "id": "ENF-11-DEC-004",
      "owner": "AUTHORITY_SYSTEM",
      "description": "中心案件、证据、权利和法规系统提供真实版本、历史状态、权限及正式业务状态。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "4. 功能与处理规则"
      ]
    }
  ],
