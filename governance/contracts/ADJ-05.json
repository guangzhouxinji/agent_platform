  "clauses": [
    {
      "id": "ADJ-05-MUST-001",
      "type": "MUST",
      "statement": "根据固定案件核心事实、争议焦点、程序、地域和相关时间召回并解释可能适用的法律条文，供裁决人员调整确认。",
