  "clauses": [
    {
      "id": "ADJ-03-MUST-001",
      "type": "MUST",
      "statement": "统一承接既有外部一次性要点生成导入、关联校验、维护和完整列表；要点关联法规、条文及 ADJ-02 来源解析的具体版本。",
      "sourceAnchors": [
        "1. 功能概述",
        "2. 字段与内容约束",
        "既有/1. 功能概述",
        "既有/2. 数据来源与导入"
      ],
      "acceptanceScenarioIds": [
        "ADJ-03-AC-001"
      ]
    },
    {
      "id": "ADJ-03-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "要点不是法规原文或正式法律引用，不得仅凭要点内容生成正式依据；正式引用必须回到具体条文版本。",
      "sourceAnchors": [
        "1. 功能概述"
      ],
      "acceptanceScenarioIds": [
        "ADJ-03-AC-001"
      ]
    },
    {
      "id": "ADJ-03-MUST-002",
      "type": "MUST",
      "statement": "要点唯一编号编辑不变，版本保存来源解析、法规条文、内容类别、程序场景、案例版本、提取与导入主体时间及变更原因。",
      "sourceAnchors": [
        "2. 字段与内容约束",
        "既有/3. 条文要点信息管理"
      ],
      "acceptanceScenarioIds": [
        "ADJ-03-AC-002"
      ]
    },
    {
      "id": "ADJ-03-MUST-003",
      "type": "MUST",
      "statement": "导入逐项校验必填、编号重复、来源解析、法规条文关系、类别字典、场景、案例和日期并返回成功失败及原因。",
      "sourceAnchors": [
        "3. 导入与维护规则",
        "既有/2.2 导入校验"
      ],
      "acceptanceScenarioIds": [
        "ADJ-03-AC-002"
      ]
    },
    {
      "id": "ADJ-03-MUST-004",
      "type": "MUST",
      "statement": "仅来源为已审核且一致的解析、原文支持充分并经校核的要点可标可用；否则待核实。",
      "sourceAnchors": [
        "2. 字段与内容约束",
        "3. 导入与维护规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-03-AC-003"
      ]
    },
    {
      "id": "ADJ-03-MUST_NOT-002",
      "type": "MUST_NOT",
      "statement": "未审核、来源已变更、缺原文支持、停用或越权要点不得作为当前已校核知识进入检索、匹配或报告。",
      "sourceAnchors": [
        "2. 字段与内容约束",
        "3. 导入与维护规则",
        "5. 服务契约"
      ],
      "acceptanceScenarioIds": [
        "ADJ-03-AC-003"
      ]
    },
    {
      "id": "ADJ-03-MUST-005",
      "type": "MUST",
      "statement": "处罚标准要点仅在来源存在且程序匹配时展示，不得因含处罚内容自动用于行政裁决报告。",
      "sourceAnchors": [
        "2. 字段与内容约束"
      ],
      "acceptanceScenarioIds": [
        "ADJ-03-AC-004"
      ]
    },
    {
      "id": "ADJ-03-MUST-006",
      "type": "MUST",
      "statement": "重复导入可跳过、更新草稿或创建新版本；已引用版本不得覆盖，改变来源条文须新版本重新校验。",
      "sourceAnchors": [
        "3. 导入与维护规则",
        "既有/2.2 导入校验",
        "既有/3.2 信息维护"
      ],
      "acceptanceScenarioIds": [
        "ADJ-03-DEV-AC-001"
      ]
    },
    {
      "id": "ADJ-03-DECISION-MUST-001",
      "type": "MUST",
      "statement": "开发期在固定解析版本、稳定要点ID和生成配置后比较要点业务载荷摘要；解析原文相同但要点变化时新增待审核修订，同派生载荷跳过。旧版、人工编辑及停用记录保留，已提交审核/已审核/被引用版不得覆写或由外部导入自动启用。",
      "sourceAnchors": [
        "docs/02-待确认事项清单.md 第31节（2026-09-24 已确认开发期决定，不是原需求原文）"
      ],
      "sourceKind": "confirmed_product_decision",
      "decisionRef": "docs/02-待确认事项清单.md#31-2026-09-24-未审核草稿重复导入的开发期策略",
      "acceptanceScenarioIds": [
        "ADJ-03-AC-005"
      ]
    },
    {
      "id": "ADJ-03-MUST-007",
      "type": "MUST",
      "statement": "来源解析或法规变化标记待核实并保留历史引用；人工停用保留历史，外部更新不得无确认自动启用。",
      "sourceAnchors": [
        "3. 导入与维护规则"
      ],
      "acceptanceScenarioIds": [
        "ADJ-03-AC-005"
      ]
    },
    {
      "id": "ADJ-03-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "事实或关联缺失不得由模型推测补齐，外部故障不得写成空结果或成功。",
      "sourceAnchors": [
        "前言",
        "5. 服务契约"
      ],
      "acceptanceScenarioIds": [
        "ADJ-03-AC-006"
      ]
    },
    {
      "id": "ADJ-03-MUST-011",
      "type": "MUST",
      "statement": "中心确认类别场景程序字典、校核人员、外部生成通道、规模和专业样例，未确认不升级验收。",
      "sourceAnchors": [
        "7. 验收要求",
        "8. 依赖与交付"
      ],
      "acceptanceScenarioIds": [
        "ADJ-03-AC-008"
      ]
    },
    {
      "id": "ADJ-03-SEM-MUST-001",
      "type": "MUST",
      "statement": "本配置/来源/模板能力参与智能体任务时，服务操作或发布成功仅是执行/资源状态，不直接认定用户业务目标完成；运行结果固定所用来源、规则/模板或审核版本，后续纠正只使依赖结果待复核，历史留存且继续原目标链。若发生人工交接，须有真实受理记录。",
      "sourceAnchors": [
        "docs/02-待确认事项清单.md#23",
        "docs/01-总体需求与架构方案.md#5"
      ],
      "acceptanceScenarioIds": [
        "ADJ-03-SEM-AC-001"
      ]
    }
  ],
  "inputs": [
    {
      "name": "keyPointBatch",
      "required": true,
      "rules": [
        "要点、法规条文版本、来源解析版本、类别场景案例及幂等键"
      ]
    },
    {
      "name": "maintenanceAction",
      "required": "编辑校核停用时",
      "rules": [
        "当前版本、动作、变更原因和可信身份"
      ]
    },
    {
      "name": "sourceChange",
      "required": "来源变化时",
      "rules": [
