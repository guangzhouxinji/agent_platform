  "clauses": [
    {
      "id": "ENF-06-MUST-001",
      "type": "MUST",
      "statement": "维护中心确认案件类型对应的待证明事项、必要性、预期证据、可替代材料、关系和缺项判据。",
      "sourceAnchors": [
        "1. 功能概述与交付范围",
        "2. 数据来源与依赖",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-06-AC-001"
      ]
    },
    {
      "id": "ENF-06-MUST_NOT-001",
      "type": "MUST_NOT",
      "statement": "系统或模型不得自行发明通用证据模板、法律要件、必要性或把未经中心确认规则用于所有案件。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "4. 功能与处理规则",
        "8. 联调前需确认的条件"
      ],
      "acceptanceScenarioIds": [
        "ENF-06-AC-001"
      ]
    },
    {
      "id": "ENF-06-MUST-002",
      "type": "MUST",
      "statement": "规则保存唯一编号、名称、受控案件类型、构成要素、整理逻辑、不可变发布版本、依据来源版本、机构和审计。",
      "sourceAnchors": [
        "3. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "ENF-06-AC-002"
      ]
    },
    {
      "id": "ENF-06-MUST-003",
      "type": "MUST",
      "statement": "依据及案件类型字典必须来自授权资源，接入校验稳定 ID、关联、版本和权限，缺失与调用失败分开。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "3. 信息字段"
      ],
      "acceptanceScenarioIds": [
        "ENF-06-AC-002"
      ]
    },
    {
      "id": "ENF-06-MUST_NOT-002",
      "type": "MUST_NOT",
      "statement": "来源、依据、业务编号和案件类型不得由模型生成替换，失效依据不得用于发布。",
      "sourceAnchors": [
        "2. 数据来源与依赖",
        "3. 信息字段",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-06-AC-002",
        "ENF-06-AC-005"
      ]
    },
    {
      "id": "ENF-06-MUST-004",
      "type": "MUST",
      "statement": "按待证明事项配置预期证据、可替代材料和必需性，同一证据可关联多个事项且分别说明作用。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-06-AC-003"
      ]
    },
    {
      "id": "ENF-06-MUST_NOT-003",
      "type": "MUST_NOT",
      "statement": "证据链完整性不得仅按附件数量、文件存在或模型摘要判定。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "总览/5. AI、规则与人工边界"
      ],
      "acceptanceScenarioIds": [
        "ENF-06-AC-003"
      ]
    },
    {
      "id": "ENF-06-MUST-005",
      "type": "MUST",
      "statement": "关系类型至少区分证明、补强、矛盾和无关，并精确关联证据支持或冲突的事实项。",
      "sourceAnchors": [
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-06-AC-003"
      ]
    },
    {
      "id": "ENF-06-MUST-006",
      "type": "MUST",
      "statement": "样例试运行固定规则与证据版本，输出逐要素覆盖、缺失、冲突、无关及未处理项，不产生业务处置。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "5. 服务接口需求"
      ],
      "acceptanceScenarioIds": [
        "ENF-06-AC-004"
      ]
    },
    {
      "id": "ENF-06-MUST-007",
      "type": "MUST",
      "statement": "发布前校验必需事项、重复要素、空映射、关系、依据有效性和适用类型；缺少必需事项阻止发布。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "7. 验收要求"
      ],
      "acceptanceScenarioIds": [
        "ENF-06-AC-005"
      ]
    },
    {
      "id": "ENF-06-MUST-008",
      "type": "MUST",
      "statement": "发布规则不可原地修改，编辑创建新草稿，停用限制新整理，历史整理持续引用旧版本。",
      "sourceAnchors": [
        "3. 信息字段",
        "4. 功能与处理规则"
      ],
      "acceptanceScenarioIds": [
        "ENF-06-AC-006"
      ]
    },
    {
      "id": "ENF-06-MUST-009",
      "type": "MUST",
      "statement": "规则说明和法律依据由授权业务人员确认，发布停用和修订保留操作人、意见、前后状态和版本。",
      "sourceAnchors": [
        "4. 功能与处理规则",
        "5. 服务接口需求"
      ],
      "acceptanceScenarioIds": [
        "ENF-06-AC-006"
      ]
    },
    {
      "id": "ENF-06-MUST-013",
      "type": "MUST",
      "statement": "仅确认案件类型可进入首版真实使用；固定样例记录规则证据、预期实际、版本和问题，专业预期由中心确认。",
      "sourceAnchors": [
        "7. 验收要求",
        "8. 联调前需确认的条件"
      ],
      "acceptanceScenarioIds": [
        "ENF-06-AC-010"
      ]
    },
    {
      "id": "ENF-06-SEM-MUST-001",
      "type": "MUST",
      "statement": "本配置/来源/模板能力参与智能体任务时，服务操作或发布成功仅是执行/资源状态，不直接认定用户业务目标完成；运行结果固定所用来源、规则/模板或审核版本，后续纠正只使依赖结果待复核，历史留存且继续原目标链。若发生人工交接，须有真实受理记录。",
      "sourceAnchors": [
        "docs/02-待确认事项清单.md#23",
        "docs/01-总体需求与架构方案.md#5"
      ],
      "acceptanceScenarioIds": [
        "ENF-06-SEM-AC-001"
      ]
    }
